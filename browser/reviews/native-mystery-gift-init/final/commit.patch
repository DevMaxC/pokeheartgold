+const data=await loadData(),c=data.constants,common=await sourceJSON<SourceMap>('scripts/0144.json');
+const maps=await Promise.all(Object.keys(data.index.maps).map(id=>sourceJSON<SourceMap>(`maps/${id}.json`)));
