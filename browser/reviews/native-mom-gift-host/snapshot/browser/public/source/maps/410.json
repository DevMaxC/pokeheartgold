d",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_MARSH","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0182"]],["NPCMsg",["msg_0531_T11GYM0101_00006"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0531_T11GYM0101_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_MARSH","VAR_SPECIAL_RESULT"]],["BufferPlayersName",["0"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_01B4"]],["NPCMsg",["msg_0531_T11GYM0101_00008"]],["GoTo",["_01B7"]],["NPCMsg",["msg_0531_T11GYM0101_00009"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["FollowMonResetMovement",[]],["LockAll",[]],["FollowMonRecall",[]],["PlaySE",["SEQ_SE_PL_BOWABOWA"]],["ApplyMovement",["obj_player","_01FC"]],["WaitMovement",[]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["Warp",["MAP_SAFFRON_GYM","0","15","23","DIR_SOUTH"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",["2"]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",["2"]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",["2"]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",[]],["SetInvisible",["0"]],["EndMovement",[]]]},"messages":{"msg_0531_T11GYM0101_00000":"Sabrina: I knew you were coming...\\rThree years ago I had a vision of\\nyour arrival. You’re after my Badge.\\rI don’t enjoy battling, but it’s my\\nduty as a Gym Leader to confer\\fBadges on anyone who has proven\\fhim- or herself worthy.\\rSince you wish it, I will show you my\\npsychic powers!\\r","msg_0531_T11GYM0101_00001":"Sabrina: Your power...\\nIt far exceeds what I foresaw...\\rMaybe it isn’t possible to fully\\npredict what the future holds...\\rOK, you win. You earned yourself\\nthe Marsh Badge.\\r","msg_0531_T11GYM0101_00002":"{STRVAR_1 3, 0, 0} received\\nthe Marsh Badge!","msg_0531_T11GYM0101_00003":"Sabrina: I failed to accurately predict\\nyour power. That means that your\\fpower is beyond my psychic ability.\\rYou deserve this.\\nPlease take this TM, too!\\r","msg_0531_T11GYM0101_00004":"Sabrina: It contains Skill Swap!\\nIt swaps Abilities between the user\\fand the target.\\rYou will become a celebrated and\\nbeloved Champion!","msg_0531_T11GYM0101_00005":"Sabrina: Your love for your Pokémon\\nsmashed my psychic abilities...\\rThe ability to love, I think, is some\\nkind of psychic ability...","msg_0531_T11GYM0101_00006":"Yo, legend in the making!\\rA Trainer as skilled as you doesn’t\\nneed to be told how to deal\\fwith Psychic-type Pokémon, right?\\rI expect great things from you!\\rGood luck!","msg_0531_T11GYM0101_00007":"That was another fantastic battle!","msg_0531_T11GYM0101_00008":"Saffron City Pokémon Gym","msg_0531_T11GYM0101_00009":"Saffron City Pokémon Gym\\rLeader: Sabrina\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T11GYM0101_004 + 1"},"constants":{"_EV_scr_seq_T11GYM0101_000":0,"_EV_scr_seq_T11GYM0101_001":1,"_EV_scr_seq_T11GYM0101_002":2,"_EV_scr_seq_T11GYM0101_003":3,"_EV_scr_seq_T11GYM0101_004":4,"obj_T11GYM0101_itako":0,"obj_T11GYM0101_mystery_2":1,"obj_T11GYM0101_itako_2":2,"obj_T11GYM0101_mystery_2_2":3,"obj_T11GYM0101_sunglasses":4,"obj_T11GYM0101_gsleader10":5}}
