reOverworld",[]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0143_D49R0107_00008"]],["End",[]],["SimpleNPCMsg",["msg_0143_D49R0107_00008"]],["End",[]],["SimpleNPCMsg",["msg_0143_D49R0107_00008"]],["End",[]]]},"messages":{"msg_0143_D49R0107_00000":"Magnus: Oh, gosh!\\r","msg_0143_D49R0107_00001":"You are...!\\nIt is indeed you, {STRVAR_1 3, 0, 0}!\\rOutstanding!\\nQuite an achievement for you\\fto come up here, bud!\\r","msg_0143_D49R0107_00002":"This is the “Friendship” room.\\rIt was built to commemorate the\\nsolidarity, trust, and potential\\fof Pokémon and people and\\fto hope for the eternal friendship\\fbetween Pokémon and people.\\r","msg_0143_D49R0107_00003":"Congratulations!\\rThis room is only for those true\\nPokéathletes who have earned\\freal friendships with Pokémon!\\r{STRVAR_1 3, 0, 0}!\\nYou are a true Pokéathlete, bud!\\r","msg_0143_D49R0107_00004":"Having said that...\\nthis is also the moment\\fof a new beginning...\\r","msg_0143_D49R0107_00005":"That’s right, bud!\\nYou have just heard a new starting\\fsignal. Your challenge continues\\ffor a whole new height and to become\\fthe legendary Pokéathlete!\\rTake a look at this statue.\\nYou may be looking at your goal...\\r","msg_0143_D49R0107_00006":"Magnus: This is the “Friendship” room.\\nIt is the last of all. It’s the room\\fwhere eternal friendship between\\fpeople and Pokémon is pledged.\\r...But this is not your goal, bud.\\rEach room has Trophies to earn,\\nbut you can aim for any new height.\\rIt is entirely up to you whether\\nyou get there or not...\\rThat’s right!\\rYour true goal is not something\\nanyone else can decide for you, bud.\\r{STRVAR_1 3, 0, 0}!\\nYou can overcome any difficulties\\fwith your friendship with your Pokémon.","msg_0143_D49R0107_00007":"It’s your statue!\\r","msg_0143_D49R0107_00008":"The statue of the Pokémon\\nyou’ve shared your journey\\fwith, helping each other and\\fcultivating your friendship!","msg_0143_D49R0107_00009":"It is the statue of a Medalist Pokémon.\\rDo you want to replace it with another?","msg_0143_D49R0107_00010":"You can place a statue of a\\nMedalist Pokémon that has\\fearned five medals.\\rDo you want to place a statue?","msg_0143_D49R0107_00011":"It is the statue of a Medalist Pokémon.\\rDo you want to replace it with another?","msg_0143_D49R0107_00012":"You can place a statue of a\\nMedalist Pokémon that has\\fearned five medals.\\rDo you want to place a statue?","msg_0143_D49R0107_00013":"It is the statue of a Medalist Pokémon.\\rDo you want to replace it with another?"},"initTriggers":[{"var":"VAR_UNK_40D3","value":0,"script":"_EV_scr_seq_D49R0107_005 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_D49R0107_006 + 1","OnTransition":"_EV_scr_seq_D49R0107_007 + 1"},"constants":{"_EV_scr_seq_D49R0107_000":0,"_EV_scr_seq_D49R0107_001":1,"_EV_scr_seq_D49R0107_002":2,"_EV_scr_seq_D49R0107_003":3,"_EV_scr_seq_D49R0107_004":4,"_EV_scr_seq_D49R0107_005":5,"_EV_scr_seq_D49R0107_006":6,"_EV_scr_seq_D49R0107_007":7,"obj_D49R0107_thlonowner":0,"obj_D49R0107_statuehero":1,"obj_D49R0107_statueheroine":2}}
