",["SEQ_SE_DP_KAIDAN2"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["WhiteOut",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["GoToIfSet",["FLAG_BEAT_KARATE_KING","_08B2"]],["NPCMsg",["msg_0533_T11R0101_00000"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0533_T11R0101_00001"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0533_T11R0101_00002"]],["End",[]],["SimpleNPCMsg",["msg_0533_T11R0101_00003"]],["End",[]]]},"messages":{"msg_0533_T11R0101_00000":"Hello!\\rKarate King, the Fighting Dojo’s\\nmaster, is in a cave in Johto for\\ffurther training.","msg_0533_T11R0101_00001":"Hello!\\rWe are letting the Gym Leaders use the\\nDojo while the Karate King is away.\\rYou can give them a call when you\\nregister their numbers.\\rThey say they are happy to accept\\nyour challenge as long as they are\\fnot busy.","msg_0533_T11R0101_00002":"“Struggle for vengeance”","msg_0533_T11R0101_00003":"“A complicated fracture”","msg_0533_T11R0101_00004":"Falkner: Hi! I’ve been waiting for you!\\rIt’s a pleasure to be able to battle\\nyou again!\\r","msg_0533_T11R0101_00005":"Falkner: Mmm...\\nIt’s still a long way to become\\fthe best Trainer...","msg_0533_T11R0101_00006":"Bugsy: Good to see you again!\\rBehold my bug research!\\r","msg_0533_T11R0101_00007":"Bugsy: You must have studied\\na lot about Pokémon!","msg_0533_T11R0101_00008":"Whitney: I never break my promises!\\nAre you ready?\\r","msg_0533_T11R0101_00009":"Whitney: You really are strong!\\nBut I won’t lose next time!","msg_0533_T11R0101_00010":"Chuck: There you are!\\rTaste my 24-hour training!\\r","msg_0533_T11R0101_00011":"Chuck: Wahaha!\\nA battle with you is never boring!","msg_0533_T11R0101_00012":"Jasmine: We’re here as we promised...\\nAre you prepared?\\r","msg_0533_T11R0101_00013":"Jasmine: True to your reputation...","msg_0533_T11R0101_00014":"Morty: I was just talking about you...\\nLet’s battle!\\r","msg_0533_T11R0101_00015":"Morty: I’ve lost again...\\rYou may have something more than\\njust strength.","msg_0533_T11R0101_00016":"Pryce: Finally.\\rNo need for words.\\nA Pokémon battle is the way for us\\fto communicate.\\r","msg_0533_T11R0101_00017":"Pryce: Mmm...\\nImpressive!","msg_0533_T11R0101_00018":"Clair: ...You are here.\\nNow let’s battle!\\r","msg_0533_T11R0101_00019":"Clair: Way to go.\\n...\\fNow give it your all!","msg_0533_T11R0101_00020":"Lt. Surge: Hey!\\nThe promise we made!\\fLet’s battle again!\\r","msg_0533_T11R0101_00021":"Lt. Surge: Oh no!\\nYou are very strong!\\fBut I will repay my debt someday.","msg_0533_T11R0101_00022":"Sabrina: I knew you’d come!\\nI had a feeling.\\rWhat? We promised each other,\\nso it’s no surprise?\\r...Well, you may be right.\\r","msg_0533_T11R0101_00023":"Sabrina: I know...you will give me a call\\nagain sometime.","msg_0533_T11R0101_00024":"Erika: How are you?\\nGood to see you again!\\rThis place really doesn’t suit me,\\fbut...let’s ignore that and battle!\\r","msg_0533_T11R0101_00025":"Erika: You have grown even stronger...","msg_0533_T11R0101_00026":"Misty: So here you are...\\nDon’t make me wait!\\rI’ve heard a lot of good things\\nabout you since our last battle.\\rLet me test how good you are!\\r","msg_0533_T11R0101_00027":"Misty: Wow!\\nYou are getting stronger by\\fthe battle!","msg_0533_T11R0101_00028":"Brock: All right!\\nTime to fulfill our promise!\\fLet’s have a Pokémon battle!\\r","msg_0533_T11R0101_00029":"Brock: I’ve lost again...\\nYou aren’t adventuring around\\ffor nothing!","msg_0533_T11R0101_00030":"Janine: I can’t use my ninja technique,\\nbut I won’t let you win!\\r","msg_0533_T11R0101_00031":"Janine: I lost today,\\nbut I’ll win next time!","msg_0533_T11R0101_00032":"Blaine: You keep your word.\\nThat’s a good thing, kiddo!\\r","msg_0533_T11R0101_00033":"Blaine: Waaah!\\rIf I had known this Dojo was going to be\\navailable, I wouldn’t have needed to\\frebuild my Gym.\\rWait! I still did, didn’t I?","msg_0533_T11R0101_00034":"Blue: Good!\\nThanks for coming to lose to me!\\r","msg_0533_T11R0101_00035":"Blue: Hahaha!\\nMy scare tactic doesn’t scare you\\fat all!"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T11R0101_003 + 1"},"constants":{"_EV_scr_seq_T11R0101_000":0,"_EV_scr_seq_T11R0101_001":1,"_EV_scr_seq_T11R0101_002":2,"_EV_scr_seq_T11R0101_003":3,"_EV_scr_seq_T11R0101_004":4,"_EV_scr_seq_T11R0101_005":5,"_EV_scr_seq_T11R0101_006":6,"_EV_scr_seq_T11R0101_007":7,"_EV_scr_seq_T11R0101_008":8,"_EV_scr_seq_T11R0101_009":9,"_EV_scr_seq_T11R0101_010":10,"_EV_scr_seq_T11R0101_011":11,"_EV_scr_seq_T11R0101_012":12,"_EV_scr_seq_T11R0101_013":13,"_EV_scr_seq_T11R0101_014":14,"_EV_scr_seq_T11R0101_015":15,"_EV_scr_seq_T11R0101_016":16,"_EV_scr_seq_T11R0101_017":17,"_EV_scr_seq_T11R0101_018":18,"_EV_scr_seq_T11R0101_019":19,"obj_T11R0101_gsfighter":0,"obj_T11R0101_gsleader3":1,"obj_T11R0101_gsleader13":2,"obj_T11R0101_gsleader8":3,"obj_T11R0101_gsleader12":4,"obj_T11R0101_gsleader11":5,"obj_T11R0101_gsleader16":6,"obj_T11R0101_gsleader5":7,"obj_T11R0101_gsleader14":8,"obj_T11R0101_gsleader2":9,"obj_T11R0101_gsleader10":10,"obj_T11R0101_gsleader1":11,"obj_T11R0101_gsleader9":12,"obj_T11R0101_gsleader4":13,"obj_T11R0101_gsleader6":14,"obj_T11R0101_gsleader7":15,"obj_T11R0101_gsleader15":16}}
