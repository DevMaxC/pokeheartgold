,["FLAG_HIDE_NEW_BARK_RIVAL"]],["SetVar",["VAR_SCENE_CHERRYGROVE_CITY_OW","3"]],["ClearFlag",["FLAG_HIDE_CHERRYGROVE_RIVAL"]],["SetVar",["VAR_SCENE_ELMS_LAB","3"]],["ClearFlag",["FLAG_HIDE_ELMS_LAB_OFFICER"]],["SetVar",["VAR_SCENE_ROUTE_30_OW","2"]],["End",[]],["EmoteExclamationMark",[]],["EndMovement",[]],["WalkFastSouth",[]],["WalkFastWest",["5"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalEast",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkOnSpotNormalNorth",[]],["WalkOnSpotNormalEast",[]],["WalkOnSpotNormalWest",[]],["EndMovement",[]],["WalkFastWest",["3"]],["WalkFastNorth",[]],["Delay8",[]],["WalkOnSpotSlowerNorth",[]],["WalkSlowSouth",[]],["WalkSlowEast",["3"]],["WalkOnSpotSlowSouth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["WalkNormalEast",[]],["WalkNormalNorth",["2"]],["EndMovement",[]],["WalkOnSpotNormalWest",[]],["EndMovement",[]],["WalkOnSpotNormalWest",[]],["EndMovement",[]],["WalkSlowSouth",[]],["WalkSlowWest",["4"]],["WalkSlowNorth",["2"]],["WalkOnSpotSlowEast",[]],["EndMovement",[]],["WalkSlowSouth",[]],["WalkOnSpotSlowEast",[]],["EndMovement",[]],["WalkSlowNorth",[]],["WalkOnSpotSlowEast",[]],["EndMovement",[]],["WalkSlowSouth",["3"]],["Delay8",[]],["EndMovement",[]]]},"messages":{"msg_0377_R30R0201_00000":"You must be {STRVAR_1 3, 0, 0}.\\rIt was I who sent an email\\nto Professor Elm earlier.\\r","msg_0377_R30R0201_00001":"You must be {STRVAR_1 3, 0, 0}.\\rIt was I who sent an email\\nto Professor Elm earlier.\\r","msg_0377_R30R0201_00002":"This is what I want Professor Elm\\nto examine.\\r","msg_0377_R30R0201_00003":"A friend of mine from Ecruteak gave\\nit to me.\\rI bet you can’t find this kind of\\nEgg in Johto.\\rI thought Professor Elm might be able\\nto tell what this is.\\r“He’s the best when it comes to the\\nresearch of Pokémon evolution.”\\rThat’s a quote from the famous\\nProfessor Oak.\\r","msg_0377_R30R0201_00004":"You are returning to Professor Elm?\\rHere. Your Pokémon should have\\nsome rest.\\r","msg_0377_R30R0201_00005":"Sorry to trouble you, having you go\\nback and forth.\\rBut please make sure to hand it to\\nProfessor Elm!","msg_0377_R30R0201_00006":"Life is delightful!\\nAlways, new discoveries to be made!","msg_0377_R30R0201_00007":"Kimono Girls? What’re you talking\\nabout? I don’t know such people.\\fHee hee...\\r","msg_0377_R30R0201_00008":"Professor Oak: And with that...\\rI’m Professor Oak, a Pokémon\\nresearcher!\\rSo you’re {STRVAR_1 3, 0, 0}!\\rI was just visiting my friend\\nMr. Pokémon.\\rI heard you were running an errand\\nfor Professor Elm, so I waited here.\\r","msg_0377_R30R0201_00009":"Professor Oak: And with that...\\rI’m Professor Oak, a Pokémon\\nresearcher!\\rSo you’re {STRVAR_1 3, 0, 0}!\\rI was just visiting my friend\\nMr. Pokémon.\\rI heard you were running an errand\\nfor Professor Elm, so I waited here.\\r","msg_0377_R30R0201_00010":"Professor Oak: Oh! What’s this?\\nA rare Pokémon!\\rI see!\\nYou must be helping Professor Elm’s\\fresearch! I think I understand why\\fProfessor Elm gave you that Pokémon.\\rYou will treat your Pokémon with love\\nand care, it seems.\\r","msg_0377_R30R0201_00011":"Professor Oak: ...Ah!\\rYou seem to be dependable.\\nHow would you like to help me out?\\rSee? This is the latest version of\\nthe Pokédex.\\rIt automatically records data on\\nPokémon you’ve seen or caught.\\rIt’s a high-tech encyclopedia!\\nI’d like you to have it.\\r","msg_0377_R30R0201_00012":"{STRVAR_1 3, 0, 0} received the Pokédex\\nfrom Professor Oak!","msg_0377_R30R0201_00013":"Go meet many kinds of Pokémon and\\ncomplete that Pokédex!\\fBut I’ve stayed too long.\\rI have to get to Goldenrod for my\\nusual radio show.\\r{STRVAR_1 3, 0, 0}, I have a feeling that\\nthis is not the last time we’ll meet...\\rLet’s exchange numbers\\njust to be on the safe side.\\r","msg_0377_R30R0201_00014":"Go meet many kinds of Pokémon and\\ncomplete that Pokédex!\\fBut I’ve stayed too long.\\rI have to get to Goldenrod for my\\nusual radio show.\\r{STRVAR_1 3, 0, 0}, I have a feeling that\\nthis is not the last time we’ll meet...\\rLet’s exchange numbers\\njust to be on the safe side.\\r","msg_0377_R30R0201_00015":"{STRVAR_1 3, 0, 0} registered Professor Oak\\nin the Pokégear!\\r","msg_0377_R30R0201_00016":"Hm? That Red Scale! What’s that?\\nA red GYARADOS?\\fThat’s rare! I... I want it...\\r{STRVAR_1 3, 0, 0}, would you\\ncare to trade it?\\rI can offer this Exp. Share I got\\nfrom Professor Oak. {YESNO 0}","msg_0377_R30R0201_00017":"Hm? That Red Scale! What’s that?\\nA red GYARADOS?\\fThat’s rare! I... I want it...\\r{STRVAR_1 3, 0, 0}, would you\\ncare to trade it?\\rI can offer this Exp. Share I got\\nfrom Professor Oak. {YESNO 0}","msg_0377_R30R0201_00018":"","msg_0377_R30R0201_00019":"Arrgh, I reckon yer Bag’s full.","msg_0377_R30R0201_00020":"That’s disappointing.\\nThat happens to be very rare.","msg_0377_R30R0201_00021":"Hi, {STRVAR_1 3, 0, 0}!\\rI have something I want you to have\\nand was just about to send an email\\fto Professor Oak.\\r","msg_0377_R30R0201_00022":"Hi, {STRVAR_1 3, 0, 0}!\\rI have something I want you to have\\nand was just about to send an email\\fto Professor Oak.\\r","msg_0377_R30R0201_00023":"The thing is...\\nA friend of mine from Hoenn\\fcame over to give this to me.\\r","msg_0377_R30R0201_00024":"{STRVAR_1 3, 0, 0} received\\nthe Blue Orb!\\r","msg_0377_R30R0201_00025":"{STRVAR_1 3, 0, 0} received\\nthe Red Orb!\\r","msg_0377_R30R0201_00026":"That Orb has something to do with\\nthe ancient ruins located past\\fCianwood City, called the\\fEmbedded Tower.\\rBut only a handful of Trainers can\\nreach there...\\rThat’s where you come in.\\rProfessor Oak thinks highly of you,\\nand you are the proud Champion\\fafter all.\\rI’m sure you can solve the mystery\\nof the Orb and the secret of the ruins.","msg_0377_R30R0201_00027":"The Embedded Tower is past Cianwood,\\nsomewhere in the Cliff Cave.\\rOr so I heard.\\rOr so I remember.\\rOr so I believe!","msg_0377_R30R0201_00028":"It’s packed with foreign magazines.\\rCan’t even read their titles...","msg_0377_R30R0201_00029":"It’s a big computer.\\nHmm. It’s broken.","msg_0377_R30R0201_00030":"A whole pile of strange coins!\\fMaybe they’re from another country..."},"initTriggers":[{"var":"VAR_SCENE_EMBEDDED_TOWER","value":1,"script":"_EV_scr_seq_R30R0201_002 + 1"},{"var":"VAR_SCENE_MR_POKEMONS_HOUSE","value":0,"script":"_EV_scr_seq_R30R0201_001 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_R30R0201_003 + 1"},"constants":{"_EV_scr_seq_R30R0201_000":0,"_EV_scr_seq_R30R0201_001":1,"_EV_scr_seq_R30R0201_002":2,"_EV_scr_seq_R30R0201_003":3,"obj_R30R0201_gsgentleman":0,"obj_R30R0201_ookido":1}}
