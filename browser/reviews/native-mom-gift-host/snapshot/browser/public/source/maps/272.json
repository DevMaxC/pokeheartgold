,"DIR_WEST"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["WalkFastWest",["5"]],["EndMovement",[]],["FollowMonResetMovement",[]],["LockAll",[]],["FollowMonRecall",[]],["ApplyMovement",["obj_player","_10F4"]],["WaitMovement",[]],["PlaySE",["SEQ_SE_DP_KAIDAN2"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["Warp",["MAP_BATTLE_FRONTIER_BATTLE_CASTLE","0","21","9","DIR_WEST"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["WalkFastWest",["6"]],["EndMovement",[]],["FollowMonResetMovement",[]],["LockAll",[]],["FollowMonRecall",[]],["ApplyMovement",["obj_player","_1138"]],["WaitMovement",[]],["PlaySE",["SEQ_SE_DP_KAIDAN2"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["Warp",["MAP_BATTLE_FRONTIER_BATTLE_ARCADE","0","1","6","DIR_EAST"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["WalkFastEast",["5"]],["EndMovement",[]],["FollowMonResetMovement",[]],["LockAll",[]],["FollowMonRecall",[]],["ApplyMovement",["obj_player","_117C"]],["WaitMovement",[]],["PlaySE",["SEQ_SE_DP_KAIDAN2"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["Warp",["MAP_BATTLE_FRONTIER_BATTLE_FACTORY","0","1","7","DIR_EAST"]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ReleaseAll",[]],["End",[]],["WalkFastEast",["6"]],["EndMovement",[]],["End",[]]]},"messages":{"msg_0100_D32_00000":"Battle Tower... It’s so tall!\\nI wonder how many times my height it is?","msg_0100_D32_00001":"All the places in the Battle Frontier\\nlet you team up with a friend!\\fThat’s so cool, don’t you think?\\fI wish I had a friend to team up with...","msg_0100_D32_00002":"I am the super Idol in Johto!\\rI’ve come all the way to the\\nBattle Frontier to promote my\\flatest song!\\rBut...\\rEverybody seems to be a\\nPoké Maniac here!","msg_0100_D32_00003":"Fishing won’t keep me calm since I came\\nto know about the Battle Frontier.\\fWhen I go fishing, I find myself quitting\\fearly and coming here.","msg_0100_D32_00004":"The place I like best among the five\\nfacilities here would be the\\fBattle Castle, because you can see\\fLady Caitlin there!","msg_0100_D32_00005":"What makes me the most happy being\\na Trainer?\\rThe fact that Pokémon will always bring\\nme lots of friends!","msg_0100_D32_00006":"Just like people go through different\\nthings they can learn from, Pokémon\\flearn different things from battles.\\rBehind every experience, there is a\\nstory. Isn’t that right, dear?","msg_0100_D32_00007":"All experiences lead to a tale.\\nI’m not wrong, am I, dear?","msg_0100_D32_00008":"I’ve come to the Battle Frontier to\\nget a job!\\rThanks to my previous job, I’m good\\nat cooking, cleaning, and laundry!","msg_0100_D32_00009":"To be strong is to be weak.\\nTo be weak is to be strong.\\rSomebody told me that before.\\nI don’t quite understand it yet,\\fbut it sounds deep.\\rI’ll just give myself some time\\nto figure it out.","msg_0100_D32_00010":"Watching these people who care so much\\nabout Pokémon makes me feel ashamed\\fof my selfishness.\\rI’ll try and face my Pokémon for real!","msg_0100_D32_00011":"I wonder how many years it’s been since\\nI first met a Pokémon? ...Forty-nine!\\rOh, I lost the page that kept track of\\nhow many years, days, and hours...\\rCould it be my Pokémon nibbling on it?","msg_0100_D32_00012":"Trainers care about Pokémon\\nas the battle progresses.\\rIn return, Pokémon repay that trust\\nby using moves the best they can.\\rWhat you see in a battle is the trust\\nbetween people and Pokémon.\\rThis may seem obvious, but it’s actually\\nincredibly amazing!","msg_0100_D32_00013":"You cannot try anything if you are\\nafraid of losing battles.\\rBut!\\rGetting into a battle knowing you have\\nno chance of winning will only make your\\fPokémon suffer.\\rThat’s not courage!\\nTruly good Trainers know the balance\\fbetween courage and cautiousness.","msg_0100_D32_00014":"If you want to graduate from being\\na so-so Trainer, mark my words!\\rThe Pokémon’s type!\\rThe moves to be learned!\\rThe items to be held!\\rYou can’t overlook a single detail.","msg_0100_D32_00015":"When people win a battle, some laugh\\nat their opponent.\\rSome brag about his or her strengths.\\rSome even start to dance around \\nclaiming he or she is number one\\fin the world.\\rI respect people who win and then\\ncare about their opponent.","msg_0100_D32_00016":"Have you heard of the Brains of the\\nBattle Frontier?\\rThere are five facilities in the\\nBattle Frontier.\\rAt every one, you can win your way\\nthrough to challenge the bosses\\fcalled the Frontier Brains.\\fThey’re out-of-this-world tough!","msg_0100_D32_00017":"Allowing us to enjoy battles,\\nhelping us work,\\ftaking us to places far away,\\for just being good friends...\\rPokémon are so deep.\\nI wanna be like Pokémon.","msg_0100_D32_00018":"At the Battle Factory, you have to\\nkeep winning with rental Pokémon.\\rI may not stand a chance at other\\nfacilities, but I may go all the\\fway here!","msg_0100_D32_00019":"The Battle Hall is where Pokémon battle\\none-on-one for as long as they can.\\rEven my MAGIKARP has a shot at\\nnumber one!\\rWow!\\rJust the thought of it makes\\nme excited!","msg_0100_D32_00020":"Life is full of ebbs and flows.\\nI’ll keep my inflatable tube close.\\rI could call it the wisdom I gained\\nin the last five years of my life.","msg_0100_D32_00021":"Welcome to the Exchange Service\\nCorner!\\rWould you like to trade in your BP\\nfor some prizes? {YESNO 0}","msg_0100_D32_00022":"Please come back any time you want!\\n","msg_0100_D32_00023":"{STRVAR_1 8, 0, 0} will cost {STRVAR_1 50, 1, 0} BP.\\nIs that OK? {YESNO 0}","msg_0100_D32_00024":"{STRVAR_1 8, 0, 0} {STRVAR_1 6, 1, 0} will\\ncost {STRVAR_1 51, 2, 0} BP.\\fIs that OK? {YESNO 0}","msg_0100_D32_00025":"","msg_0100_D32_00026":"You put away the {STRVAR_1 8, 0, 0}\\nin the {STRVAR_1 18, 1, 0} Pocket.\\r","msg_0100_D32_00027":"I’m sorry, but you don’t have\\nenough BP.\\r","msg_0100_D32_00028":"","msg_0100_D32_00029":"I’m sorry, but your Bag is full.\\r","msg_0100_D32_00030":"Please choose the TM you\\nwould like. {YESNO 0}","msg_0100_D32_00031":"Please choose the item you\\nwould like. {YESNO 0}","msg_0100_D32_00032":"","msg_0100_D32_00033":"","msg_0100_D32_00034":"Battle Tower\\nNever Lose! Keep Winning!","msg_0100_D32_00035":"Battle Hall\\nLet Each Pokémon Seek No. 1","msg_0100_D32_00036":"Battle Castle\\nManage Battles with Castle Points","msg_0100_D32_00037":"Battle Arcade\\nWhere Events Sway Outcomes","msg_0100_D32_00038":"Battle Factory\\nWin Consecutively with Rental Pokémon","msg_0100_D32_00039":"A Trainer who just caught a Pokémon.\\nThat’s what this statue represents.","msg_0100_D32_00040":"“Boastful of Capture”...\\nThat seems to be the title.","msg_0100_D32_00041":"This...!\\nA scale model of the Battle Frontier."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_D32_037 + 1"},"constants":{"_EV_scr_seq_D32_000":0,"_EV_scr_seq_D32_001":1,"_EV_scr_seq_D32_002":2,"_EV_scr_seq_D32_003":3,"_EV_scr_seq_D32_004":4,"_EV_scr_seq_D32_005":5,"_EV_scr_seq_D32_006":6,"_EV_scr_seq_D32_007":7,"_EV_scr_seq_D32_008":8,"_EV_scr_seq_D32_009":9,"_EV_scr_seq_D32_010":10,"_EV_scr_seq_D32_011":11,"_EV_scr_seq_D32_012":12,"_EV_scr_seq_D32_013":13,"_EV_scr_seq_D32_014":14,"_EV_scr_seq_D32_015":15,"_EV_scr_seq_D32_016":16,"_EV_scr_seq_D32_017":17,"_EV_scr_seq_D32_018":18,"_EV_scr_seq_D32_019":19,"_EV_scr_seq_D32_020":20,"_EV_scr_seq_D32_021":21,"_EV_scr_seq_D32_022":22,"_EV_scr_seq_D32_023":23,"_EV_scr_seq_D32_024":24,"_EV_scr_seq_D32_025":25,"_EV_scr_seq_D32_026":26,"_EV_scr_seq_D32_027":27,"_EV_scr_seq_D32_028":28,"_EV_scr_seq_D32_029":29,"_EV_scr_seq_D32_030":30,"_EV_scr_seq_D32_031":31,"_EV_scr_seq_D32_032":32,"_EV_scr_seq_D32_033":33,"_EV_scr_seq_D32_034":34,"_EV_scr_seq_D32_035":35,"_EV_scr_seq_D32_036":36,"_EV_scr_seq_D32_037":37,"_EV_scr_seq_D32_038":38,"obj_D32_gswoman1":0,"obj_D32_gsoldwoma