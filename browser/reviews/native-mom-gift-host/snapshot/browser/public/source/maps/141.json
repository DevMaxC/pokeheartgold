plyMovement",["obj_player","_03B4"]],["WaitMovement",[]],["NPCMsg",["msg_0631_T30GYM0101_00002"]],["CloseMsg",[]],["SetFlag",["FLAG_UNK_138"]],["Compare",["VAR_TEMP_x4000","12"]],["GoToIfNe",["_032D"]],["ApplyMovement",["obj_T30GYM0101_sunglasses","_03C0"]],["GoTo",["_0350"]],["Compare",["VAR_TEMP_x4000","13"]],["GoToIfNe",["_0348"]],["ApplyMovement",["obj_T30GYM0101_sunglasses","_03CC"]],["GoTo",["_0350"]],["ApplyMovement",["obj_T30GYM0101_sunglasses","_03D8"]],["WaitMovement",[]],["FollowMonRecall",[]],["SetFollowMonInhibitState",["1"]],["FollowMonMoveToPlayer",[]],["ChangeObjectMovement",["253","56"]],["SetVar",["VAR_UNK_4120","1"]],["SetVar",["VAR_UNK_4120","1"]],["ReleaseAll",[]],["End",[]],["FaceWest",[]],["EmoteExclamationMark",[]],["WalkNormalWest",["2"]],["EndMovement",[]],["FaceWest",[]],["EmoteExclamationMark",[]],["WalkNormalWest",[]],["EndMovement",[]],["FaceWest",[]],["EmoteExclamationMark",[]],["EndMovement",[]],["Delay8",["5"]],["FaceEast",[]],["EndMovement",[]],["Delay8",["4"]],["FaceEast",[]],["EndMovement",[]],["Delay8",["2"]],["FaceEast",[]],["EndMovement",[]],["WalkNormalEast",["2"]],["FaceSouth",[]],["EndMovement",[]],["WalkNormalEast",[]],["FaceSouth",[]],["EndMovement",[]],["FaceSouth",[]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_RISING","VAR_SPECIAL_RESULT"]],["BufferPlayersName",["0"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_0407"]],["NPCMsg",["msg_0631_T30GYM0101_00010"]],["GoTo",["_040A"]],["NPCMsg",["msg_0631_T30GYM0101_00011"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0631_T30GYM0101_00000":"Yo! Champ in the making!\\rThe Gym has unstable footing.\\nKeep your Pokémon in their Poké Balls.\\rNow, Clair uses the mythical and sacred\\nDragon-type Pokémon.\\rYou can’t damage them very easily.\\rBut you know, they’re supposed\\nto be weak against Ice-type moves.","msg_0631_T30GYM0101_00001":"Hey!\\nYou were great to beat Clair!\\rWhat she says is one thing, but you are\\nalready quite the Trainer. I think...\\rI’d still do what Clair wants you to\\ndo, though.","msg_0631_T30GYM0101_00002":"Yo! Champ in the making!\\rThe Gym has unstable footing.\\nKeep your Pokémon in their Poké Balls.\\rNow, Clair uses the mythical and sacred\\nDragon-type Pokémon.\\rYou can’t damage them very easily.\\rBut you know, they’re supposed\\nto be weak against Ice-type moves.\\r","msg_0631_T30GYM0101_00003":"Clair: I am Clair.\\rThe world’s best Dragon-type master.\\rI can hold my own against even the\\nPokémon League’s Elite Four.\\rDo you still want to take me on?\\r...Fine.\\nLet’s do this!\\rAs a Gym Leader, I will use my full\\npower against any opponent!\\r","msg_0631_T30GYM0101_00004":"Clair: I won’t concede this.\\rI might have lost, but you’re still\\nnot ready for the Pokémon League.\\rI know. You should take the\\nDragon-master challenge.\\rBehind this Gym is a place called\\nDragon’s Den. There is a small shrine\\fat its heart.\\fGo there.\\rIf you can prove that you’ve lost\\nyour lazy ideals, I will admit you\\fare a Trainer worthy of a Gym Badge!","msg_0631_T30GYM0101_00005":"Clair: What’s the matter?\\rIs it too much to expect of you?","msg_0631_T30GYM0101_00006":"Clair: You’ve kept me waiting!\\rHere! Take this!\\r","msg_0631_T30GYM0101_00007":"Clair: That contains Dragon Pulse.\\rWell, Dragon Pulse is a kind of...umm...\\nNever mind!\\rIt’s a huge energy of some kind.\\nIf you don’t want it, you don’t\\fhave to take it.\\r","msg_0631_T30GYM0101_00008":"What is this? You don’t have room?","msg_0631_T30GYM0101_00009":"Clair: What’s the matter?\\rAren’t you headed to the\\nPokémon League?\\rYour face...it tells me you have some\\nunfinished business...\\rWait a sec!\\nYou came from New Bark Town\\fwhere Professor Elm’s Lab is, right?\\rYou may want to go back to\\nNew Bark Town.\\rWhatever you have to face from now,\\nit’ll be more difficult.\\rBut don’t you dare give up!\\rIf you do, I’ll feel even worse\\nabout having lost to you!\\r...\\nGive it your all.","msg_0631_T30GYM0101_00010":"Blackthorn City Pokémon Gym","msg_0631_T30GYM0101_00011":"Blackthorn City Pokémon Gym\\rLeader: Clair\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T30GYM0101_001 + 1"},"constants":{"_EV_scr_seq_T30GYM0101_000":0,"_EV_scr_seq_T30GYM0101_001":1,"_EV_scr_seq_T30GYM0101_002":2,"_EV_scr_seq_T30GYM0101_003":3,"_EV_scr_seq_T30GYM0101_004":4,"_EV_scr_seq_T30GYM0101_005":5,"obj_T30GYM0101_gsleader8":0,"obj_T30GYM0101_gsman3":1,"obj_T30GYM0101_gswoman3":2,"obj_T30GYM0101_gsman3_2":3,"obj_T30GYM0101_gswoman3_2":4,"obj_T30GYM0101_gsman3_3":5,"obj_T30GYM0101_sunglasses":6}}
