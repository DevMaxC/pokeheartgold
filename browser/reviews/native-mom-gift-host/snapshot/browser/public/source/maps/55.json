"_06BC"]],["WaitMovement",[]],["SetFlag",["FLAG_UNK_189"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["CameronPhoto",["57"]],["LockAll",[]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ClearFlag",["FLAG_UNK_189"]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","2"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","5"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","3"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["WalkNormalEast",[]],["WalkNormalNorth",["2"]],["WalkNormalWest",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["WalkNormalWest",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["WalkNormalEast",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["Delay8",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalEast",[]],["WalkNormalNorth",[]],["FaceSouth",[]],["EndMovement",[]]]},"messages":{"msg_0491_T07_00000":"This is my trusted pal, POLIWRATH.\\rI wonder if it will become a Frog\\nPokémon someday.","msg_0491_T07_00001":"POLIWRATH: Poli poli!","msg_0491_T07_00002":"Oh, my!\\nWere you staring at me?\\rSeeing me come out of the Game Corner\\nwith a whole pile of Coins...\\fAnd grinning to myself?\\fYou were, weren’t you?","msg_0491_T07_00003":"GRIMER started to appear recently.\\nYou see the pond in front of the house?\\rIt has GRIMER, too.\\nI wonder where they came from.\\rSigh...","msg_0491_T07_00004":"Ha ha! This Gym is great!\\nIt’s full of strong Trainers!","msg_0491_T07_00005":"I’ll tell you a secret!\\rThe Celadon Condominiums have some\\nplaces you can only reach by taking the\\felevator on the second floor!","msg_0491_T07_00006":"The restaurant there is having an\\neating contest.\\rI heard that we have a great\\ncontestant from the Sinnoh region\\fthis year.","msg_0491_T07_00007":"The Celadon Department Store offers\\nthe widest range of items!\\fYou can buy anything you want!\\r...Do I sound like their\\nsales representative?","msg_0491_T07_00008":"I love this kind of place where\\nthere are many buildings!\\rI heard Johto also has a city called\\nGoldenrod that has many\\ftall buildings.\\fI would love to visit there sometime.","msg_0491_T07_00009":"Erika: Hi, Jasmine. I heard Whitney from\\nGoldenrod Gym said you were too\\fplain and should look more fancy.\\fIs that true?\\r","msg_0491_T07_00010":"Jasmine: Yes...\\rI’m thinking maybe I should\\nparticipate in this Contest in Sinnoh\\fto try and be more vibrant...\\r","msg_0491_T07_00011":"Erika: How did it go?\\r","msg_0491_T07_00012":"Jasmine: I couldn’t bring myself to\\ngo to the Contest.\\r","msg_0491_T07_00013":"Erika: Oh, I see...\\rThen why don’t you try putting on\\nsomething especially gorgeous?\\r","msg_0491_T07_00014":"Jasmine: Ah, yes!\\nMaybe I can bring myself to\\fenter the Contest!\\r","msg_0491_T07_00015":"Erika: How about a fancy, light blue\\noutfit with a cape over it?\\r","msg_0491_T07_00016":"Jasmine: What?\\nThat’s too embarrassing!\\r","msg_0491_T07_00017":"Erika: I see.\\nYou think Clair from Blackthorn is a\\flittle embarrassing...\\fI’m just taking notes.\\r","msg_0491_T07_00018":"Jasmine: Oh, no!\\nErika, that’s not what I meant!","msg_0491_T07_00019":"Erika: Hi, {STRVAR_1 3, 0, 0}.\\rWould you like to\\nexchange numbers? {YESNO 0}","msg_0491_T07_00020":"{STRVAR_1 3, 0, 0} registered Erika\\nin the Pokégear!","msg_0491_T07_00021":"Erika: I am often free in the morning\\non Sunday.\\rCall me around then.","msg_0491_T07_00022":"Erika: Oh, that’s too bad...","msg_0491_T07_00023":"Erika: Would you like to\\nexchange numbers? {YESNO 0}","msg_0491_T07_00024":"Erika: Hi!\\nGood to see you here.\\rHow would you like to take a picture\\nwith me? {YESNO 0}","msg_0491_T07_00025":"Erika: Try and look cool now.\\r","msg_0491_T07_00026":"Erika: Good job.\\nIt looks good!","msg_0491_T07_00027":"Erika: Oh, that’s too bad...","msg_0491_T07_00028":"Your Photo Album is full.\\rAccess your PC and delete\\nsome pictures.","msg_0491_T07_00029":"Jasmine: Amphy is well thanks to you.","msg_0491_T07_00030":"Celadon City\\nCity of the Rainbow’s Colors","msg_0491_T07_00031":"Celadon City Pokémon Gym\\nLeader: Erika\\fThe Nature-Loving Princess!","msg_0491_T07_00032":"Find what you need at the\\nCeladon Dept. Store!","msg_0491_T07_00033":"Celadon Condominiums","msg_0491_T07_00034":"Celadon Game Corner\\nA Fun Place for Everyone","msg_0491_T07_00035":"Trainer Tips\\rGuard Spec. protects Pokémon\\nfrom status-reduction moves\\fduring battle.\\rGet your items at the\\nCeladon Dept. Store!"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T07_015 + 1"},"constants":{"_EV_scr_seq_T07_000":0,"_EV_scr_seq_T07_001":1,"_EV_scr_seq_T07_002":2,"_EV_scr_seq_T07_003":3,"_EV_scr_seq_T07_004":4,"_EV_scr_seq_T07_005":5,"_EV_scr_seq_T07_006":6,"_EV_scr_seq_T07_007":7,"_EV_scr_seq_T07_008":8,"_EV_scr_seq_T07_009":9,"_EV_scr_seq_T07_010":10,"_EV_scr_seq_T07_011":11,"_EV_scr_seq_T07_012":12,"_EV_scr_seq_T07_013":13,"_EV_scr_seq_T07_014":14,"_EV_scr_seq_T07_015":15,"_EV_scr_seq_T07_016":16,"_EV_scr_seq_T07_017":17,"_EV_scr_seq_T07_018":18,"obj_T07_gsbigman":0,"obj_T07_tsure_poke_static_poliwrath":1,"obj_T07_gsboy1":2,"obj_T07_gswoman2":3,"obj_T07_gsgirl1":4,"obj_T07_gswoman1":5,"obj_T07_gsboy2":6,"obj_T07_gsoldman1":7,"obj_T07_gsoldman1_2":8,"obj_T07_gsleader12":9,"obj_T07_gsleader6":10,"obj_T07_tree":11,"obj_T07_monstarball":12,"obj_T07_gsmiddleman1":13}}
