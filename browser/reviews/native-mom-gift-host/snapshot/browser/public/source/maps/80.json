]],["FaceNorth",["2"]],["FaceEast",["2"]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",["2"]],["FaceSouth",["2"]],["FaceWest",["2"]],["FaceNorth",["2"]],["FaceEast",[]],["SetInvisible",["0"]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_FOG","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_029E"]],["NPCMsg",["msg_0614_T27GYM0101_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["BufferPlayersName",["0"]],["NPCMsg",["msg_0614_T27GYM0101_00008"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_FOG","VAR_SPECIAL_RESULT"]],["BufferPlayersName",["0"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_02D3"]],["NPCMsg",["msg_0614_T27GYM0101_00010"]],["GoTo",["_02D6"]],["NPCMsg",["msg_0614_T27GYM0101_00011"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0614_T27GYM0101_00000":"Morty: It’s good of you to have come.\\rHere in Ecruteak, Pokémon have long\\nbeen revered.\\rIt’s said that a rainbow-hued\\nPokémon will come down to appear\\fbefore a truly powerful Trainer.\\rI believed that tale, so I have\\nsecretly trained here all my life.\\rAs a result, I can now see what\\nothers cannot.\\rI see a shadow of the person who\\nwill make the Pokémon appear.\\rI believe that person is me!\\rYou’re going to help me reach\\nthat level!\\r","msg_0614_T27GYM0101_00001":"Morty: I don’t think our potentials are\\nso different. But you seem to have\\fsomething more than that...\\rSo be it. This Badge is yours.\\r","msg_0614_T27GYM0101_00002":"{STRVAR_1 3, 0, 0} received\\nthe Fog Badge from Morty!","msg_0614_T27GYM0101_00003":"Morty: By having the Fog Badge,\\nPokémon up to Lv. 50, including traded\\fPokémon, will obey you.\\rAlso, Pokémon will be able to use Surf.\\rHere is another thing...\\nI want you to have this, too.\\r","msg_0614_T27GYM0101_00004":"","msg_0614_T27GYM0101_00005":"Morty: It’s Shadow Ball. It causes\\ndamage and may reduce Special Defense.\\fUse it if it appeals to you.","msg_0614_T27GYM0101_00006":"Morty: I get it...\\rThe person the Kimono Girls were\\ntalking about must be you...\\rNever mind.\\rYou should be strong enough to go\\nacross the sea.\\rWhen you go west and then south,\\nyou’ll reach Olivine City.\\fWhy don’t you head for it?","msg_0614_T27GYM0101_00007":"Yo! Champ in the making!\\nThe Trainers here use Ghost-type\\fPokémon at will.\\rA ghost is like a shade or a phantom...\\nIt won’t do any good to use physical\\fstrength alone.","msg_0614_T27GYM0101_00008":"Whew, {STRVAR_1 3, 0, 0}.\\nYou did great!\\rI was cowering in the corner out of\\npure terror!","msg_0614_T27GYM0101_00009":"You have business with the Gym Leader?\\rMorty, the Gym Leader, has gone to\\nthe Burned Tower.\\rSorry, but you’ll have to leave.\\nHo ho ho.\\r","msg_0614_T27GYM0101_00010":"Ecruteak City Pokémon Gym","msg_0614_T27GYM0101_00011":"Ecruteak City Pokémon Gym\\rLeader: Morty\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[{"var":"VAR_UNK_4079","value":0,"script":"_EV_scr_seq_T27GYM0101_004 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T27GYM0101_000 + 1"},"constants":{"_EV_scr_seq_T27GYM0101_000":0,"_EV_scr_seq_T27GYM0101_001":1,"_EV_scr_seq_T27GYM0101_002":2,"_EV_scr_seq_T27GYM0101_003":3,"_EV_scr_seq_T27GYM0101_004":4,"_EV_scr_seq_T27GYM0101_005":5,"obj_T27GYM0101_sunglasses":0,"obj_T27GYM0101_gsleader4":1,"obj_T27GYM0101_itako":2,"obj_T27GYM0101_itako_2":3,"obj_T27GYM0101_itako_3":4,"obj_T27GYM0101_itako_4":5,"obj_T27GYM0101_gsoldman1":6}}
