,["SimpleNPCMsg",["msg_0541_T11R0802_00015"]],["End",[]],["SimpleNPCMsg",["msg_0541_T11R0802_00014"]],["End",[]],["GoToIfSet",["FLAG_HIDE_SAFFRON_CITY_COPYCAT_HOUSE_CLEFAIRY_DOLL","_0431"]],["Compare",["VAR_UNK_40FF","2"]],["GoToIfEq",["_0433"]],["SimpleNPCMsg",["msg_0541_T11R0802_00016"]],["End",[]],["End",[]],["SimpleNPCMsg",["msg_0541_T11R0802_00017"]],["End",[]]]},"messages":{"msg_0541_T11R0802_00000":"{STRVAR_1 3, 0, 0}: Hi! Do you like Pokémon?\\r{STRVAR_1 3, 0, 0}: Uh, no, I just asked you.\\r{STRVAR_1 3, 0, 0}: Huh? You’re strange!\\r","msg_0541_T11R0802_00001":"{STRVAR_1 3, 0, 0}: Hi. You must like\\nPokémon.\\r{STRVAR_1 3, 0, 0}: No, not me. I asked you.\\r{STRVAR_1 3, 0, 0}: Pardon? You’re weird!\\r","msg_0541_T11R0802_00002":"Copycat: Hmm? Quit mimicking?\\nBut that’s my main hobby!\\r","msg_0541_T11R0802_00003":"{STRVAR_1 3, 0, 0}: Hi! I heard that you\\nlost your cherished Poké Doll.\\r{STRVAR_1 3, 0, 0}: If I find it, you’ll give\\nme a Magnet Train Pass?\\r{STRVAR_1 3, 0, 0}: I’ll go find it for you.\\r{STRVAR_1 3, 0, 0}: You think you lost it\\nwhen you went to Vermilion City?\\r","msg_0541_T11R0802_00004":"{STRVAR_1 3, 0, 0}: Hi! I heard that you\\nlost your cherished Poké Doll.\\r{STRVAR_1 3, 0, 0}: If I find it, you’ll give\\nme a Magnet Train Pass?\\r{STRVAR_1 3, 0, 0}: I’ll go find it for you.\\r{STRVAR_1 3, 0, 0}: You think you lost it\\nwhen you went to Vermilion City?\\r","msg_0541_T11R0802_00005":"Copycat: Pardon?\\rI shouldn’t decide what you should do?\\rBut I’m really worried...\\nWhat if someone finds it?\\r","msg_0541_T11R0802_00006":"Copycat: Yay! That’s my CLEFAIRY\\nPoké Doll!\\rSee the tear where the right arm is\\nsewn on? That’s proof!\\rOK. I’ll give you this Magnet Train Pass\\nas I promised!\\r","msg_0541_T11R0802_00007":"","msg_0541_T11R0802_00008":"Copycat: You show it at the ticket\\ngate to get on the Magnet Train.\\rThe rail-company man gave me that\\nwhen they tore down our old house\\ffor the station.","msg_0541_T11R0802_00009":"{STRVAR_1 3, 0, 0}: Hi!\\nThanks a lot for the Magnet Train Pass!\\r{STRVAR_1 3, 0, 0}: Pardon?\\r{STRVAR_1 3, 0, 0}: Is it that fun to mimic\\nmy every move?\\r","msg_0541_T11R0802_00010":"{STRVAR_1 3, 0, 0}: Hi!\\nThanks a lot for the Magnet Train Pass!\\r{STRVAR_1 3, 0, 0}: Pardon?\\r{STRVAR_1 3, 0, 0}: Is it that fun to mimic\\nmy every move?\\r","msg_0541_T11R0802_00011":"Copycat: You bet! It’s a scream!\\r","msg_0541_T11R0802_00012":"This Poké Doll looks just like the\\nreal thing...\\rAw! It moved!\\nIt’s a real BANETTE!","msg_0541_T11R0802_00013":"BANETTE: Giggle!","msg_0541_T11R0802_00014":"This is a flowerlike Poké Doll...\\nIt is a CHERRIM Poké Doll!","msg_0541_T11R0802_00015":"This is a nose-like Poké Doll...\\nIt is a NOSEPASS Poké Doll!","msg_0541_T11R0802_00016":"It’s a CLEFAIRY!\\nHuh?\\rOh, right. It’s a CLEFAIRY Poké Doll.","msg_0541_T11R0802_00017":"It’s a CLEFAIRY Poké Doll.\\rIt has a tear where the right arm\\nwas sewn on."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T11R0802_004 + 1","OnResume":"_EV_scr_seq_T11R0802_005 + 1"},"constants":{"_EV_scr_seq_T11R0802_000":0,"_EV_scr_seq_T11R0802_001":1,"_EV_scr_seq_T11R0802_002":2,"_EV_scr_seq_T11R0802_003":3,"_EV_scr_seq_T11R0802_004":4,"_EV_scr_seq_T11R0802_005":5,"_EV_scr_seq_T11R0802_006":6,"obj_T11R0802_gsgirl1":0,"obj_T11R0802_mono_pip":1,"obj_T11R0802_jupetta":2,"obj_T11R0802_var_1":3}}
