NT_PROGRESS","3"]],["CallIfEq",["_0636"]],["GoTo",["_0126"]],["End",[]],["SetVar",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","0"]],["Return",[]],["SetVar",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","2"]],["Return",[]],["Compare",["VAR_UNK_4143","0"]],["CallIfEq",["_067A"]],["Compare",["VAR_UNK_4143","1"]],["CallIfEq",["_067A"]],["Compare",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","1"]],["CallIfEq",["_0680"]],["Compare",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","3"]],["CallIfEq",["_0697"]],["GoTo",["_0126"]],["End",[]],["AddSpecialGameStat2",["SCORE_EVENT_BATTLE_FACTORY_SET_WON"]],["Return",[]],["NPCMsg",["msg_0107_D32R0301_00013"]],["BufferPlayersName",["0"]],["NPCMsg",["msg_0107_D32R0301_00015"]],["PlayFanfare",["SEQ_ME_ITEM"]],["WaitFanfare",[]],["SetVar",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","2"]],["Return",[]],["NPCMsg",["msg_0107_D32R0301_00013"]],["BufferPlayersName",["0"]],["NPCMsg",["msg_0107_D32R0301_00014"]],["PlayFanfare",["SEQ_ME_ITEM"]],["WaitFanfare",[]],["SetVar",["VAR_BATTLE_FACTORY_PRINT_PROGRESS","4"]],["CallStd",["std_frontier_gold_prints_check"]],["Return",[]],["GoTo",["_0126"]],["End",[]],["WalkNormalNorth",["2"]],["Delay8",[]],["WalkNormalNorth",[]],["EndMovement",[]],["WalkNormalNorth",["2"]],["Delay8",[]],["WalkNormalNorth",[]],["EndMovement",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00027"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00028"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00029"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00030"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00031"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00032"]],["End",[]],["SimpleNPCMsg",["msg_0107_D32R0301_00033"]],["End",[]]]},"messages":{"msg_0107_D32R0301_00000":"Welcome to the Battle Factory!\\rI am your guide to the Single and\\nDouble Battle challenges.\\rPlease be aware that these challenges\\nare designed for a single Trainer.\\r","msg_0107_D32R0301_00001":"Which challenge would\\nyou like to take? {YESNO 0}","msg_0107_D32R0301_00002":"At the Battle Factory, you may take\\nSingle or Double Battle challenges\\fusing rental Pokémon.\\rOnce entered, your challenge lasts\\nuntil you lose.\\rAfter each win, you may trade a rented\\nPokémon for one of the opponent’s.\\rThe Level 50 option starts you off with\\nPokémon that only know weak moves.\\rThe Open Level option gives you access\\nto Lv. 100 Pokémon with powerful moves\\ffrom the start.\\rIf you manage to win seven matches in\\na row, you will earn Battle Points (BP).\\rIf you want to interrupt your\\nchallenge, please save the game.\\rIf you don’t save, you will be\\ndisqualified from your challenge.\\rPlease be aware of that!\\r","msg_0107_D32R0301_00003":"Welcome to the Battle Factory!\\rI am your guide to the Multi Battle\\nchallenge.\\rPlease be aware that this challenge\\nrequires two Trainers.\\r","msg_0107_D32R0301_00004":"Would you like to take the Battle\\nFactory Multi Battle challenge? {YESNO 0}","msg_0107_D32R0301_00005":"You may team up with a friend for a\\nMulti Battle challenge using rental\\fPokémon.\\rBoth partners will be provided with two\\nrental Pokémon each.\\rOnce entered, you and your partner\\nconduct Multi Battles until you lose.\\rAfter each win, you or your partner\\nmay trade a single rented Pokémon.\\rIf you manage to win seven matches in\\na row, you will earn Battle Points (BP).\\rThe Level 50 option starts with rental\\nPokémon that only know weak moves.\\rThe Open Level option lets you rent\\nLv. 100 Pokémon with powerful moves\\ffrom the start.\\rPlease note: a Battle Factory Multi\\nBattle challenge can’t be interrupted.\\r","msg_0107_D32R0301_00006":"We hope to see you again!","msg_0107_D32R0301_00007":"Which challenge level would you like\\nto play? Level 50 or Open Level? {YESNO 0}","msg_0107_D32R0301_00008":"You must save the game before I\\nshow you in. Is that OK? {YESNO 0}","msg_0107_D32R0301_00009":"Right this way, please!","msg_0107_D32R0301_00010":"We look forward to your next visit.\\r","msg_0107_D32R0301_00011":"We’ve missed you!\\rYou must save the game before you\\nresume your challenge. Please wait.","msg_0107_D32R0301_00012":"Excuse me!\\rYou didn’t save before you quit your\\nchallenge last time.\\rBecause of that, you have been\\ndisqualified from your challenge!\\r","msg_0107_D32R0301_00013":"Congratulations!\\rIn recognition of your victory, we\\npresent you this commemorative print!\\r","msg_0107_D32R0301_00014":"The Gold Print was added to\\n{STRVAR_1 3, 0, 0}’s Vs. Recorder!\\r","msg_0107_D32R0301_00015":"The Silver Print was added to\\n{STRVAR_1 3, 0, 0}’s Vs. Recorder!\\r","msg_0107_D32R0301_00016":"SINGLE BATTLE","msg_0107_D32R0301_00017":"DOUBLE BATTLE","msg_0107_D32R0301_00018":"TAKE CHALLENGE","msg_0107_D32R0301_00019":"INFO","msg_0107_D32R0301_00020":"CANCEL","msg_0107_D32R0301_00021":"LEVEL 50","msg_0107_D32R0301_00022":"OPEN LEVEL","msg_0107_D32R0301_00023":"CANCEL","msg_0107_D32R0301_00024":"One Trainer should select\\n“BECOME LEADER.”\\rThe other Trainer must select\\n“JOIN GROUP.” {YESNO 0}","msg_0107_D32R0301_00025":"We need to launch DS Wireless\\nCommunications. {YESNO 0}\\n","msg_0107_D32R0301_00026":"You must save the game before I\\nshow you in. Please wait.","msg_0107_D32R0301_00027":"The staff tell you about the next\\nTrainer you’ll face.\\rThey’re very helpful here.\\nDon’t you think?\\n","msg_0107_D32R0301_00028":"They tell you about the next Trainer\\nyou’ll face? That’s really nice.\\rYou know, you can prepare for it\\nonce you know what kind of Trainer\\fthe next one is!","msg_0107_D32R0301_00029":"It’ll help you choose a Pokémon when\\nyou remember what kind of Pokémon\\fthe other Trainer had and what moves\\fthey used.","msg_0107_D32R0301_00030":"This is a place to battle with rental\\nPokémon, right?\\rIt is a good chance to try Pokémon\\nyou’ve never trained.\\rYou’ll learn about new Pokémon\\nwhile having exciting battles!\\rWhat more could you want?","msg_0107_D32R0301_00031":"Do you have a lot of Pokémon?\\rI’m not too proud to say this, but...\\nI have only a few!\\rBut there is nothing to worry about.\\nDo you know why?\\rThis facility, the Battle Factory, has\\nyou use rental Pokémon for battles!","msg_0107_D32R0301_00032":"So you have to battle with Pokémon\\nyou just met instead of with your\\fcherished Pokémon you’ve always\\fbattled with?\\rOh, I don’t know if I could...\\nWill they be nice to me...?\\fI’m a little worried.","msg_0107_D32R0301_00033":"All the Trainers gathered at the\\nBattle Frontier are nice,\\fpleasant people!\\rI’m patrolling here on duty, but\\notherwise I would love to change\\fmy uniform to participate!"},"initTriggers":[{"var":"VAR_UNK_4142","value":1,"script":"_EV_scr_seq_D32R0301_003 + 1"},{"var":"VAR_UNK_4142","value":2,"script":"_EV_scr_seq_D32R0301_001 + 1"},{"var":"VAR_UNK_4142","value":3,"script":"_EV_scr_seq_D32R0301_004 + 1"},{"var":"VAR_UNK_4142","value":255,"script":"_EV_scr_seq_D32R0301_002 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_D32R0301_013 + 1"},"constants":{"_EV_scr_seq_D32R0301_000":0,"_EV_scr_seq_D32R0301_001":1,"_EV_scr_seq_D32R0301_002":2,"_EV_scr_seq_D32R0301_003":3,"_EV_scr_seq_D32R0301_004":4,"_EV_scr_seq_D32R0301_005":5,"_EV_scr_seq_D32R0301_006":6,"_EV_scr_seq_D32R0301_007":7,"_EV_scr_seq_D32R0301_008":8,"_EV_scr_seq_D32R0301_009":9,"_EV_scr_seq_D32R0301_010":10,"_EV_scr_seq_D32R0301_011":11,"_EV_scr_seq_D32R0301_012":12,"_EV_scr_seq_D32R0301_013":13,"obj_D32R0301_bfsm":0,"obj_D32R0301_bfsw1":1,"obj_D32R0301_gsboy2":2,"obj_D32R0301_gswoman2":3,"obj_D32R0301_policeman":4,"obj_D32R0301_seaman_2":5,"obj_D32R0301_gswoman1":6,"obj_D32R0301_gsgentleman":7,"obj_D32R0301_gorggeousw":8}}
