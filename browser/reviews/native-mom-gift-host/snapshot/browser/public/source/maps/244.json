t",["2"]],["EndMovement",[]],["WalkSlowEast",["2"]],["EndMovement",[]],["WalkSlowNorth",[]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["GoToIfSet",["FLAG_UNK_109","_0B62"]],["NPCMsg",["msg_0125_D40R0107_00001"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["Compare",["VAR_TEMP_x4005","5"]],["GoToIfNe",["_0B78"]],["NPCMsg",["msg_0125_D40R0107_00008"]],["GoTo",["_0BA7"]],["Compare",["VAR_TEMP_x4005","6"]],["GoToIfNe",["_0B8E"]],["NPCMsg",["msg_0125_D40R0107_00008"]],["GoTo",["_0BA7"]],["Compare",["VAR_TEMP_x4005","4"]],["GoToIfNe",["_0BA4"]],["NPCMsg",["msg_0125_D40R0107_00006"]],["GoTo",["_0BA7"]],["NPCMsg",["msg_0125_D40R0107_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["GoToIfSet",["FLAG_UNK_109","_0BCD"]],["NPCMsg",["msg_0125_D40R0107_00001"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0125_D40R0107_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0125_D40R0107_00000":"Zuki: That’s right.\\nThis is where we welcome LUGIA.\\rWhen the dance we practiced many days\\nbecomes one with the sound of the\\fTidal Bell we entrusted with you, then\\fLUGIA shall come out from deep within\\fthe waterfall basin once again!\\r","msg_0125_D40R0107_00001":"This is all we can do for you...\\nWhat you do now is entirely up to you...","msg_0125_D40R0107_00002":"That is indeed LUGIA...\\nThe guardian of these islands from\\fancient times...\\rSo many have tried again and again,\\nonly to fail...\\r{STRVAR_1 3, 0, 0}, your heart in complete\\nharmony with the Tidal Bell has finally\\fallowed it to appear...\\r","msg_0125_D40R0107_00003":"{STRVAR_1 3, 0, 0}, don’t you see?\\rLUGIA... It must have been waiting for\\nsomeone like you all this time.\\fWouldn’t you agree...?","msg_0125_D40R0107_00004":"LUGIA: Gyaaas!\\r","msg_0125_D40R0107_00005":"You’ve done a great job. Say hello to\\nProfessor Elm for us.","msg_0125_D40R0107_00006":"You have not only made LUGIA appear,\\nbut you also caught it...\\rYou are so wonderful.\\nThere is nothing more for us to say.\\rTake good care of yourself in\\nyour journey...","msg_0125_D40R0107_00007":"If that is what you believe, we will not\\ntry to convince you otherwise.\\rStill, if you wish to see LUGIA once\\nmore, perhaps you can come back here\\fafter all has been settled...","msg_0125_D40R0107_00008":"I think once you turn your back to it,\\nLUGIA will not come back for\\fsome time...\\rIf you want to see LUGIA, perhaps you\\ncan come back here after all\\fhas been settled..."},"initTriggers":[],"initScripts":{"OnLoad":"_EV_scr_seq_D40R0107_002 + 1","OnResume":"_EV_scr_seq_D40R0107_004 + 1","OnTransition":"_EV_scr_seq_D40R0107_006 + 1"},"constants":{"_EV_scr_seq_D40R0107_000":0,"_EV_scr_seq_D40R0107_001":1,"_EV_scr_seq_D40R0107_002":2,"_EV_scr_seq_D40R0107_003":3,"_EV_scr_seq_D40R0107_004":4,"_EV_scr_seq_D40R0107_005":5,"_EV_scr_seq_D40R0107_006":6,"obj_D40R0107_dancer":0,"obj_D40R0107_dancer_2":1,"obj_D40R0107_dancer_3":2,"obj_D40R0107_dancer_4":3,"obj_D40R0107_dancer_5":4,"obj_D40R0107_lug_obj01":5,"obj_D40R0107_stop":6,"obj_D40R0107_stop_2":7,"obj_D40R0107_stop_3":8,"obj_D40R0107_stop_4":9,"obj_D40R0107_stop_5":10}}
