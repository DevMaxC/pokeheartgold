ReleaseAll",[]],["SetVar",["VAR_UNK_4082","0"]],["ReleaseAll",[]],["End",[]],["EmoteExclamationMark",[]],["EndMovement",[]]]},"messages":{"msg_0589_T25R0601_00000":"Apparently, there is an odd tree\\non Route 36.\\rThey say it dances when you\\nwater it...\\rOh, of course not!\\rThis is a Flower Shop, so we do have\\nwatering cans and things like that...\\rBut I cannot let you have one!\\nIt’s too dangerous!\\fHmmm...\\rWell, maybe if you manage to defeat\\nthe Goldenrod Gym Leader, it might\\fbe OK...","msg_0589_T25R0601_00001":"Apparently, there is an odd tree\\non Route 36.\\rThey say it dances when you water it...\\rOh, that’s a Plain Badge from\\nGoldenrod Gym!\\rDid you defeat Whitney?!\\nWell, then there’s nothing to worry\\fabout, is there?\\rI’ll let you use this SquirtBottle for\\na while then... Oh, never mind.\\fKeep it!\\r","msg_0589_T25R0601_00002":"The odd tree is on Route 36.\\nPlease be careful!","msg_0589_T25R0601_00003":"Lalala lalalala.\\nHave plenty of water, my lovely!\\r","msg_0589_T25R0601_00004":"Are you using the Berry Pots?\\rYou can pick any of the Berries you\\nhave planted.\\rDon’t forget to water them!","msg_0589_T25R0601_00005":"How...\\n...\\f...\\f...\\fcute!\\rWhere did you get that...\\noh-so-cute Pokémon?\\r","msg_0589_T25R0601_00006":"SHAYMIN, is it?\\nIt’s so cute!\\rI know!\\rLet me give it a flower!\\nI have just the one for it!\\r","msg_0589_T25R0601_00007":"The Gracidea will look perfect on\\nSHAYMIN!\\fPut it on SHAYMIN in the daylight.","msg_0589_T25R0601_00008":"Mulch!\\nAnyone want Mulch?\\rBerries love Mulch.\\nIt makes Berries grow faster!\\r","msg_0589_T25R0601_00009":"That {STRVAR_1 8, 0, 0} is a mix of\\nhigh-quality soil and Pokémon’s...\\fer...you know...\\rIt’s full of nutrients!\\nBerries will surely benefit from it.","msg_0589_T25R0601_00010":"Thank you.\\nPlease come again!","msg_0589_T25R0601_00011":"You bought the {STRVAR_1 8, 0, 0}.\\r","msg_0589_T25R0601_00012":"Ouch!\\nYour Bag is full!","msg_0589_T25R0601_00013":"Well... Excuse me, but\\nyou’re short of money."},"initTriggers":[{"var":"VAR_UNK_4082","value":1,"script":"_EV_scr_seq_T25R0601_003 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T25R0601_002 + 1"},"constants":{"_EV_scr_seq_T25R0601_000":0,"_EV_scr_seq_T25R0601_001":1,"_EV_scr_seq_T25R0601_002":2,"_EV_scr_seq_T25R0601_003":3,"obj_T25R0601_gswoman1":0,"obj_T25R0601_gsgirl1":1}}
