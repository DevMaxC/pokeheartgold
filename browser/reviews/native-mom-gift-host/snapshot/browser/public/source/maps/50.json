n have this TM.\\r","msg_0452_T02_00006":"TM85 contains Dream Eater...\\n...Zzzzz...","msg_0452_T02_00007":"I heard that there are many items on\\nthe ground in Viridian Forest.","msg_0452_T02_00008":"Viridian City\\nThe City of Evergreen","msg_0452_T02_00009":"Viridian City Pokémon Gym\\nLeader: ...\\fThe rest of the text is illegible...","msg_0452_T02_00010":"Welcome to Viridian City,\\nthe Gateway to Indigo Plateau!","msg_0452_T02_00011":"Trainer House\\nThe Club for Top Trainer Battles"},"initTriggers":[{"var":"VAR_UNK_4096","value":1,"script":"_EV_scr_seq_T02_011 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T02_008 + 1"},"constants":{"_EV_scr_seq_T02_000":0,"_EV_scr_seq_T02_001":1,"_EV_scr_seq_T02_002":2,"_EV_scr_seq_T02_003":3,"_EV_scr_seq_T02_004":4,"_EV_scr_seq_T02_005":5,"_EV_scr_seq_T02_006":6,"_EV_scr_seq_T02_007":7,"_EV_scr_seq_T02_008":8,"_EV_scr_seq_T02_009":9,"_EV_scr_seq_T02_010":10,"_EV_scr_seq_T02_011":11,"obj_T02_gsoldman1":0,"obj_T02_gsoldman1_2":1,"obj_T02_gsbigman":2,"obj_T02_gsboy1":3,"obj_T02_tree":4,"obj_T02_tree_2":5,"obj_T02_gsmiddleman1":6,"obj_T02_gsoldman1_3":7}}
