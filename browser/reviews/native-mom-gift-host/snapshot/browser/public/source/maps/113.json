ng with excitement.\\nI think something is about to happen!\\r","msg_0072_D24R0101_00007":"Ruins of Alph.\\rVisitors who are interested in\\narchaeology are welcome.","msg_0072_D24R0101_00008":"Ruins of Alph.\\rFeel free to explore the ruins and\\nbecome a fossil professor!","msg_0072_D24R0101_00009":"Ruins Research Center","msg_0072_D24R0101_00010":"This is a mysterious hall.\\nPlease watch your step."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_D24R0101_005 + 1","OnLoad":"_EV_scr_seq_D24R0101_006 + 1"},"constants":{"_EV_scr_seq_D24R0101_000":0,"_EV_scr_seq_D24R0101_001":1,"_EV_scr_seq_D24R0101_002":2,"_EV_scr_seq_D24R0101_003":3,"_EV_scr_seq_D24R0101_004":4,"_EV_scr_seq_D24R0101_005":5,"_EV_scr_seq_D24R0101_006":6,"_EV_scr_seq_D24R0101_007":7,"obj_D24R0101_mystery_2":0,"obj_D24R0101_monstarball":1,"obj_D24R0101_breakrock":2,"obj_D24R0101_breakrock_2":3,"obj_D24R0101_breakrock_3":4,"obj_D24R0101_breakrock_4":5,"obj_D24R0101_breakrock_5":6,"obj_D24R0101_monstarball_2":7,"obj_D24R0101_gsmiddleman1":8,"obj_D24R0101_suit":9}}
