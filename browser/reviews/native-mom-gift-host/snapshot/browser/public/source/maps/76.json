oteExclamationMark",[]],["EndMovement",[]],["WalkNormalWest",["5"]],["EndMovement",[]],["WalkNormalWest",["4"]],["EndMovement",[]],["WalkNormalWest",["3"]],["EndMovement",[]],["WalkNormalWest",["2"]],["EndMovement",[]],["WalkNormalWest",[]],["EndMovement",[]],["Delay1",[]],["EndMovement",[]],["WalkNormalEast",[]],["EndMovement",[]],["WalkNormalEast",["2"]],["EndMovement",[]],["WalkNormalEast",["3"]],["EndMovement",[]],["WalkNormalEast",["4"]],["EndMovement",[]],["WalkNormalNorth",[]],["EndMovement",[]],["LockDir",[]],["WalkNormalNorth",[]],["UnlockDir",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalEast",["5"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalEast",["4"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalEast",["3"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalEast",["2"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalEast",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalWest",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalWest",["2"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalWest",["3"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalSouth",[]],["WalkNormalWest",["4"]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["TrainerTipsEx",["2","msg_0581_T25_00036"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00037"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00038"]],["End",[]],["DirectionSignpostEx",["0","16","msg_0581_T25_00039"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00040"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00041"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00042"]],["End",[]],["TrainerTipsEx",["3","msg_0581_T25_00043"]],["End",[]],["TrainerTipsEx",["3","msg_0581_T25_00044"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00045"]],["End",[]],["TrainerTipsEx",["2","msg_0581_T25_00046"]],["End",[]]]},"messages":{"msg_0581_T25_00000":"They built the new Radio Tower to\\nreplace the old, creaky one.","msg_0581_T25_00001":"Have you visited the Pokéathlon Dome?\\nIt is a huge sports facility where\\fPokémon compete with each other.\\rIt was quite a sight!","msg_0581_T25_00002":"I know there’s a new Bike Shop,\\nbut I can’t find it anywhere.","msg_0581_T25_00003":"The fact that you have a Bike...\\nmeans you got it from a Bike Shop,\\fright?\\rAll right!\\nI can say that there is a Bike Shop\\fsomewhere in this city!","msg_0581_T25_00004":"Is that man in black dressed up\\nlike a Team Rocket member?\\fHow silly!","msg_0581_T25_00005":"Was that man in black really part\\nof Team Rocket?\\fI can’t believe it!","msg_0581_T25_00006":"The Radio Tower in Goldenrod City is\\na landmark.\\rThey’re running a promotional campaign\\nright now.\\rThey’ll modify your Pokégear so it can\\nalso serve as a radio.","msg_0581_T25_00007":"The Radio Tower in Goldenrod City is\\na landmark.\\rThey’re running a promotional campaign\\nright now.\\rThey’ll modify your Pokégear so it can\\nalso serve as a radio.\\rOh, your Pokégear works as a radio!","msg_0581_T25_00008":"E-he-he-he...\\nI got in trouble for playing in the\\fbasement of the department store.","msg_0581_T25_00009":"The man at that tent rates your\\nPokémon names.\\rHe can even rename your Pokémon.","msg_0581_T25_00010":"I think I’ll give my Pokémon cool\\nnicknames as a reward if they do\\fwell in the Pokéathlon.","msg_0581_T25_00011":"Whew! This is one big town.\\nI don’t know where anything is.","msg_0581_T25_00012":"I know that you can find the\\nPokéathlon Dome when you take\\fRoute 35 north and go past the\\fleft gate...\\rBut I seem to get lost every time\\nI come to this town...","msg_0581_T25_00013":"So this is the Radio Tower...\\r","msg_0581_T25_00014":"What do you want, you pest?\\nScram!\\r","msg_0581_T25_00015":"What are you doing?\\nGet to your position right away!\\r","msg_0581_T25_00016":"Pokémon? They’re nothing more than\\ntools for making money!","msg_0581_T25_00017":"We are on guard here.\\nDon’t you worry!","msg_0581_T25_00018":"Take over the Radio Tower...\\rWhat? It’s none of your business!","msg_0581_T25_00019":"You look awfully young...\\nAre you new?","msg_0581_T25_00020":"Hey, brat! You don’t belong here!\\fGet lost!","msg_0581_T25_00021":"Hey, hey!\\nI’ve got this covered!\\rWhy don’t you go to the Radio Tower?","msg_0581_T25_00022":"Friendship with Pokémon?\\rThat makes me laugh!","msg_0581_T25_00023":"Our dream will soon come true...\\nIt was such a long struggle...","msg_0581_T25_00024":"Who are you? A newcomer?\\rWe’ve run out of Team Rocket\\nuniforms.\\rOne of my guys is going to get more...\\rWhat’s taking him so long?\\rThe studio in the tunnel is just around\\nthe corner.","msg_0581_T25_00025":"For a young one like you to decide\\nto become a member of Team Rocket...\\fThat’s great, kiddo!","msg_0581_T25_00026":"Get out of my way!\\rWe, as Gym Trainers, will never allow\\nTeam Rocket to do nasty things here\\fin our city!","msg_0581_T25_00027":"Tee hee!\\rYou Gym Trainers can be a problem.\\nStay in the Gym and stay out of\\fthe way!","msg_0581_T25_00028":"The Gym Leader, Whitney, went flying by\\nsaying, “I have got to\\fget a Radio Card!”","msg_0581_T25_00029":"Wh-what are you trying to do?\\nCan’t you see this cool, pitch-black\\funiform I’m wearing?\\rYou’re not afraid of Team Rocket? Huh?","msg_0581_T25_00030":"You don’t appear scary enough to be a\\nTeam Rocket member in that uniform...\\fMake a scarier face and say, “Yeee!”\\rAll the while, clenching your teeth!","msg_0581_T25_00031":"Where do you think you’re going?\\nWe are right in the middle of\\fthe mission!","msg_0581_T25_00032":"Where do you think you are going?\\nThe Radio Tower is not here!","msg_0581_T25_00033":"The GTS lets you trade Pokémon\\nall over the world!\\r...Except that we have something\\nmore important to do right now!","msg_0581_T25_00034":"If you love to trade so much, wait until\\nthe Radio Tower mission is over.\\rThen you’ll have plenty of time!","msg_0581_T25_00035":"Slow down!\\rI’m the only one who was sent here.\\fDon’t give me any more trouble, OK?\\r","msg_0581_T25_00036":"Johto-Kanto Magnet Train Line\\nGoldenrod City Station","msg_0581_T25_00037":"Goldenrod City Radio Tower\\rA Network Providing Johto\\nwith Interesting Information","msg_0581_T25_00038":"Goldenrod City Pokémon Gym\\nLeader: Whitney\\fThe Incredibly Pretty Girl!","msg_0581_T25_00039":"Goldenrod City\\nA Happening Big City","msg_0581_T25_00040":"Bike Shop Goldenrod Branch\\nThe World is a Cycling Path!","msg_0581_T25_00041":"Goldenrod City Game Corner\\nA Safe and Sound Playground!","msg_0581_T25_00042":"Name Rater\\nGet Your Pokémon Nicknames Rated","msg_0581_T25_00043":"Watch Out!\\nGet Off Your Bike in the Tunnel","msg_0581_T25_00044":"Be Careful!\\nGet Off Your Bike in the Tunnel","msg_0581_T25_00045":"The Global Terminal\\rAn Amazing and Completely\\nGlobal Terminal!\\n","msg_0581_T25_00046":"Goldenrod Flower Shop\\rA Small Shop Providing\\nLots of Beauty"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T25_018 + 1"},"constants":{"_EV_scr_seq_T25_000":0,"_EV_scr_seq_T25_001":1,"_EV_scr_seq_T25_002":2,"_EV_scr_seq_T25_003":3,"_EV_scr_seq_T25_004":4,"_EV_scr_seq_T25_005":5,"_EV_scr_seq_T25_006":6,"_EV_scr_seq_T25_007":7,"_EV_scr_seq_T25_008":8,"_EV_scr_seq_T25_009":9,"_EV_scr_seq_T25_010":10,"_EV_scr_seq_T25_011":11,"_EV_scr_seq_T25_012":12,"_EV_scr_seq_T25_013":13,"_EV_scr_seq_T25_014":14,"_EV_scr_seq_T25_015":15,"_EV_scr_seq_T25_016":16,"_EV_scr_seq_T25_017":17,"_EV_scr_seq_T25_018":18,"_EV_scr_seq_T25_019":19,"_EV_scr_seq_T25_020":20,"_EV_scr_seq_T25_021":21,"_EV_scr_seq_T25_022":22,"_EV_scr_seq_T25_023":23,"_EV_scr_seq_T25_024":24,"_EV_scr_seq_T25_025":25,"_EV_scr_seq_T25_026":26,"_EV_scr_seq_T25