C"]],["WaitMovement",[]],["WaitFollowingPokemonMovement",[]],["ToggleFollowingPokemonMovement",["1"]],["FollowingPokemonMovement",["48"]],["Compare",["VAR_TEMP_x4000","5"]],["GoToIfEq",["_060C"]],["Compare",["VAR_TEMP_x4000","1"]],["GoToIfEq",["_05D2"]],["Compare",["VAR_TEMP_x4000","4"]],["GoToIfEq",["_05FF"]],["GetGameVersion",["VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","7"]],["GoToIfNe",["_05EC"]],["NPCMsg",["msg_0460_T03_00016"]],["GoTo",["_05EF"]],["NPCMsg",["msg_0460_T03_00017"]],["CloseMsg",[]],["SetVar",["VAR_UNK_4083","4"]],["GoTo",["_061F"]],["End",[]],["NPCMsg",["msg_0460_T03_00014"]],["CloseMsg",[]],["GoTo",["_061F"]],["End",[]],["NPCMsg",["msg_0460_T03_00018"]],["CloseMsg",[]],["SetVar",["VAR_UNK_4083","4"]],["GoTo",["_061F"]],["End",[]],["ApplyMovement",["obj_T03_daigo","_0478"]],["WaitMovement",[]],["NPCMsg",["msg_0460_T03_00015"]],["CloseMsg",[]],["ApplyMovement",["obj_T03_daigo","_0480"]],["WaitMovement",[]],["HidePerson",["obj_T03_daigo"]],["Compare",["VAR_UNK_4130","4"]],["CallIfEq",["_064D"]],["ReleaseAll",[]],["End",[]],["ClearFlag",["FLAG_HIDE_STEVEN_IN_HOUSE_AFTER_LATIS"]],["Return",[]],["SimpleNPCMsg",["msg_0460_T03_00019"]],["End",[]]]},"messages":{"msg_0460_T03_00000":"Have you visited Pewter Gym?\\rThe Gym Leader uses\\nRock-type Pokémon.","msg_0460_T03_00001":"At night, CLEFAIRY come out to play\\nat Mt. Moon.\\rBut not every night.","msg_0460_T03_00002":"Ah, you came all the way out here\\nfrom Johto?\\rThat brings back memories.\\rWhen I was young, I went to Johto\\nto train.\\rYou remind me so much of what I was\\nlike as a young man.\\rHere. I want you to have this item\\nI found in Johto.\\r","msg_0460_T03_00003":"","msg_0460_T03_00004":"","msg_0460_T03_00005":"Going to new, unknown places and\\nseeing new people...\\fThose are the joys of travel.","msg_0460_T03_00006":"Steven: It seems that LATIOS became\\nattracted to it in no time!\\r","msg_0460_T03_00007":"Steven: It seems that LATIAS became\\nattracted to it in no time!\\r","msg_0460_T03_00008":"I can feel that LATIOS is full of\\nfighting spirit!\\rI would love to challenge it,\\nbut I will let you go for it!","msg_0460_T03_00009":"I can feel that LATIAS is full of\\nfighting spirit!\\rI would love to challenge it,\\nbut I will let you go for it!","msg_0460_T03_00010":"LATIOS: Shuaaaann!\\r","msg_0460_T03_00011":"LATIAS: Huaaaaann!\\r","msg_0460_T03_00012":"LATIOS flew away to the distant sky...\\r","msg_0460_T03_00013":"LATIAS flew away to the distant sky...\\r","msg_0460_T03_00014":"Steven: Impressive!\\nIt was a great battle!\\rI don’t think you had to give\\neverything you’ve got,\\fand that scares me...\\r","msg_0460_T03_00015":"I’ve been away from the Hoenn\\nPokémon League for too long.\\rI’ll have to excuse myself.\\r..................\\rOh, I never got your name.\\f...But I won’t ask for it this time.\\rOur fun will have to wait for the\\nright time.\\r","msg_0460_T03_00016":"Steven: Impressive!\\nIt was a great battle!\\rLATIOS will be back once it recovers\\nto make amends for the defeat.\\r","msg_0460_T03_00017":"Steven: Impressive!\\nIt was a great battle!\\rLATIAS will be back once it recovers\\nto make amends for the defeat.\\r","msg_0460_T03_00018":"Steven: I see.\\nYou’d rather hide your true strength\\ffrom me. You have room to breathe,\\fand that scares me.\\r","msg_0460_T03_00019":"Steven: What? You are not scared,\\nare you? Don’t be reserved. Go for it.","msg_0460_T03_00020":"Pewter City\\nBetween Rugged Mountains","msg_0460_T03_00021":"Pewter City Pokémon Gym\\nLeader: Brock\\fThe Rock-Solid Pokémon Trainer","msg_0460_T03_00022":"Pewter Museum of Science","msg_0460_T03_00023":"Welcome to Pewter City!","msg_0460_T03_00024":"The door’s locked..."},"initTriggers":[{"var":"VAR_UNK_4083","value":2,"script":"_EV_scr_seq_T03_012 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T03_008 + 1","OnLoad":"_EV_scr_seq_T03_013 + 1","OnResume":"_EV_scr_seq_T03_011 + 1"},"constants":{"_EV_scr_seq_T03_000":0,"_EV_scr_seq