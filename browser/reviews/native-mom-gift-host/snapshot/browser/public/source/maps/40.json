ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["HasItem",["ITEM_SQUIRTBOTTLE","1","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_0530"]],["NPCMsg",["msg_0390_R36_00013"]],["GoTo",["_0533"]],["NPCMsg",["msg_0390_R36_00014"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["FaceNorth",[]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["GetItemQuantity",["ITEM_HM06","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_0572"]],["NPCMsg",["msg_0390_R36_00003"]],["GiveItemNoCheck",["ITEM_HM06","1"]],["NPCMsg",["msg_0390_R36_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0390_R36_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["CallStd",["std_bag_is_full"]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["GoToIfSet",["FLAG_HIDE_ROUTE_36_SUDOWOODO","_05AE"]],["NPCMsg",["msg_0390_R36_00007"]],["GoTo",["_05B1"]],["NPCMsg",["msg_0390_R36_00008"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["DirectionSignpostEx",["1","15","msg_0390_R36_00009"]],["End",[]],["TrainerTipsEx",["2","msg_0390_R36_00010"]],["End",[]],["TrainerTipsEx",["3","msg_0390_R36_00011"]],["End",[]],["TrainerTipsEx",["3","msg_0390_R36_00012"]],["End",[]]]},"messages":{"msg_0390_R36_00000":"There’s an odd tree!\\nUse the SquirtBottle? {YESNO 0}","msg_0390_R36_00001":"{STRVAR_1 3, 0, 0} used\\nthe SquirtBottle!\\r","msg_0390_R36_00002":"The odd tree doesn’t like the\\nSquirtBottle!\\rThe odd tree attacked!\\r","msg_0390_R36_00003":"Yo!\\rHaven’t you had trouble with a boulder\\nblocking your way? Of course you have!\\rFor people like you, there’s an HM\\nthat will come to your rescue!\\r","msg_0390_R36_00004":"Are you the one who took care of the\\nodd tree in the way?\\rYou’re quite the Trainer!\\nTake this!\\r","msg_0390_R36_00005":"It contains make-’em-faint Rock Smash.\\rYou can even use it to smash boulders\\nonce you’ve earned the Violet City\\fGym Badge!\\rBut beware!\\nHidden moves like this are hard for\\fyour Pokémon to forget once they’ve\\flearned them.\\rYou should think carefully which\\nPokémon should learn it.","msg_0390_R36_00006":"Your Bag is full!","msg_0390_R36_00007":"An odd tree is blocking the way\\nto Ecruteak City.\\rIt’s preventing me from shopping.\\fSomething should be done about it.","msg_0390_R36_00008":"The odd tree is gone, as if it just\\nwalked away...!\\fWhat? It was a Pokémon?\\rWell, finally I can go to Ecruteak\\nto do some shopping.\\rIf you follow the path from where the\\nodd tree was, you’ll reach\\fEcruteak City!","msg_0390_R36_00009":"Rt. 36\\nNorth to Ecruteak City","msg_0390_R36_00010":"Ruins of Alph\\nNorth Entrance","msg_0390_R36_00011":"Trainer Tips\\rThe same kind of Pokémon may look the\\nsame, but they can grow differently.\\rTheir strengths may look the same\\nin the beginning, but those strengths\\fcan change as they grow.","msg_0390_R36_00012":"Trainer Tips\\rThe move Dig can take you back to\\nthe entrance when you use it.\\rIf you want to explore a cave or\\nsomething similar, a Pokémon with\\fDig will be quite useful.","msg_0390_R36_00013":"I’m the Flower Shop’s Floria!\\rListen, listen! When I sprinkled water\\non that wiggly tree, it jumped right up!\\rIt just has to be a Pokémon.\\rI bet it would be shocked out of\\ndisguising itself if you soaked it!","msg_0390_R36_00014":"I’m the Flower Shop’s Floria!\\rListen, listen! When I sprinkled water\\non that wiggly tree, it jumped right up!\\fIt just has to be a Pokémon.\\fIf you soaked it...\\rOh, that’s the SquirtBottle!\\rSoak the tree for me!\\nI want to see what happens!","msg_0390_R36_00015":"That was fun!\\rI want to give you this\\nfor entertaining me!\\r","msg_0390_R36_00016":"With the Berry Pots, you can grow\\nany Berry from any region\\fwith no worries!\\r","msg_0390_R36_00017":"That’s right!\\nI’ll give you some Berries, too.\\rBerry Pots won’t do any good\\nwithout Berries.\\r","msg_0390_R36_00018":"You have to plant Berries in the soil.\\nYou should water them from time\\fto time. Then they’ll grow strong!\\rI have to go back to Goldenrod.\\fAre you heading for Ecruteak?\\rThen you should go north here.\\nSee you around!\\r"},"initTriggers":[],"initScripts":{"OnLoad":"_EV_scr_seq_R36_010 + 1","OnTransition":"_EV_scr_seq_R36_002 + 1"},"constants":{"_EV_scr_seq_R36_000":0,"_EV_scr_seq_R36_001":1,"_EV_scr_seq_R36_002":2,"_EV_scr_seq_R36_003":3,"_EV_scr_seq_R36_004":4,"_EV_scr_seq_R36_005":5,"_EV_scr_seq_R36_006":6,"_EV_scr_seq_R36_007":7,"_EV_scr_seq_R36_008":8,"_EV_scr_seq_R36_009":9,"_EV_scr_seq_R36_010":10,"obj_R36_gsbigman":0,"obj_R36_gsgirl1":1,"obj_R36_mystery_2":2,"obj_R36_gsboy1":3,"obj_R36_usokky":4,"obj_R36_gsgirl1_2":5,"obj_R36_gsboy1_2":6,"obj_R36_bonguri":7,"obj_R36_monstarball":8}}
