Button",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00024"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00025"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00026"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00027"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00028"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0464_T03R0101_00029"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0464_T03R0101_00000":"Welcome!\\rJust to let you know, all the large\\nspecimens have been taken to the\\fother museums for display.\\rSo for now, admission is free\\nof charge!\\rPlease go ahead.","msg_0464_T03R0101_00001":"Did you know that you can\\nextract Pokémon from Fossils?\\rIf you ever need to, let me take care\\nof it for you!\\r","msg_0464_T03R0101_00002":"Please come by again if you ever want to\\nextract Pokémon.","msg_0464_T03R0101_00003":"I’ll extract it for you.\\rCome back after a while!","msg_0464_T03R0101_00004":"Hi, there!\\rI have extracted a Pokémon from\\nyour Fossil!\\rIt is called {STRVAR_1 0, 0, 0}.\\nTake good care of it!\\r","msg_0464_T03R0101_00005":"Oops!\\nYour party seems full.\\rWhy don’t you go to the PC\\nto make room for it?","msg_0464_T03R0101_00006":"Hey!\\nYou don’t have any Fossils.\\rI heard that sometimes you find Fossils\\nwhen you smash rocks at the\\fRuins of Alph and other places.","msg_0464_T03R0101_00007":"Do you want to extract a Pokémon\\nfrom the {STRVAR_1 8, 0, 0}? {YESNO 0}","msg_0464_T03R0101_00008":"{STRVAR_1 3, 0, 0} received\\nthe {STRVAR_1 0, 1, 0}!","msg_0464_T03R0101_00009":"Would you like to give a nickname\\nto the {STRVAR_1 0, 1, 0} you received? {YESNO 0}","msg_0464_T03R0101_00010":"They say that meteorites struck\\nsomewhere near Pewter City.\\rWe would love to display them here\\nin our museum, but...\\rThese meteorites are said to\\nemit strange energy and cannot\\fbe carried away...","msg_0464_T03R0101_00011":"There are two places that I love!\\nOne is the Ruins of Alph in Johto...\\rThe other is the Pewter Museum!\\nIt’s so quiet and makes me feel calm.\\rDo you feel its admirable history\\nsilently creeping up on you?","msg_0464_T03R0101_00012":"I should be grateful for my long life.\\rNever did I think I would get to\\nsee the bones of a dragon!","msg_0464_T03R0101_00013":"..................\\rAll those shining stars at night are\\nthe stones I’ll never get to know...","msg_0464_T03R0101_00014":"Steven: People who dedicate themselves\\nto what they believe stand out in\\fa crowd.\\rBut, my passion is no less than yours.\\r","msg_0464_T03R0101_00015":"Wow!\\nThe thing you have...\\r","msg_0464_T03R0101_00016":"This stone is...so mysterious!\\rSomething seems to be shining inside...\\nThe stone is modest...yet hiding\\fsomething wonderful!\\rYou should have it studied\\nby experts.\\r","msg_0464_T03R0101_00017":"{STRVAR_1 3, 0, 0} handed the Enigma Stone\\nto the researcher!\\r","msg_0464_T03R0101_00018":"I will check it.\\nCan you hold on a second?\\r","msg_0464_T03R0101_00019":"Thank you for your patience!\\nIt took me a little while,\\fbut I have confirmed it!\\rThis is an Orb that contains\\nwhat is called {COLOR 2}Soul Dew{COLOR 0}.\\r","msg_0464_T03R0101_00020":"Soul Dew is no ordinary thing\\nand is rarely seen.\\fI would love to study it closely.","msg_0464_T03R0101_00021":"Steven: Soul Dew is said to be the\\nsolidified spirits of LATIAS and LATIOS.\\rIt has the power to bring out the\\ntrue potential of LATIAS and LATIOS.\\rThe spirits of these Pokémon and\\nSoul Dew are said to call out to\\feach other...\\rThe only thing that puzzles me is\\nthe place Soul Dew was found.\\fWhy Kanto?\\r","msg_0464_T03R0101_00022":"Stringy and winding...\\nIs this a plant Fossil?","msg_0464_T03R0101_00023":"It’s a curving, sharp Fossil.\\nThis may be...\\fthe Fossil of a carnivore?","msg_0464_T03R0101_00024":"It’s flat and looks hard.\\nThis may be...\\fa part that protected its body?","msg_0464_T03R0101_00025":"Solid amber tree sap has\\nsomething inside!\\rIf you can take it out, you can\\nextract a Pokémon from\\fancient times...?","msg_0464_T03R0101_00026":"Small bones are put together to form\\nsome kind of a Pokémon!","msg_0464_T03R0101_00027":"The rough stone has words etched\\ninto it...\\r“This is an unidentified object\\nfound at Mt. Moon. It is possibly a\\fmoon rock.”","msg_0464_T03R0101_00028":"There are thick and well-read books!\\r“The Principles of Fossil Extraction”\\f“Archaeology Manual”\\f“Lost Pokémon”\\f“Pokémon Ancestors”\\f“Friendships of Trainers and Pokémon”\\f“Caring at the Loamy Layer of Kanto”","msg_0464_T03R0101_00029":"Our museum mainly displays\\nFossils and specimens from Kanto.\\rPlease enjoy the extinct Pokémon\\nthrough their remembrance, and\\fstep through time to the ancient world."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T03R0101_014 + 1","OnLoad":"_EV_scr_seq_T03R0101_017 + 1","OnResume":"_EV_scr_seq_T03R0101_018 + 1"},"constants":{"_EV_scr_seq_T03R0101_000":0,"_EV_scr_seq_T03R0101_001":1,"_EV_scr_seq_T03R0101_002":2,"_EV_scr_seq_T03R0101_003":3,"_EV_scr_seq_T03R0101_004":4,"_EV_scr_seq_T03R0101_005":5,"_EV_scr_seq_T03R0101_006":6,"_EV_scr_seq_T03R0101_007":7,"_EV_scr_seq_T03R0101_008":8,"_EV_scr_seq_T03R0101_009":9,"_EV_scr_seq_T03R0101_010":10,"_EV_scr_seq_T03R0101_011":11,"_EV_scr_seq_T03R0101_012":12,"_EV_scr_seq_T03R0101_013":13,"_EV_scr_seq_T03R0101_014":14,"_EV_scr_seq_T03R0101_015":15,"_EV_scr_seq_T03R0101_016":16,"_EV_scr_seq_T03R0101_017":17,"_EV_scr_seq_T03R0101_018":18,"_EV_scr_seq_T03R0101_019":19,"obj_T03R0101_gsassistantm":0,"obj_T03R0101_gswoman6":1,"obj_T03R0101_gsoldman1":2,"obj_T03R0101_mania":3,"obj_T03R0101_gsassistantm_2":4,"obj_T03R0101_gsmiddleman1":5,"obj_T03R0101_daigo":6,"obj_T03R0101_daigo_2":7}}
