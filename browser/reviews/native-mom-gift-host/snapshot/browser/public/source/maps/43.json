eAll",[]],["End",[]],["NPCMsg",["msg_0396_R39_00013"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0396_R39_00014"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["DirectionSignpostEx",["1","21","msg_0396_R39_00000"]],["End",[]],["TrainerTipsEx",["2","msg_0396_R39_00001"]],["End",[]],["TrainerTipsEx",["3","msg_0396_R39_00002"]],["End",[]]]},"messages":{"msg_0396_R39_00000":"Rt. 39\\nSouth to Olivine City","msg_0396_R39_00001":"Moomoo Farm\\nEnjoy Our Fresh and Tasty Milk","msg_0396_R39_00002":"Trainer Tips\\rUse Headbutt on trees to shake\\nPokémon out.\\rDifferent kinds of Pokémon drop out\\nof trees.\\rUse Headbutt on any tree you see!","msg_0396_R39_00003":"MILTANK: Mooo!","msg_0396_R39_00004":"Baoba: ...Ohh!\\nWhat you are holding is...\\fwhat they call...a Pokédex!\\fHaven’t seen one of those in ages.\\rMy name is Baoba!\\rI used to run a Safari Zone in\\nFuchsia City, but it was becoming\\fout of date with new entertainment\\foptions coming out.\\rI decided to go overseas to learn\\nthe newest technology and open a\\fstate-of-the-art Safari Zone\\fin Cianwood.\\rIt may be more than a coincidence\\nthat we are chatting.\\rWhy don’t we register each other’s\\nnumbers in the Pokégear?\\rI can give you a call once the Safari\\nZone is open before I call anyone else!\\r","msg_0396_R39_00005":"Do you want to register? {YESNO 0}","msg_0396_R39_00006":"That’s the way!\\r","msg_0396_R39_00007":"Huh, I didn’t expect you to say no.\\nYou can get hard-to-find Pokémon, too.\\rYou’ll be able to make good progress\\nwith your Pokédex, too...\\r","msg_0396_R39_00008":"{STRVAR_1 3, 0, 0} registered Baoba\\nin the Pokégear!","msg_0396_R39_00009":"Baoba: I’ll let you know over the\\nPokégear once it’s ready!\\r","msg_0396_R39_00010":"Lt. Surge: Hey, you!\\rDon’t you want a good memory of us\\ntogether? How about taking a\\fpicture with me? {YESNO 0}","msg_0396_R39_00011":"Lt. Surge: OK! OK!\\rShow me a very good smile!\\r","msg_0396_R39_00012":"Lt. Surge: Wow!\\nThis turned out to be a really\\fgood one!\\rWe root for Route 39!","msg_0396_R39_00013":"Lt. Surge: That’s OK...\\rLet me know if you change your mind.","msg_0396_R39_00014":"Your Photo Album is full.\\rAccess your PC to delete some pictures\\nbefore you come back."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_R39_001 + 1"},"constants":{"_EV_scr_seq_R39_000":0,"_EV_scr_seq_R39_001":1,"_EV_scr_seq_R39_002":2,"_EV_scr_seq_R39_003":3,"_EV_scr_seq_R39_004":4,"_EV_scr_seq_R39_005":5,"_EV_scr_seq_R39_006":6,"_EV_scr_seq_R39_007":7,"obj_R39_seaman_2":0,"obj_R39_gsmiddleman1":1,"obj_R39_middlewoman1_2":2,"obj_R39_mystery_2":3,"obj_R39_tsure_poke_static_miltank":4,"obj_R39_tsure_poke_static_miltank_2":5,"obj_R39_tsure_poke_static_miltank_3":6,"obj_R39_tsure_poke_static_miltank_4":7,"obj_R39_gsgentleman":8,"obj_R39_bonguri":9,"obj_R39_monstarball":10,"obj_R39_gsmiddleman1_2":11,"obj_R39_gsleader9":12}}
