_SPECIAL_RESULT","1"]],["GoToIfEq",["_0276"]],["NPCMsg",["msg_0503_T07R0203_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GetItemQuantity",["ITEM_GB_SOUNDS","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_02A7"]],["NPCMsg",["msg_0503_T07R0203_00008"]],["GiveItemNoCheck",["ITEM_GB_SOUNDS","1"]],["NPCMsg",["msg_0503_T07R0203_00010"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0503_T07R0203_00011"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0503_T07R0203_00004"]],["End",[]],["SimpleNPCMsg",["msg_0503_T07R0203_00005"]],["End",[]],["SimpleNPCMsg",["msg_0503_T07R0203_00006"]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0503_T07R0203_00016"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0503_T07R0203_00017"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0503_T07R0203_00018"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0503_T07R0203_00019"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0503_T07R0203_00020"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0503_T07R0203_00021"]],["End",[]]]},"messages":{"msg_0503_T07R0203_00000":"I’m the Game Director!\\rFilling up your Pokédex is tough,\\nbut don’t give up!\\rYou can do it! Seriously!","msg_0503_T07R0203_00001":"Wow, you did it!\\nYou have filled up the\\fJohto Pokédex!\\rImpressive! I’m amazed!\\nI will reward you for that!\\fSeriously!\\r","msg_0503_T07R0203_00002":"Wow! Excellent!\\nYou completed your Pokédex!\\fCongratulations!\\rYou must be the genius of the century!\\nSeriously!\\rGame Freak will give you an award\\nand prove that it’s the truth!\\r","msg_0503_T07R0203_00003":"I bet it was a long way to complete\\nthe Pokédex.\\rRemember, the most precious thing of\\nall was the time you’ve worked hard\\fgoing everywhere to complete\\fthe Pokédex.\\rI just said something deep! Seriously!","msg_0503_T07R0203_00004":"I am the Graphic Designer!\\nI am a skilled dot artist!","msg_0503_T07R0203_00005":"I am the Programmer!\\rI control the world of games\\nwith my fingertip!","msg_0503_T07R0203_00006":"I am the Planner!\\nI come up with great ideas!\\rThis place you’re standing\\nhere is no exception! Hahaha!","msg_0503_T07R0203_00007":"I am the Sound Designer!\\nI compose music.\\rI’ll give you something cool if you\\nmanage to collect all eight\\fKanto Badges and show them to me.","msg_0503_T07R0203_00008":"I am the Sound Designer!\\nI compose music.\\rWow, you have collected\\nall the Kanto Badges already!\\fThat’s great!\\rI’ll give you something cool\\nfor that.\\r","msg_0503_T07R0203_00009":"","msg_0503_T07R0203_00010":"GB is a rectangular thing with a\\nblack-and-white screen that you used\\fto play the original Pokémon...\\fOh, wait! That was a Game Boy!\\rTurn it on and GB Sounds will let you\\nhear some nostalgic sounds.\\rIt’s a gadget full of wonder!\\nTry it at various places!\\rThere are some places you won’t\\nhear classic music...\\rBut that’s life!","msg_0503_T07R0203_00011":"I find GB Sounds to be incredible!\\nEven places that were built recently\\fhave nice, classic music.\\rBehold the full extent of my passion!\\r...Did I say “behold”? What am\\nI saying?\\rAnyway, try it at various places!\\rThere are some places you won’t\\nhear classic music...\\rBut that’s life!","msg_0503_T07R0203_00012":"Lyra: Hi, {STRVAR_1 3, 0, 0}!\\r","msg_0503_T07R0203_00013":"Ethan: Hey, {STRVAR_1 3, 0, 0}!\\r","msg_0503_T07R0203_00014":"Lyra: Guess what?\\rThat Sound Designer over there\\nshowed me something cool.\\rIt’s a hi-tech, retro machine to\\nlisten to music from the Game Boy!\\rHe said he’ll give it to anyone\\nwho has collected all of the\\fKanto Badges.\\rWhy don’t you go for it, {STRVAR_1 3, 0, 0}?\\nSee ya!\\r","msg_0503_T07R0203_00015":"Ethan: Guess what?\\rThat Sound Designer over there\\nshowed me something cool.\\rIt’s a hi-tech, retro machine to\\nlisten to music from the Game Boy!\\rHe said he’ll give it to anyone\\nwho has collected all of the\\fKanto Badges.\\rWhy don’t you go for it, {STRVAR_1 3, 0, 0}?\\nSee ya!\\r","msg_0503_T07R0203_00016":"Game Freak\\nDevelopment Room","msg_0503_T07R0203_00017":"This elevator goes straight between\\nthe second floor and the roof.","msg_0503_T07R0203_00018":"It’s the game program.\\rMessing with it could ruin it.\\nYou cannot touch it!","msg_0503_T07R0203_00019":"Pokémon stickers are everywhere\\non the desk!","msg_0503_T07R0203_00020":"There are many photo collections\\nand books about myths!","msg_0503_T07R0203_00021":"What do you think?\\rI am the President here.\\rWe are remaking an old game,\\nbut this is quite a challenge.\\rOld fans would not want us to mess\\nwith their good memories...\\fbut there is no point in just\\fredoing the same thing, right?\\rWe are working toward something\\nthat brings back memories,\\fyet is also completely new!\\rI’ve been in this business for 20 years\\nnow, but creating a game is always a\\frewarding challenge!"},"initTriggers":[{"var":"VAR_UNK_412C","value":0,"script":"_EV_scr_seq_T07R0203_010 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T07R0203_008 + 1","OnResume":"_EV_scr_seq_T07R0203_011 + 1"},"constants":{"_EV_scr_seq_T07R0203_000":0,"_EV_scr_seq_T07R0203_001":1,"_EV_scr_seq_T07R0203_002":2,"_EV_scr_seq_T07R0203_003":3,"_EV_scr_seq_T07R0203_004":4,"_EV_scr_seq_T07R0203_005":5,"_EV_scr_seq_T07R0203_006":6,"_EV_scr_seq_T07R0203_007":7,"_EV_scr_seq_T07R0203_008":8,"_EV_scr_seq_T07R0203_009":9,"_EV_scr_seq_T07R0203_010":10,"_EV_scr_seq_T07R0203_011":11,"_EV_scr_seq_T07R0203_012":12,"_EV_scr_seq_T07R0203_013":13,"obj_T07R0