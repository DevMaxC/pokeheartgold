hiver.\\fI can’t stop them!\\r","msg_0076_D24R0205_00009":"Oh, are you all right?\\nYou disappeared right in front of me.\\fI was so surprised!\\r","msg_0076_D24R0205_00010":"I see.\\rThe power of ARCEUS and UNOWN affected\\neach other to create a huge energy,\\fwhich sent you to the Sinjoh Ruins...?\\rUNOWN, the Ruins of Alph, and ARCEUS...\\fThe mystery deepens...\\rIt has made me even more inquisitive!\\rI will one day solve all the mysteries!\\r"},"initTriggers":[{"var":"VAR_UNK_40CE","value":1,"script":"_EV_scr_seq_D24R0205_000 + 1"},{"var":"VAR_SCENE_SINJOH_MYSTRI_ROOM","value":2,"script":"_EV_scr_seq_D24R0205_006 + 1"},{"var":"VAR_SCENE_SINJOH_MYSTRI_ROOM","value":9,"script":"_EV_scr_seq_D24R0205_007 + 1"},{"var":"VAR_SCENE_SINJOH_MYSTRI_ROOM","value":11,"script":"_EV_scr_seq_D24R0205_009 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_D24R0205_001 + 1","OnTransition":"_EV_scr_seq_D24R0205_008 + 1"},"constants":{"_EV_scr_seq_D24R0205_000":0,"_EV_scr_seq_D24R0205_001":1,"_EV_scr_seq_D24R0205_002":2,"_EV_scr_seq_D24R0205_003":3,"_EV_scr_seq_D24R0205_004":4,"_EV_scr_seq_D24R0205_005":5,"_EV_scr_seq_D24R0205_006":6,"_EV_scr_seq_D24R0205_007":7,"_EV_scr_seq_D24R0205_008":8,"_EV_scr_seq_D24R0205_009":9,"obj_D24R0205_gswoman1":0,"obj_D24R0205_gsbigman":1,"obj_D24R0205_gsoldman1":2,"obj_D24R0205_gsassistantm":3,"obj_D24R0205_gsassistantm_2":4,"obj_D24R0205_gsassistantm_3":5,"obj_D24R0205_gsassistantm_4":6,"obj_D24R0205_suit":7}}
