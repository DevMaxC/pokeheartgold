3":"Your Photo Album is full.\\rAccess your PC to delete\\nsome pictures."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T26R0701_004 + 1"},"constants":{"_EV_scr_seq_T26R0701_000":0,"_EV_scr_seq_T26R0701_001":1,"_EV_scr_seq_T26R0701_002":2,"_EV_scr_seq_T26R0701_003":3,"_EV_scr_seq_T26R0701_004":4,"_EV_scr_seq_T26R0701_005":5,"_EV_scr_seq_T26R0701_006":6,"obj_T26R0701_fishing_2":0,"obj_T26R0701_seaman_2":1,"obj_T26R0701_seaman_2_2":2,"obj_T26R0701_gsmiddleman1":3,"obj_T26R0701_gsleader6":4,"obj_T26R0701_seaman_2_3":5}}
