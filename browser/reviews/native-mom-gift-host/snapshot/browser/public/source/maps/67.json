st",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["Delay8",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalEast",[]],["WalkNormalNorth",[]],["FaceSouth",[]],["EndMovement",[]],["TrainerTipsEx",["2","msg_0550_T21_00024"]],["End",[]],["DirectionSignpostEx",["0","12","msg_0550_T21_00023"]],["End",[]],["SimpleNPCMsg",["msg_0550_T21_00019"]],["End",[]],["SimpleNPCMsg",["msg_0550_T21_00017"]],["End",[]]]},"messages":{"msg_0550_T21_00000":"You’re a rookie Trainer, aren’t you?\\nI can tell!\\rThat’s OK! Everyone is a rookie\\nat some point!\\rIf you’d like, I can teach you a\\nfew things.\\fOK, then! Follow me!\\r","msg_0550_T21_00001":"Ohh... I’m sorry.\\nI forgot that you weren’t wearing the\\fRunning Shoes!\\rI’ll try to go as slow as possible, so\\ntry keeping up!\\r","msg_0550_T21_00002":"This is a Pokémon Center. They heal\\nyour Pokémon in no time at all.\\rYou’ll be relying on them a lot, so\\nyou better learn about them.\\r","msg_0550_T21_00003":"This is a Pokémon Mart.\\nThey sell Poké Balls for catching wild\\fPokémon and other useful items.\\r","msg_0550_T21_00004":"Route 30 is out this way.\\rTrainers will be battling their\\nPokémon there.\\rIf you go a little farther,\\nyou’ll see Mr. Pokémon’s House.\\r","msg_0550_T21_00005":"This is the sea, as you can see.\\rSome Pokémon are found only in water.\\r","msg_0550_T21_00006":"Here...\\nIt’s my house!\\rFor your effort keeping up with me,\\nI’ll give you my Running Shoes!\\fThey’re still warm!\\r...\\n...\\rGot you, didn’t I?\\nDon’t worry, these are brand new!\\r","msg_0550_T21_00007":"{STRVAR_1 3, 0, 0} received\\nthe Running Shoes from the Guide Gent!","msg_0550_T21_00008":"The instructions read,\\n“Touch the Sprint Button on the\\fTouch Screen to sprint.”\\rIt also says,\\n“Hold the B Button down to sprint.”\\r","msg_0550_T21_00009":"...Hffp... Hffp...\\nI made it...\\rI forgot about one thing.\\nThis is another token from me!\\rTake it.\\r","msg_0550_T21_00010":"The Guide Gent loaded the Map Card\\non {STRVAR_1 3, 0, 0}’s Pokégear!","msg_0550_T21_00011":"{STRVAR_1 3, 0, 0}’s Pokégear\\ncan now show the Town Map!\\r","msg_0550_T21_00012":"Select the Pokégear on the\\nTouch Screen and then select\\fthe Town Map icon.\\rYou’ll see the map of the region\\nyou’re currently in!\\rThe Pokégear becomes more useful as\\nyou add Cards.\\rI wish you luck on your journey!\\r","msg_0550_T21_00013":"...\\rYou got a Pokémon at the Lab.\\nWhat a waste.\\rThat’s a Pokémon that’s too good for\\na wimp like you.\\r...\\nDon’t you get what I’m saying?\\rWell, I too have a good Pokémon.\\nI’ll show you what I mean!\\r","msg_0550_T21_00014":"...\\rDo you want to know who I am?\\n...\\rI’m going to be the world’s greatest\\nPokémon Trainer.\\r","msg_0550_T21_00015":"Give it back!\\nThat’s my Trainer Card!\\rOh no!\\nYou saw my name...\\r","msg_0550_T21_00016":"Did you talk to the old man by the\\nPokémon Center?\\rHe’ll put a Map of Johto on your\\nPokégear.","msg_0550_T21_00017":"When you’re with Pokémon,\\ngoing anywhere is fun.","msg_0550_T21_00018":"Mr. Pokémon’s house is still farther\\nup ahead.\\rYou could use the Running Shoes if\\nyou had a pair.\\rBut beware of wild Pokémon and\\nTrainers!\\rWhen you run, the noise will\\nattract them.","msg_0550_T21_00019":"I battled the Trainers on the road.\\nMy Pokémon lost.\\rThey’re a mess! I must take them to\\na Pokémon Center.","msg_0550_T21_00020":"A Pokémon I caught had an item.\\nI think it’s Mystic Water.\\rI don’t need it, so do you want it?\\r","msg_0550_T21_00021":"Back to fishing for me, then.","msg_0550_T21_00022":"You don’t have room for this.","msg_0550_T21_00023":"Cherrygrove City\\nThe City of Fragrant Flowers","msg_0550_T21_00024":"Guide Gent’s House\\nFull-of-Energy, High-Speed Old Man"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T21_010 + 1"},"constants":{"_EV_scr_seq_T21_000":0,"_EV_scr_seq_T21_001":1,"_EV_scr_seq_T21_002":2,"_EV_scr_seq_T21_003":3,"_EV_scr_seq_T21_004":4,"_EV_scr_seq_T21_005":5,"_EV_scr_seq_T21_006":6,"_EV_scr_seq_T21_007":7,"_EV_scr_seq_T21_008":8,"_EV_scr_seq_T21_009":9,"_EV_scr_seq_T21_010":10,"obj_T21_gsoldman1":0,"obj_T21_gsboy1":1,"obj_T21_gswoman1":2,"obj_T21_gsbigman":3,"obj_T21_gsrivel":4,"obj_T21_gsmiddleman1":5}}
