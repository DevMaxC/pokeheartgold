t",["48"]],["FollowMonIsActive",["VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfNe",["_0664"]],["ApplyMovement",["obj_partner_poke","_0720"]],["WaitMovement",[]],["SetFlag",["FLAG_UNK_189"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["CameronPhoto",["46"]],["LockAll",[]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ClearFlag",["FLAG_UNK_189"]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","2"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","5"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GetStdMsgNaix",["2","VAR_SPECIAL_RESULT"]],["MsgBoxExtern",["VAR_SPECIAL_RESULT","3"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["WalkNormalEast",[]],["WalkNormalNorth",["2"]],["WalkNormalWest",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["WalkNormalWest",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["WalkNormalEast",[]],["WalkNormalNorth",["3"]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["Delay8",[]],["WalkOnSpotNormalNorth",[]],["EndMovement",[]],["WalkNormalEast",[]],["WalkNormalNorth",[]],["FaceSouth",[]],["EndMovement",[]]]},"messages":{"msg_0130_D44R0103_00000":"Hm... Good to see you here.\\fNo need to explain why you came.\\rClair sent you here, didn’t she?\\fThat girl is a handful...\\rI am sorry, but I must test you.\\rNot to worry, you are to answer only\\na few questions.\\fReady?\\r","msg_0130_D44R0103_00001":"What are Pokémon to you? {YESNO 0}","msg_0130_D44R0103_00002":"What helps you to win battles? {YESNO 0}","msg_0130_D44R0103_00003":"What kind of Trainer do you\\nwish to battle? {YESNO 0}","msg_0130_D44R0103_00004":"What is most important for\\nraising Pokémon? {YESNO 0}","msg_0130_D44R0103_00005":"Strong Pokémon. Weak Pokémon.\\nWhich is more important? {YESNO 0}","msg_0130_D44R0103_00006":"Hm... I see...\\nYou care deeply for Pokémon.\\rVery commendable.\\fThat conviction is what is important!\\r{STRVAR_1 3, 0, 0}, don’t lose that belief.\\rIt will see you through at the\\nPokémon League.\\r","msg_0130_D44R0103_00007":"Hah? I didn’t quite catch that...\\r","msg_0130_D44R0103_00008":"What was it you said?","msg_0130_D44R0103_00009":"Oh, I understand...\\r","msg_0130_D44R0103_00010":"So how did it go?\\rI guess there’s no point in asking.\\nYou did fail?\\f...\\f...What? You passed?\\r","msg_0130_D44R0103_00011":"{SIZE 200}That can’t be!{SIZE 100}\\r","msg_0130_D44R0103_00012":"You’re lying!\\nEven I haven’t been approved!\\r","msg_0130_D44R0103_00013":"Clair!\\rThis child is impeccable,\\nin skill and spirit!\\rAdmit defeat and confer the\\nRising Badge!\\r...Or must I inform Lance of this?\\r","msg_0130_D44R0103_00014":"I... I understand...\\r","msg_0130_D44R0103_00015":"Here, this is the Rising Badge...\\nHurry up! Take it!\\r","msg_0130_D44R0103_00016":"{STRVAR_1 3, 0, 0} received\\nthe Rising Badge from Clair!","msg_0130_D44R0103_00017":"The Rising Badge will enable your\\nPokémon to use the move for\\fclimbing waterfalls.\\rAlso, all Pokémon will know you as\\na Trainer and obey your every\\fcommand without question.\\r","msg_0130_D44R0103_00018":"Clair...\\rReflect upon what it is that you\\nlack and this child has.\\r","msg_0130_D44R0103_00019":"...\\n...\\r","msg_0130_D44R0103_00020":"By the way...\\nHave you heard of LUGIA?\\rIt is a Pokémon said to have lived\\naround Whirl Islands once...\\f...Never mind.\\rJust mad words of the old.\\n","msg_0130_D44R0103_00021":"By the way...\\nHave you heard of LUGIA?\\fEr...\\rBetween Olivine and Cianwood are\\nislands called Whirl Islands.\\rThere is a huge waterfall deep in the\\ncave there. It is said that LUGIA\\rrests in the deep end of the\\nwaterfall basin...\\rYou need a Silver Wing to reach the\\nwaterfall basin, I’ve heard...","msg_0130_D44R0103_00022":"There is a huge waterfall deep in the\\ncave there. It is said that LUGIA\\rrests in the deep end of the\\nwaterfall basin...\\rYou need a Silver Wing to reach the\\nwaterfall basin, I’ve heard...","msg_0130_D44R0103_00023":"Come again, if you so desire.","msg_0130_D44R0103_00024":"It’s been quite some time since a\\nTrainer has gained our Master’s\\frare approval.\\rIn fact, not since Master Lance.","msg_0130_D44R0103_00025":"You know young Master Lance?\\rHe looks so much like our Master\\ndid in his youth.\\fIt’s in their blood.","msg_0130_D44R0103_00026":"Hm... Good to see you here.\\rYour arrival is most fortunate.\\nI have something for you.\\rTake this DRATINI as proof that I\\nnow know your worth.\\r","msg_0130_D44R0103_00027":"{STRVAR_1 3, 0, 0} received\\nDRATINI from the Master!","msg_0130_D44R0103_00028":"Hm? Your party is full.","msg_0130_D44R0103_00029":"Dragon Pokémon are symbolic of\\nour clan.\\rYou have shown that you can be\\nentrusted with one.","msg_0130_D44R0103_00030":"Clair appears to have learned an\\ninvaluable lesson from you.\\rI thank you as her grandfather.","msg_0130_D44R0103_00031":"A boy close to your age is in\\ntraining here.\\rHe is much like Clair when she was\\nyounger. It is a little worrisome...","msg_0130_D44R0103_00032":"Give a nickname to the\\nDRATINI you received? {YESNO 0}"},"initTriggers":[{"var":"VAR_UNK_40C3","value":0,"script":"_EV_scr_seq_D44R0103_003 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_D44R0103_004 + 1"},"constants":{"_EV_scr_seq_D44R0103_000":0,"_EV_scr_seq_D44R0103_001":1,"_EV_scr_seq_D44R0103_002":2,"_EV_scr_seq_D44R0103_003":3,"_EV_scr_seq_D44R0103_004":4,"_EV_scr_seq_D44R0103_005":5,"obj_D44R0103_chourou":0,"obj_D44R0103_gsoldman1":1,"obj_D44R0103_gsoldman1_2":2,"obj_D44R0103_gsleader8":3,"obj_D44R0103_gsmiddleman1":4}}
