[]],["DirectionSignpostEx",["0","13","msg_0556_T22_00009"]],["End",[]],["TrainerTipsEx",["2","msg_0556_T22_00010"]],["End",[]],["TrainerTipsEx",["2","msg_0556_T22_00011"]],["End",[]],["SimpleNPCMsg",["msg_0556_T22_00005"]],["End",[]],["SimpleNPCMsg",["msg_0556_T22_00006"]],["End",[]],["SimpleNPCMsg",["msg_0556_T22_00007"]],["End",[]],["SimpleNPCMsg",["msg_0556_T22_00008"]],["End",[]]]},"messages":{"msg_0556_T22_00000":"Hello, {STRVAR_1 3, 0, 0}? We discovered\\nsomething about the Egg!\\rMy assistant is at the Pokémon Center\\nin Violet City.\\fCould you talk to him?","msg_0556_T22_00001":"Bonjour!\\nYou are Trainer?\\rBattle Gym Leader, win you did? {YESNO 0}","msg_0556_T22_00002":"Ooh, la la!\\nVery indeed nice!","msg_0556_T22_00003":"Is that so? Then study shall you!\\fFollow me!\\r","msg_0556_T22_00004":"Here, teacher I am.\\nGood it is you study here!\\r","msg_0556_T22_00005":"There have been reports of Ghost-type\\nPokémon appearing in Sprout Tower.\\rThey say Normal-type Pokémon moves\\nhave no effect on them.","msg_0556_T22_00006":"Hey, you’re a Pokémon Trainer?\\rIf you beat the Gym Leader here,\\nyou’ll be ready for prime time!","msg_0556_T22_00007":"Falkner, from the Violet City Pokémon\\nGym, is a fine Trainer!\\rHe inherited his father’s Gym and\\nhas done a great job with it.","msg_0556_T22_00008":"You cannot have your Pokémon out\\nwalking with you in some places.\\rPlaces like buildings, caves, and\\nwhere there are huge crowds.\\rBut all you have to do is to put it in\\na Poké Ball!","msg_0556_T22_00009":"Violet City\\nThe City of Nostalgic Scents","msg_0556_T22_00010":"Violet City Pokémon Gym\\nLeader: Falkner\\fThe Elegant Master of Flying Pokémon","msg_0556_T22_00011":"Sprout Tower\\rExperience the Way of Pokémon\\nto Cast Aside Your Doubts.","msg_0556_T22_00012":"Pokémon School\\rEarl will show you all\\nthere is to Pokémon!","msg_0556_T22_00013":"Me oh my...\\nThat Egg must be...!\\r","msg_0556_T22_00014":"I see...\\nSo it was handed from Mr. Pokémon to\\fProfessor Elm, then from Professor Elm\\fto you.\\rNow I get it...\\r","msg_0556_T22_00015":"That Egg is truly an important Egg.\\nPlease do take good care of it for me.\\rIs that understood?\\r","msg_0556_T22_00016":"I am counting on you.\\r","msg_0556_T22_00017":"Shard de Berry!\\nShard de Berry!\\rYah, yah!\\nI trade Berry for a Shard.\\rIf ya bring me some Shards,\\nI will give ya three Berries, yah.\\r","msg_0556_T22_00018":"Shard de Berry!\\nShard de Berry!\\rYah, yah!\\nI trade Berry for Shard.\\rIf ya bring me some Shards,\\nI will give ya three Berries, yah.\\rWhich Shard will ya trade for\\nde Berry? {YESNO 0}","msg_0556_T22_00019":"More Shards to trade for\\nde Berries? {YESNO 0}","msg_0556_T22_00020":"Yah, yah!\\nCome back when ya’ve changed\\fya mind, yah.\\r","msg_0556_T22_00021":"I’ll give ya de Berry set A\\nfor de Red Shard, yah.\\r","msg_0556_T22_00022":"I’ll give ya de Berry set B\\nfor de Blue Shard, yah.\\r","msg_0556_T22_00023":"I’ll give ya de Berry set C\\nfor de Yellow Shard, yah.\\r","msg_0556_T22_00024":"I’ll give ya de Berry set D\\nfor de Green Shard, yah.\\r","msg_0556_T22_00025":"Ya already have many Berries\\nof dis set.\\rCome back when ya need more, yah.\\r","msg_0556_T22_00026":"We care about the traditional buildings\\naround here. That’s why even the\\fPoké Mart and Pokémon Center are\\fpainted a bit somberly to blend in.","msg_0556_T22_00027":"Did you know that Pokégear allows you\\nto put marks and memos on its Map?\\rI’d love to have one of those\\nPokégears, but my mom won’t let me."},"initTriggers":[{"var":"VAR_SCENE_VIOLET_CITY_OW","value":1,"script":"_EV_scr_seq_T22_000 + 1"},{"var":"VAR_SCENE_VIOLET_CITY_OW","value":3,"script":"_EV_scr_seq_T22_004 + 1"}],"initScripts":{},"constants":{"_EV_scr_seq_T22_000":0,"_EV_scr_seq_T22_001":1,"_EV_scr_seq_T22_002":2,"_EV_scr_seq_T22_003":3,"_EV_scr_seq_T22_004":4,"_EV_scr_seq_T22_005":5,"_EV_scr_seq_T22_006":6,"_EV_scr_seq_T22_007":7,"_EV_scr_seq_T22_008":8,"_EV_scr_seq_T