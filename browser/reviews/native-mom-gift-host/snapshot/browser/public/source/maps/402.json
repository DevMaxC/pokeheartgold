SetFlag",["FLAG_TRADE_STEVEN_FORRETRESS_BELDUM"]],["Compare",["VAR_TEMP_x4002","200"]],["GoToIfLt",["_04A2"]],["NPCMsg",["msg_0537_T11R0701_00013"]],["GoTo",["_04A5"]],["NPCMsg",["msg_0537_T11R0701_00012"]],["CloseMsg",[]],["GetPlayerFacing",["VAR_TEMP_x4000"]],["Compare",["VAR_TEMP_x4000","0"]],["GoToIfNe",["_04C6"]],["ApplyMovement",["obj_T11R0701_daigo","_0504"]],["GoTo",["_04CE"]],["ApplyMovement",["obj_T11R0701_daigo","_051C"]],["WaitMovement",[]],["PlaySE",["SEQ_SE_DP_KAIDAN2"]],["WaitSE",["SEQ_SE_DP_KAIDAN2"]],["HidePerson",["obj_T11R0701_daigo"]],["SetFlag",["FLAG_HIDE_SAFFRON_CITY_STEVEN"]],["SetVar",["VAR_UNK_4130","7"]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0537_T11R0701_00010"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCTradeEnd",[]],["NPCMsg",["msg_0537_T11R0701_00011"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["WalkNormalWest",["2"]],["WalkNormalSouth",["5"]],["WalkNormalWest",[]],["WalkNormalSouth",[]],["SetInvisible",[]],["EndMovement",[]],["WalkNormalSouth",["5"]],["WalkNormalWest",["3"]],["WalkNormalSouth",[]],["SetInvisible",[]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0537_T11R0701_00003"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0537_T11R0701_00000":"Welcome. This is Silph Co.’s\\nhead office building.","msg_0537_T11R0701_00001":"Hey, you! The elevator there is out of\\norder now.\\rSomething is wrong with the electricity,\\nand it won’t work right.\\rI feel sorry that you wasted a trip,\\nso here is a gift for you!\\r","msg_0537_T11R0701_00002":"It’s Silph Co.’s latest product.\\nIt’s not for sale anywhere yet.","msg_0537_T11R0701_00003":"This elevator is out of order.\\rIt may electrocute you. Stay away.","msg_0537_T11R0701_00004":"","msg_0537_T11R0701_00005":"","msg_0537_T11R0701_00006":"","msg_0537_T11R0701_00007":"Steven: We meet again!\\nHave you been to Hoenn before?\\rIt’s such a beautiful place, with the\\nclearest ocean you can imagine.\\rYou should visit sometime.\\fHey!\\rWhy don’t we trade Pokémon?\\rI’ve been looking for FORRETRESS.\\nI can trade my BELDUM for it. {YESNO 0}","msg_0537_T11R0701_00008":"Steven: Will you trade FORRETRESS\\nfor my BELDUM? {YESNO 0}","msg_0537_T11R0701_00009":"Steven: OK, let’s trade!\\r","msg_0537_T11R0701_00010":"Steven: That’s too bad.","msg_0537_T11R0701_00011":"Steven: Are you telling me that\\nyou think that’s a FORRETRESS?","msg_0537_T11R0701_00012":"Steven: You don’t see FORRETRESS in\\nthe Hoenn region.\\rIt’s my first time to actually see one.\\nThank you so much!\\rOh, look at the time. I really must go.\\r","msg_0537_T11R0701_00013":"Steven: This Pokémon seems to like\\nyou a lot. Do you happen to like\\fSteel-type Pokémon?\\rI had a feeling.\\nThat particular texture!\\rThe cool and glowing bodies!\\nSuch uniquenesses are only for\\fSteel-type Pokémon!\\rWhen it comes to the solitariness and\\nnobleness you sense through the \\frugged body, which is almost rebuffing\\fwhen you hug, nothing comes close to\\fBELDUM, I must say...\\rIn short, my METAGROSS is\\ntruly strong and cool!\\r...\\nOh, it seems that I got carried away.\\rIt was a pleasure talking to you.\\nBye!\\r","msg_0537_T11R0701_00014":"Hello...\\nYou’re breaking up...\\fI think it depends on how my dad feels.\\rI see...\\nI’ll be on my way. See you soon.\\r","msg_0537_T11R0701_00015":"Steven: You are...\\nI remember your eyes.\\rWhen I see a Trainer whose eyes\\ntwinkle, I always remember.\\r","msg_0537_T11R0701_00016":"Steven: You have a Pokédex!\\nSo you are also in search of Pokémon.\\fLet me see...\\rI think I can help you with that.\\rLet’s say that you have stones in\\nfront of you.\\fWhich color would you pick? {YESNO 0}","msg_0537_T11R0701_00017":"GREEN STONE","msg_0537_T11R0701_00018":"RED STONE","msg_0537_T11R0701_00019":"BLUE STONE","msg_0537_T11R0701_00020":"Steven: You chose correctly!\\nI will give you {STRVAR_1 0, 1, 0}!\\r","msg_0537_T11R0701_00021":"{STRVAR_1 3, 0, 0} received\\nthe {STRVAR_1 0, 1, 0} from Steven!","msg_0537_T11R0701_00022":"Steven: Take good care of it.\\nYour caring for it will make me\\fvery happy.\\r","msg_0537_T11R0701_00023":"Steven: I see...\\nFor the choice you’ve made,\\fI’d like to give you this Pokémon.\\rExcept your party is full.\\rWhy don’t you go to the PC to make\\nsome room? I’ll be waiting here.","msg_0537_T11R0701_00024":"Steven: I will ask again.\\nWhich color do you choose? {YESNO 0}","msg_0537_T11R0701_00025":"Would you like to give a nickname\\nto {STRVAR_1 0, 1, 0}? {YESNO 0}","msg_0537_T11R0701_00026":"Steven: You did a great job naming it!\\r","msg_0537_T11R0701_00027":"QUIT","msg_0537_T11R0701_00028":"Steven: You seem to be quite cautious.\\rAre you avoiding any chance when a\\nperson might trick you?\\fYou really are better than I thought.","msg_0537_T11R0701_00029":"","msg_0537_T11R0701_00030":""},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T11R0701_002 + 1","OnResume":"_EV_scr_seq_T11R0701_005 + 1"},"constants":{"_EV_scr_seq_T11R0701_000":0,"_EV_scr_seq_T11R0701_001":1,"_EV_scr_seq_T11R0701_002":2,"_EV_scr_seq_T11R0701_003":3,"_EV_scr_seq_T11R0701_004":4,"_EV_scr_seq_T11R0701_005":5,"obj_T11R0701_gswoman6":0,"obj_T11R0701_policeman":1,"obj_T11R0701_daigo":2}}
