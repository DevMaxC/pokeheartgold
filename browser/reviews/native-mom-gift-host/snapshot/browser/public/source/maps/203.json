mpare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0191"]],["End",[]],["BufferPlayersName",["0"]],["NPCMsg",["msg_0586_T25R0401_00013"]],["RegisterGearNumber",["PHONE_CONTACT_BILL"]],["PlayFanfare",["SEQ_ME_POKEGEAR_REGIST"]],["WaitFanfare",[]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0586_T25R0401_00015"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0586_T25R0401_00015"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0586_T25R0401_00000":"Bill: Hi, {STRVAR_1 3, 0, 0}! Would you do\\nsomething for me and take this EEVEE?\\rIt came over when I was adjusting\\nNintendo Wi-Fi Connection.\\rSomeone has to take care of it,\\nbut I don’t like being outside.\\rCan I count on you to play with it,\\n{STRVAR_1 3, 0, 0}? {YESNO 0}","msg_0586_T25R0401_00001":"Bill: I knew you’d come through!\\nYou’re the real deal! Way to go!\\fOK, I’m counting on you.\\fTake good care of it!\\r","msg_0586_T25R0401_00002":"{STRVAR_1 3, 0, 0} received\\nthe EEVEE!","msg_0586_T25R0401_00003":"Bill: Professor Elm said EEVEE can\\nevolve into seven different kinds\\fof Pokémon!","msg_0586_T25R0401_00004":"Whoa, wait. You can’t carry any\\nmore Pokémon.","msg_0586_T25R0401_00005":"Oh... Now what to do?","msg_0586_T25R0401_00006":"Bill: I used to do experiments on\\ntransferring things.\\rBoth the GTS and Nintendo Wi-Fi\\nConnection were inspired by\\fmy machine that transfers things!","msg_0586_T25R0401_00007":"Give a nickname to\\nthe EEVEE you received? {YESNO 0}","msg_0586_T25R0401_00008":"","msg_0586_T25R0401_00009":"Oh, you collect Pokémon?\\nMy son Bill is an expert.\\rHe just got called to the Pokémon\\nCenter in Ecruteak City.","msg_0586_T25R0401_00010":"Whatever happens, it makes me happy\\nto see my own son.","msg_0586_T25R0401_00011":"My big brother Bill made the\\nPokémon Storage System.","msg_0586_T25R0401_00012":"Are you a Trainer?\\rI’ve got a useful phone number\\nfor you. {YESNO 0}","msg_0586_T25R0401_00013":"{STRVAR_1 3, 0, 0} registered Bill\\nin the Pokégear!","msg_0586_T25R0401_00014":"My brother made the\\nPokémon Storage System.\\rI was going to give you Bill’s number...","msg_0586_T25R0401_00015":"When you call my brother, he can tell\\nyou about the PC Boxes where you\\fstore your Pokémon!"},"initTriggers":[],"initScripts":{},"constants":{"_EV_scr_seq_T25R0401_000":0,"_EV_scr_seq_T25R0401_001":1,"_EV_scr_seq_T25R0401_002":2,"obj_T25R0401_masaki":0,"obj_T25R0401_middlewoman1_2":1,"obj_T25R0401_gsbabygirl1":2}}
