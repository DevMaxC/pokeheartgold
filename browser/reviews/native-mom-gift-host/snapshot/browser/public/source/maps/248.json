EndMovement",[]],["Delay2",[]],["WalkNormalWest",["8"]],["EndMovement",[]],["WalkOnSpotNormalSouth",[]],["EndMovement",[]],["WalkFastSouth",["6"]],["WalkFastWest",["12"]],["EndMovement",[]],["Delay4",[]],["WalkFastWest",[]],["WalkFastSouth",["6"]],["WalkFastWest",["12"]],["EndMovement",[]],["FollowMonResetMovement",[]],["LockAll",[]],["NPCMsg",["msg_0113_D35R0103_00014"]],["CloseMsg",[]],["ToggleFollowingPokemonMovement",["0"]],["WaitFollowingPokemonMovement",[]],["FollowingPokemonMovement",["55"]],["ApplyMovement",["obj_player","_0A6C"]],["WaitMovement",[]],["WaitFollowingPokemonMovement",[]],["ToggleFollowingPokemonMovement",["1"]],["FollowingPokemonMovement",["48"]],["ReleaseAll",[]],["End",[]],["WalkNormalWest",[]],["EndMovement",[]],["FollowMonResetMovement",[]],["LockAll",[]],["ApplyMovement",["obj_D35R0103_wataru","_0AAC"]],["WaitMovement",[]],["NPCMsg",["msg_0113_D35R0103_00014"]],["CloseMsg",[]],["ToggleFollowingPokemonMovement",["0"]],["WaitFollowingPokemonMovement",[]],["FollowingPokemonMovement",["55"]],["ApplyMovement",["obj_player","_0A6C"]],["WaitMovement",[]],["WaitFollowingPokemonMovement",[]],["ToggleFollowingPokemonMovement",["1"]],["FollowingPokemonMovement",["48"]],["ReleaseAll",[]],["End",[]],["EmoteExclamationMark",[]],["WalkOnSpotNormalWest",[]],["EndMovement",[]],["ReleaseAll",[]],["GoToIfUnset",["FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_1","_0AE4"]],["GoToIfUnset",["FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_2","_0AE4"]],["GoToIfUnset",["FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_3","_0AE4"]],["NPCMsg",["msg_0113_D35R0103_00023"]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0113_D35R0103_00022"]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0113_D35R0103_00000":"Lance: Are you all right?\\rYour Pokémon are hurt and tired.\\nHere, give them some of my medicine.\\r","msg_0113_D35R0103_00001":"Lance: {STRVAR_1 3, 0, 0}, let’s give our\\nbest for Pokémon.\\r","msg_0113_D35R0103_00002":"Lance: {STRVAR_1 3, 0, 0}, let’s give our\\nbest for Pokémon.\\r","msg_0113_D35R0103_00003":"Ariana: Hold it right there!","msg_0113_D35R0103_00004":"Ariana: We can’t let a brat like you\\ndo as you please forever.\\rIt’ll hurt Team Rocket’s pride over and\\nover again. Making it lessen, you see.\\r...So, it’s time to finish you. However\\nstrong you may be, if the two of us\\ffight at the same time, you’ll have no\\fchance of winning. Don’t you agree?\\rHee hee hee! Sorry, baby. Now, get\\nready to be thrashed.\\r","msg_0113_D35R0103_00005":"Lance: Hold it!\\rA two-on-one battle?\\nThat is so unfair!\\rTypical of Team Rocket to be so sneaky.\\nAllow me to join the battle!\\r","msg_0113_D35R0103_00006":"Ariana: What? You had an accomplice?\\nWhere is your sense of dignity?\\rAs interim boss in place of Giovanni,\\nI’ll show you how wrong it is to meddle\\fwith Team Rocket!\\r","msg_0113_D35R0103_00007":"Tch, you really are strong.\\nIt’s too bad.\\rIf you were to join Team Rocket, you\\ncould become an Executive.\\r","msg_0113_D35R0103_00008":"Ariana: But that’s fine. The broadcast\\nexperiment was a total success.\\rIt doesn’t matter what happens to this\\nhideout now.\\rWe have much bigger plans.\\nYou’ll come to appreciate Team\\fRocket’s true power soon enough.\\rEnjoy yourself while you can...\\nHee hee hee...\\r","msg_0113_D35R0103_00009":"Lance: That did it. We defeated all the\\nmembers of Team Rocket here.\\rBut I’m concerned about the young guy\\nwith red hair I battled in the\\fprocess...\\r","msg_0113_D35R0103_00010":"Sorry, {STRVAR_1 3, 0, 0}. I saw how well you\\nwere doing, so I just hung back.\\rNow all there is left to do is to turn\\noff that odd radio signal.\\r","msg_0113_D35R0103_00011":"Sorry, {STRVAR_1 3, 0, 0}. I saw how well you\\nwere doing, so I just hung back.\\rNow all there is left to do is to turn\\noff that odd radio signal.\\r","msg_0113_D35R0103_00012":"It’s this machine that’s causing all the\\nproblems. I don’t see a switch on it...\\rWe have no choice. We have to make all\\nthe ELECTRODE faint.\\rThat should stop this machine from\\ntransmitting that strange signal.\\rIt’s no fault of the ELECTRODE, so it\\nmakes me feel sad.\\r{STRVAR_1 3, 0, 0}, let’s split the job.\\r","msg_0113_D35R0103_00013":"It’s this machine that’s causing all the\\nproblems. I don’t see a switch on it...\\rWe have no choice. We have to make all\\nthe ELECTRODE faint.\\rThat should stop this machine from\\ntransmitting that strange signal.\\rIt’s no fault of the ELECTRODE, so it\\nmakes me feel sad.\\r{STRVAR_1 3, 0, 0}, let’s split the job.\\r","msg_0113_D35R0103_00014":"Lance: Leave this side to me.\\r","msg_0113_D35R0103_00015":"Lance: That odd signal has finally\\nstopped. The lake should be back to\\fnormal. You’re the best!\\rLet me thank you on behalf of all the\\nPokémon. Oh, yes. You should take this.\\rI found it here, but I don’t have any\\nneed for it.\\r","msg_0113_D35R0103_00016":"{STRVAR_1 3, 0, 0} received HM05 from Lance!","msg_0113_D35R0103_00017":"Lance: That’s Whirlpool.\\rTeach it to a Pokémon to get across wild\\nwater. But keep this in mind.\\rYou can use that out of battle only with\\nthe Badge from Mahogany Gym.\\r","msg_0113_D35R0103_00018":"{STRVAR_1 3, 0, 0}...\\rThe journey to becoming the Pokémon\\nChampion is long and difficult.\\rKnowing that, will you keep going?\\r..................\\rI see. No, you’re right.\\rIf you would give up that easily,\\nyou would have never chased that\\fdream in the first place.\\rI look forward to seeing you again!\\r","msg_0113_D35R0103_00019":"{STRVAR_1 3, 0, 0}...\\rThe journey to becoming the Pokémon\\nChampion is long and difficult.\\rKnowing that, will you keep going?\\r..................\\rI see. No, you’re right.\\rIf you would give up that easily,\\nyou would have never chased that\\fdream in the first place.\\rI look forward to seeing you again!\\r","msg_0113_D35R0103_00020":"“The Radio Transmitter”\\rIt seems that this door checks the\\nvoice of the person saying the password\\fbefore it opens...","msg_0113_D35R0103_00021":"The door’s closed...\\r{STRVAR_1 3, 0, 0} entered the password.\\rThe door opened!\\r","msg_0113_D35R0103_00022":"It’s the radio transmitter that’s\\nsending the sinister signal.\\rIt’s working at full capacity.","msg_0113_D35R0103_00023":"The radio transmitter has finally\\nstopped its evil broadcast.","msg_0113_D35R0103_00024":"MURKROW: The password is...\\fHail Giovanni.\\r","msg_0113_D35R0103_00025":"MURKROW: The password is...\\fHail Giovanni.\\r","msg_0113_D35R0103_00026":"MURKROW: The password is...\\fHail Giovanni.\\r","msg_0113_D35R0103_00027":"MURKROW screamed the password,\\nmimicking the voice of Petrel.\\r..................\\rThe voice-recognition system unlocked\\nthe door!\\r"},"initTriggers":[{"var":"VAR_UNK_40A9","value":0,"script":"_EV_scr_seq_D35R0103_000 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_D35R0103_002 + 1","OnLoad":"_EV_scr_seq_D35R0103_007 + 1"},"constants":{"_EV_scr_seq_D35R0103_000":0,"_EV_scr_seq_D35R0103_001":1,"_EV_scr_seq_D35R0103_002":2,"_EV_scr_seq_D35R0103_003":3,"_EV_scr_seq_D35R0103_004":4,"_EV_scr_seq_D35R0103_005":5,"_EV_scr_seq_D35R0103_006":6,"_EV_scr_seq_D35R0103_007":7,"_EV_scr_seq_D35R0103_008":8,"_EV_scr_seq_D35R0103_009":9,"_EV_scr_seq_D35R0103_010":10,"_EV_scr_seq_D35R0103_011":11,"_EV_scr_seq_D35R0103_012":12,"_EV_scr_seq_D35R0103_013":13,"_EV_scr_seq_D35R0103_014":14,"obj_D35R0103_wataru":0,"obj_D35R0103_tsure_poke_static_dragonite":1,"obj_D35R0103_rocketm":2,"obj_D35R0103_rocketm_2":3,"obj_D35R0103_rocketm_3":4,"obj_D35R0103_babyboy1_9":5,"obj_D35R0103_babyboy1_9_2":6,"obj_D35R0103_rocketm_4":7,"obj_D35R0103_rkanbuw":8,"obj_D35R0103_tsure_poke_static_electrode":9,"obj_D35R0103_tsure_poke_static_electrode_2":10,"obj_D35R0103_tsure_poke_static_electrode_3":11,"obj_D35R0103_tsure_poke_static_electrode_4":12,"obj_D35R0103_tsure_poke_static_electrode_5":13,"obj_D35R0103_tsure_poke_static_electrode_6":14,"obj_D35R0103_monstarball":15,"obj_D35R0103_tsure_poke_