"msg_0469_T04GYM0101_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_CASCADE","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0424"]],["NPCMsg",["msg_0469_T04GYM0101_00014"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0469_T04GYM0101_00015"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0469_T04GYM0101_00000":"{SIZE 200}Bump!{SIZE 100}\\r","msg_0469_T04GYM0101_00001":"Oops! I so sorry!\\nYou not hurt, OK?\\fI very busy.\\fNo time for talking with you.\\fNot good for me if seen by somebody.\\r","msg_0469_T04GYM0101_00002":"Oh no! You seen me already!\\fI make big mistake!\\r","msg_0469_T04GYM0101_00003":"Hey, you! Forget you see me, OK?\\nYou seen, heard, known nothing, OK?\\fBye!\\fBye-bye a go-go!\\r","msg_0469_T04GYM0101_00004":"Sorry, I’ll be out for a while.\\nMisty, Gym Leader","msg_0469_T04GYM0101_00005":"Since Misty’s out, we’ll be away, too.\\nGym Trainers","msg_0469_T04GYM0101_00006":"Cerulean City Pokémon Gym","msg_0469_T04GYM0101_00007":"Cerulean City Pokémon Gym\\rLeader: Misty\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}","msg_0469_T04GYM0101_00008":"Misty: I was expecting you,\\nyou pest!\\rYou may have a lot of Johto Gym Badges,\\nbut you’d better not take me\\ftoo lightly.\\rMy Water-type Pokémon are tough!\\r","msg_0469_T04GYM0101_00009":"Misty: You really are good...\\rI’ll admit that you are skilled...\\rHere you go.\\nIt’s the Cascade Badge.\\r","msg_0469_T04GYM0101_00010":"{STRVAR_1 3, 0, 0} received\\nthe Cascade Badge from Misty!","msg_0469_T04GYM0101_00011":"Misty: Here is another memento\\nfrom this battle. Take it!\\r","msg_0469_T04GYM0101_00012":"Misty: It contains the move\\nWater Pulse.\\rIt can sometimes confuse your foe.\\rYou’ve managed to defeat Trainers\\nall the way from Johto.\\fI’m sure you have a good use for it.","msg_0469_T04GYM0101_00013":"Misty: Does Johto have a lot of\\npowerful Trainers?\\rI will someday go on my journey\\nto battle with powerful Trainers!","msg_0469_T04GYM0101_00014":"Yo! Legend in the making!\\rSince Misty was away, I went out\\nfor some fun, too.\\fHe-he-he.","msg_0469_T04GYM0101_00015":"Hoo, you showed me how tough you are.\\rAs always, that was one great battle!","msg_0469_T04GYM0101_00016":"...!\\r{STRVAR_1 3, 0, 0} picked up the black item\\nthat was by the pool.\\rIt’s a Part from a machine!\\r"},"initTriggers":[{"var":"VAR_UNK_411C","value":1,"script":"_EV_scr_seq_T04GYM0101_004 + 1"}],"initScripts":{"OnLoad":"_EV_scr_seq_T04GYM0101_006 + 1","OnTransition":"_EV_scr_seq_T04GYM0101_007 + 1"},"constants":{"_EV_scr_seq_T04GYM0101_000":0,"_EV_scr_seq_T04GYM0101_001":1,"_EV_scr_seq_T04GYM0101_002":2,"_EV_scr_seq_T04GYM0101_003":3,"_EV_scr_seq_T04GYM0101_004":4,"_EV_scr_seq_T04GYM0101_005":5,"_EV_scr_seq_T04GYM0101_006":6,"_EV_scr_seq_T04GYM0101_007":7,"obj_T04GYM0101_sunglasses":0,"obj_T04GYM0101_gsswimmerw":1,"obj_T04GYM0101_gsswimmerw_2":2,"obj_T04GYM0101_gsswimmerw_3":3,"obj_T04GYM0101_seaman_2":4,"obj_T04GYM0101_seaman_2_2":5,"obj_T04GYM0101_gsleader11":6,"obj_T04GYM0101_rocketm":7,"obj_T04GYM0101_stop":8,"obj_T04GYM0101_stop_2":9}}
