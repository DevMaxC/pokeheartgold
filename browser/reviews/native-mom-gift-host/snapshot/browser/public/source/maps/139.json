4_T24GYM0101_00007":"Argh... Your Bag is jammed full!","msg_0574_T24GYM0101_00008":"Chuck: Wahahah!\\nI enjoyed battling you!\\rBut a loss is a loss!\\rFrom now on, I’m going to train\\n24 hours a day!","msg_0574_T24GYM0101_00009":"He’s so into his training, he\\ndoesn’t seem to notice you.","msg_0574_T24GYM0101_00010":"There is a large winch.\\nWill you turn it? {YESNO 0}","msg_0574_T24GYM0101_00011":"{STRVAR_1 3, 0, 0} turned the winch\\nwith pure might!\\r","msg_0574_T24GYM0101_00012":"It won’t turn anymore.","msg_0574_T24GYM0101_00013":"Cianwood City Pokémon Gym","msg_0574_T24GYM0101_00014":"Cianwood City Pokémon Gym\\rLeader: Chuck\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T24GYM0101_001 + 1"},"constants":{"_EV_scr_seq_T24GYM0101_000":0,"_EV_scr_seq_T24GYM0101_001":1,"_EV_scr_seq_T24GYM0101_002":2,"_EV_scr_seq_T24GYM0101_003":3,"obj_T24GYM0101_gsleader5":0,"obj_T24GYM0101_gsfighter":1,"obj_T24GYM0101_gsfighter_2":2,"obj_T24GYM0101_gsfighter_3":3,"obj_T24GYM0101_gsfighter_4":4}}
