g",[]],["GoTo",["_0219"]],["NPCMsg",["msg_0596_T25R1005_00006"]],["SetFlag",["FLAG_UNK_08E"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0596_T25R1005_00000":"Hello. Oh, your Pokémon...\\r","msg_0596_T25R1005_00001":"It’s very attached to you.\\rThis move should be perfect for a\\npair like you.\\r","msg_0596_T25R1005_00002":"","msg_0596_T25R1005_00003":"It’s adorable!\\rYou should teach it good TM moves.","msg_0596_T25R1005_00004":"It looks a little bit evil.\\nHow about this TM for it?\\r","msg_0596_T25R1005_00005":"","msg_0596_T25R1005_00006":"There are sure to be TMs that are\\njust perfect for your Pokémon.","msg_0596_T25R1005_00007":"Mystery Gift.\\rWith just a little beep, you get a gift.","msg_0596_T25R1005_00008":"The Mystery Gift option is not\\ncompatible with Game Boy Color.","msg_0596_T25R1005_00009":"I collect Pokémon.\\nDo you have a DROWZEE?\\rWant to trade it for my MACHOP? {YESNO 0}","msg_0596_T25R1005_00010":"Yay! I got myself a DROWZEE!\\fThanks!","msg_0596_T25R1005_00011":"Huh? That’s not DROWZEE.\\nWhat a letdown...","msg_0596_T25R1005_00012":"You don’t want to trade? Aww...","msg_0596_T25R1005_00013":"Hi, how’s my old MACHOP doing?","msg_0596_T25R1005_00014":"Huh? You...are part of Team Rocket?\\nSince when?","msg_0596_T25R1005_00015":"On Sundays, a lady comes to check\\nout Pokémon.\\rShe even gives away TMs!","msg_0596_T25R1005_00016":"Team Rocket...\\nWhy are they here?","msg_0596_T25R1005_00017":"You can’t rename a Pokémon you get in\\na trade.\\rThe name is a reflection of the original\\nTrainer’s feelings for it.","msg_0596_T25R1005_00018":"You shouldn’t wear a black suit like\\nthat. People will think you are a part\\fof Team Rocket.\\rWhat? You are one of them?","msg_0596_T25R1005_00019":"Modify Your Pokémon\\n5F TM Corner"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T25R1005_005 + 1"},"constants":{"_EV_scr_seq_T25R1005_000":0,"_EV_scr_seq_T25R1005_001":1,"_EV_scr_seq_T25R1005_00