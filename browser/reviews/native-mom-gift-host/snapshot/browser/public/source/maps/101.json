ToIfSet",["FLAG_UNK_0B5","_00E3"]],["NPCMsg",["msg_0388_R35R0101_00006"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0388_R35R0101_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0388_R35R0101_00001"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0388_R35R0101_00002"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["Compare",["VAR_LOAN_SPEAROW","4"]],["GoToIfGe",["_016D"]],["NPCMsg",["msg_0388_R35R0101_00007"]],["GoToIfNoItemSpace",["ITEM_HP_UP","1","_0163"]],["CallStd",["std_give_item_verbose"]],["Compare",["VAR_LOAN_SPEAROW","3"]],["GoToIfNe",["_0152"]],["SetVar",["VAR_LOAN_SPEAROW","5"]],["GoTo",["_0158"]],["SetVar",["VAR_LOAN_SPEAROW","4"]],["NPCMsg",["msg_0388_R35R0101_00008"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["CallStd",["std_bag_is_full"]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0388_R35R0101_00010"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SetVar",["VAR_LOAN_SPEAROW","6"]],["NPCMsg",["msg_0388_R35R0101_00009"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0388_R35R0101_00000":"Excuse me, kid!\\nI received this letter the other day\\ffrom a friend of mine.\\rHere’s the reply that I wrote.\\rI am stuck here and was wondering\\nif you could deliver it...\\rHe’s on Route 31.\\fCan you help a guy out? {YESNO 0}","msg_0388_R35R0101_00001":"Oh... Never mind, then...\\nYou must be busy, too.","msg_0388_R35R0101_00002":"Huh?\\nYour party is full!","msg_0388_R35R0101_00003":"Wow, thanks!\\r","msg_0388_R35R0101_00004":"{STRVAR_1 3, 0, 0} received the\\nSPEAROW with Mail!","msg_0388_R35R0101_00005":"My friend is on Route 31.\\rHe looks obviously eager to read\\nletters, so you’ll know who he is\\fright away!","msg_0388_R35R0101_00006":"My friend is on Route 31.\\rOh, yeah.\\nThere was a weird tree\\fblocking the road.\\fI wonder if it’s been cleared?","msg_0388_R35R0101_00007":"Thank you for making the delivery!\\r...What about a cave exploration?\\nAh, you can go right through here.\\rI want you to have this for\\nyour kindness!\\r","msg_0388_R35R0101_00008":"My pal was snoozing, right?\\nHeh, he’s always sleeping.","msg_0388_R35R0101_00009":"What?!\\nYou lost the Mail?\\fOh, well. That’s OK.\\fDon’t worry about it.","msg_0388_R35R0101_00010":"Everything is fine!","msg_0388_R35R0101_00011":"A strange tree is blocking the road.\\nIt wriggles around if you talk to it.\\rI heard it became wild when someone\\nwatered it with a SquirtBottle.","msg_0388_R35R0101_00012":"I like the Pokémon Lullaby they play\\non the radio.","msg_0388_R35R0101_00013":"I can’t believe such a tiny change\\nturns the Pokégear into a radio!\\rOh, your Pokégear doesn’t have\\nthat feature yet?\\rIt’s a shame!\\rThey happen to give quizzes at the\\nRadio Tower reception on the\\ffirst floor.\\rIf you can answer them correctly,\\nthey’ll give you the Radio Card!\\rYou better try it while they\\nhave some left!","msg_0388_R35R0101_00014":"I may not look it, but I’m pretty good\\nat mechanics.\\rDo you want to know how to\\nlisten to the radio? {YESNO 0}","msg_0388_R35R0101_00015":"You open your Pokégear and press the\\nradio button. Then you see the screen\\ffor tuning in a signal.\\rThe middle of the screen is the\\nradio-reception map.\\rYou can move the blinking mark on the\\nmap around to tune in to different\\fradio shows.\\rFor those who think this is a pain,\\nthere are four channels, two on each\\fside, for easy tuning.","msg_0388_R35R0101_00016":"Was I being a backseat driver?"},"initTriggers":[],"initScripts":{},"constants":{"_EV_scr_seq_R35R0101_000":0,"_EV_scr_seq_R35R0101_001":1,"obj_R35R0101_counterm":0,"obj_R35R0101_middlewoman1_2":1}}
