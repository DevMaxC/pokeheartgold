["msg_0397_R39R0101_00011"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0397_R39R0101_00000":"My MILTANK ain’t givin’ me milk\\nn’more.\\rThis here farm’s got famous milk.\\rMost everyone wants a drink.\\nIt’ll give me lots o’ milk if’n I feed it\\flots o’ Berries, I reckon.","msg_0397_R39R0101_00001":"How’d you like my Moomoo Milk?\\rIt’s my pride and joy, there.\\fGive it to Pokémon to restore HP!\\rI’ll give it to ya fer just $500. {YESNO 0}","msg_0397_R39R0101_00002":"Here ya go!\\nDrink up’n enjoy!\\r","msg_0397_R39R0101_00003":"Sorry, there.\\nNo cash, no sale!","msg_0397_R39R0101_00004":"I reckon yer Bag’s full.","msg_0397_R39R0101_00005":"You don’t want it?\\nCome again, hear?","msg_0397_R39R0101_00006":"I best go do my milkin’.","msg_0397_R39R0101_00007":"Our milk even goes out to Kanto.\\rSo if our own MILTANK won’t give\\nus any milk, we’re in trouble.","msg_0397_R39R0101_00008":"You fixed our MILTANK, hon.\\nNow it gives Moomoo Milk again.\\rHere’s somethin’ fer your trouble.","msg_0397_R39R0101_00009":"","msg_0397_R39R0101_00010":"That there’s Natural Gift.\\rIts move type and Power will depend\\non the Berry yer Pokémon holds.\\rWhen you use it once, the Berry’s gone.\\nYou best think how you ought to\\fuse it, hon.","msg_0397_R39R0101_00011":"I reckon yer Bag’s full.","msg_0397_R39R0101_00012":"{ALN_CENTER}1 BOTTLE","msg_0397_R39R0101_00013":"{ALN_CENTER}1 DOZEN","msg_0397_R39R0101_00014":"{ALN_CENTER}NO THANKS"},"initTriggers":[],"initScripts":{},"constants":{"_EV_scr_seq_R39R0101_000":0,"_EV_scr_seq_R39R0101_001":1,"obj_R39R0101_gsmiddleman1":0,"obj_R39R0101_middlewoman1_2":1}}
