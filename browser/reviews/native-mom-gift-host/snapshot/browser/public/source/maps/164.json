easeAll",[]],["End",[]],["NPCMsg",["msg_0571_T23R0501_00014"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["PlayCry",["SPECIES_SLOWPOKE","0"]],["NPCMsg",["msg_0571_T23R0501_00020"]],["WaitCry",[]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0571_T23R0501_00021"]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["Compare",["VAR_SCENE_ROCKET_TAKEOVER","2"]],["GoToIfNe",["_03C8"]],["NPCMsg",["msg_0571_T23R0501_00024"]],["GoTo",["_03F7"]],["Compare",["VAR_SCENE_ROCKET_TAKEOVER","3"]],["GoToIfNe",["_03DE"]],["NPCMsg",["msg_0571_T23R0501_00024"]],["GoTo",["_03F7"]],["Compare",["VAR_SCENE_ROCKET_TAKEOVER","4"]],["GoToIfNe",["_03F4"]],["NPCMsg",["msg_0571_T23R0501_00024"]],["GoTo",["_03F7"]],["NPCMsg",["msg_0571_T23R0501_00023"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0571_T23R0501_00000":"Hm? Who are you?\\r{STRVAR_1 3, 0, 0}, eh? You want me to make\\nsome Balls?\\rSorry, but that’ll have to wait.\\rDo you know Team Rocket?\\nAh, don’t worry. I’ll tell you anyhow.\\rTeam Rocket’s an evil gang that\\nuses Pokémon for their dirty work.\\rThey’re supposed to have disbanded\\nthree years ago.\\rAnyway, they’re at the well, cutting\\noff SlowpokeTails for sale!\\rSo I’m going to go give them a\\nlesson in pain!\\rHang on, SLOWPOKE!\\nOld Kurt is on his way!","msg_0571_T23R0501_00001":"Kurt: Hi, {STRVAR_1 3, 0, 0}!\\nYou handled yourself like a real hero.\\rAs I mentioned before, Team Rocket was\\ndisbanded by a boy called Red three\\fyears ago.\\rNow that they have come back...\\nI have a bad feeling about it...\\rIn any case, it would please me greatly\\nto make Poké Balls for a Trainer\\flike you, {STRVAR_1 3, 0, 0}.\\fThis is all I have now, but take it.\\r","msg_0571_T23R0501_00002":"","msg_0571_T23R0501_00003":"Kurt: I make Poké Balls from Apricorns.\\rCollect them from trees and bring\\n’em to me.\\rI’ll make Poké Balls out of them.","msg_0571_T23R0501_00004":"Kurt: You have Apricorns for me?\\fFine! I’ll turn them into Poké Balls.\\r","msg_0571_T23R0501_00005":"Kurt: It’ll take a day to make you a\\nPoké Ball. Come back for it later.","msg_0571_T23R0501_00006":"Kurt: Oh...\\nThat’s a letdown.","msg_0571_T23R0501_00007":"Kurt: I’m working!\\nDon’t bother me!","msg_0571_T23R0501_00008":"Kurt: Ah, {STRVAR_1 3, 0, 0}!\\fI just finished your Poké Ball. Here!\\r","msg_0571_T23R0501_00009":"Kurt: Your Bag is full!\\nCome back when it’s lighter.","msg_0571_T23R0501_00010":"Kurt: That turned out great.\\rTry catching Pokémon with it.","msg_0571_T23R0501_00011":"The SLOWPOKE are gone...\\nWere they taken away by bad people?","msg_0571_T23R0501_00012":"Grandpa’s gone...\\nI’m so lonely...","msg_0571_T23R0501_00013":"The SLOWPOKE my dad gave me came\\nback! Its tail has grown back, too!","msg_0571_T23R0501_00014":"Dad works at Silph where he studies\\nPoké Balls.\\rI have to stay home with Grandpa\\nand SLOWPOKE.","msg_0571_T23R0501_00015":"That’s right!\\nI’ll give you my grandpa’s number. {YESNO 0}","msg_0571_T23R0501_00016":"{STRVAR_1 3, 0, 0} registered Kurt\\nin the Pokégear!","msg_0571_T23R0501_00017":"My grandpa can tell you more\\nabout Apricorns.","msg_0571_T23R0501_00018":"No? Why?\\nYou don’t want to talk to my grandpa?","msg_0571_T23R0501_00019":"You want to talk to my grandpa,\\ndon’t you? {YESNO 0}","msg_0571_T23R0501_00020":"SLOWPOKE: ...\\nYawn?","msg_0571_T23R0501_00021":"You see three people, with landscape\\nin the background.\\rIt’s Kurt, Professor Oak, and...\\nin the middle,\\fa lady with determined eyes.","msg_0571_T23R0501_00022":"It’s a statue of the forest’s\\nprotector.","msg_0571_T23R0501_00023":"The radio is on.\\rIt’s Professor Oak’s Pokémon Talk!","msg_0571_T23R0501_00024":"The radio is declaring the revival\\nof Team Rocket!"},"initTriggers":[{"var":"VAR_UNK_4080","value":2,"script":"_EV_scr_seq_T23R0501_005 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T23R0501_000 + 1"},"constants":{"_EV_scr_seq_T23R0501_000":0,"_EV_scr_seq_T23R0501_001":1,"_EV_scr_seq_T23R0501_002":2,"_EV_scr_seq_T23R0501_003":3,"_EV_scr_seq_T23R0501_004":4,"_EV_scr_seq_T23R0501_005":5,"_EV_scr_seq_T23R0501_006":6,"obj_T23R0501_gantetsu":0,"obj_T23R0501_gsbabygirl1":1,"obj_T23R0501_tsure_poke_static_slowpoke":2}}
