opyVar",["VAR_UNK_4136","VAR_SPECIAL_x8002"]],["NPCMsg",["msg_0065_D23R0101_00042"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["BufferPlayersName",["0"]],["NPCMsg",["msg_0065_D23R0101_00043"]],["CopyVar",["VAR_SPECIAL_x8002","VAR_UNK_4136"]],["GoTo",["_0AC3"]],["SetVar",["VAR_UNK_4136","0"]],["SetFlag",["FLAG_UNK_AA6"]],["NPCMsg",["msg_0065_D23R0101_00044"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0065_D23R0101_00000":"Welcome to Goldenrod’s Radio Tower!","msg_0065_D23R0101_00001":"Welcome to Goldenrod’s Radio Tower!\\r...Or, maybe not.\\nI am sorry to tell you this, but no one\\fcan visit the tower now.","msg_0065_D23R0101_00002":"Um, yes. I have been telling visitors\\nto go home as you instructed...","msg_0065_D23R0101_00003":"We have a special Quiz campaign!\\rAnswer five questions correctly in a\\nrow to win a Radio Card!\\rWhen you load it into the Pokégear, you\\nwill be able to listen to the radio...\\fanytime, anywhere!\\rWould you like to try our Quiz? {YESNO 0}","msg_0065_D23R0101_00004":"The first question!\\rCan you check the Town Map with\\nyour Pokégear? {YESNO 0}","msg_0065_D23R0101_00005":"You are correct.\\nThe second question!\\rNIDORINA can only be female.\\nTrue? {YESNO 0}","msg_0065_D23R0101_00006":"You are correct.\\nThe third question!\\rKurt, the Poké Ball creator, uses\\napricots as ingredients? {YESNO 0}","msg_0065_D23R0101_00007":"You are correct again.\\nThe fourth question!\\rIt’s impossible to use a TM on\\nMAGIKARP. True? {YESNO 0}","msg_0065_D23R0101_00008":"Wow!\\nI have only one more question to go.\\rIn Professor Oak’s popular show,\\nPokémon Talk, is he on with Marie? {YESNO 0}","msg_0065_D23R0101_00009":"Bingo! You got it!\\nCongratulations!\\fHere’s your prize, a Radio Card!\\r","msg_0065_D23R0101_00010":"{STRVAR_1 3, 0, 0} can now listen to the\\nradio with the Pokégear!","msg_0065_D23R0101_00011":"Please tune in to our radio shows!","msg_0065_D23R0101_00012":"Oh, dear.\\nSorry, but you got it wrong.\\fPlease try again!","msg_0065_D23R0101_00013":"Oh. I see.\\nPlease see me if you change your mind.","msg_0065_D23R0101_00014":"Whitney: Hi!\\nMy name is Whitney!\\rI heard about the Quiz to win a Radio\\nCard, so I came here to get one...\\rBut this Quiz is so hard!\\r","msg_0065_D23R0101_00015":"Whitney: Wow, you did it!\\nI thought the answer to the third\\fquestion was surely apricots!\\rOops!\\nIt’s time to go back to the Gym!\\r","msg_0065_D23R0101_00016":"Ben is a fabulous DJ!\\nHis sweet voice just makes me melt!","msg_0065_D23R0101_00017":"I love Mary from Pokémon Talk.\\rI only know what she sounds like,\\nthough!","msg_0065_D23R0101_00018":"Who are you?\\nWe have some business going on.\\rI was told not to let anyone pass but\\nTeam Rocket!\\rDo you understand?\\rYou are only allowed to come through\\nwhen you are wearing the cool black\\funiform for Team Rocket!","msg_0065_D23R0101_00019":"Ha! You must be new!\\nYou look pretty good in the Team Rocket\\funiform!\\rGo on ahead!\\r","msg_0065_D23R0101_00020":"What are you doing?\\nGo upstairs and take your position!","msg_0065_D23R0101_00021":"{STRVAR_1 3, 1, 0}: Hey, Team Rocket!\\rStop going around in groups and\\ntroubling people. You cowards!\\r","msg_0065_D23R0101_00022":"{STRVAR_1 3, 1, 0}: ...Huh?\\nAre you {STRVAR_1 3, 0, 0}?\\fWhat are you doing here?\\rNo way... You think you’re strong now\\nthat you look like them?\\rThat’s foolish!\\nYou shouldn’t wear those things!\\r","msg_0065_D23R0101_00023":"What? You!\\nYou’re not a newcomer?\\fThen battle with me!\\r","msg_0065_D23R0101_00024":"You are too powerful.\\rYou could spoil our plan.\\nI have to inform the others...\\r","msg_0065_D23R0101_00025":"{STRVAR_1 3, 1, 0}: I see.\\nYou were trying to be sneaky...\\rHuh!\\nA typical idea of the meek!\\rNo matter.\\nI’ll let you handle this.\\rI have to defeat the Dragon Tamer...\\nWhat’s his name...? Lance!\\rAfter that...it will be your turn.\\nBe ready for it!\\r","msg_0065_D23R0101_00026":"1F Reception\\n2F Sales\\f3F Personnel\\f4F Production\\f5F Director’s Office\\f6F Observation Deck","msg_0065_D23R0101_00027":"Lucky Channel!\\nWin with Pokémon ID numbers!\\rTrade your Pokémon to collect different\\nID numbers!","msg_0065_D23R0101_00028":"This is the Pokémon Lottery Corner.\\nI’m Felicity, your attendant today.\\rIf the drawn number matches the ID No.\\nof any of your Pokémon, you could win\\ffabulous gifts.\\rWould you like to check today’s\\nlucky number? {YESNO 0}","msg_0065_D23R0101_00029":"You’ve already drawn a Loto Ticket\\ntoday. Please come back tomorrow.","msg_0065_D23R0101_00030":"Oh. I see.\\nPlease do visit us again.","msg_0065_D23R0101_00031":"First, I’ll look up today’s Pokémon\\nLottery Corner lucky number.\\r...\\r","msg_0065_D23R0101_00032":"Your Loto Ticket number is {STRVAR_1 54, 0, 0}.\\rNow, let’s see if it matches the\\nID No. of any of your Pokémon.\\r","msg_0065_D23R0101_00033":"Congratulations!\\rThe ID No. of your team’s\\n{STRVAR_1 1, 0, 0} matches your Loto\\fTicket number!\\r","msg_0065_D23R0101_00034":"Congratulations!\\rThe ID No. of your PC-boxed\\n{STRVAR_1 1, 0, 0} matches your Loto\\fTicket number!\\r","msg_0065_D23R0101_00035":"I’m sorry.\\nYou didn’t get a match...","msg_0065_D23R0101_00036":"The last digit matched, so you\\nwin the fourth prize!\\r","msg_0065_D23R0101_00037":"You gained a new Backdrop for use\\nin Fitting Rooms.","msg_0065_D23R0101_00038":"The last two digits matched, so you\\nwin the third prize!\\r","msg_0065_D23R0101_00039":"The last three digits matched, so you\\nwin the second prize!\\r","msg_0065_D23R0101_00040":"The last four digits matched, so you\\nwin the first prize!\\r","msg_0065_D23R0101_00041":"Oh, my goodness, all five digits\\nmatched!\\rYou’ve won the jackpot prize!\\nThis is just so incredible!\\r...Oh, I’m sorry! Your prize!\\nI got carried away there.\\rHere you go!\\r","msg_0065_D23R0101_00042":"...Oh?\\nYou seem to have no room for this.\\rPlease make room in your Bag and\\nthen let me know.","msg_0065_D23R0101_00043":"{STRVAR_1 3, 0, 0}?\\nYes, I’ve been expecting you.\\rThis is the prize we’ve been holding\\nfor you. Here you go!\\r","msg_0065_D23R0101_00044":"Please do visit again!\\nGood-bye from Felicity, your attendant!","msg_0065_D23R0101_00045":"This is the Pokémon Lottery Corner.\\rWould you like to check today’s\\nlucky number again? {YESNO 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_D23R0101_008 + 1"},"constants":{"_EV_scr_seq_D23R0101_000":0,"_EV_scr_seq_D23R0101_001":1,"_EV_scr_seq_D23R0101_002":2,"_EV_scr_seq_D23R0101_003":3,"_EV_scr_seq_D23R0101_004":4,"_EV_scr_seq_D23R0101_005":5,"_EV_scr_seq_D23R0101_006":6,"_EV_scr_seq_D23R0101_007":7,"_EV_scr_seq_D23R0101_008":8,"_EV_scr_seq_D23R0101_009":9,"_EV_scr_seq_D23R0101_010":10,"obj_D23R0101_gswoman6":0,"obj_D23R0101_gswoman6_2":1,"obj_D23R0101_gswoman6_3":2,"obj_D23R0101_gsman1":3,"obj_D23R0101_gsgirl2":4,"obj_D23R0101_gsrivel":5,"obj_D23R0101_rocketm":6,"obj_D23R0101_gsleader3":7}}
