easeAll",[]],["End",[]],["NPCMsg",["msg_0124_D40R0104_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["Wait",["60","VAR_SPECIAL_RESULT"]],["NPCMsg",["msg_0124_D40R0104_00003"]],["CloseMsg",[]],["GetPlayerFacing",["VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfNe",["_0142"]],["ApplyMovement",["obj_D40R0104_bozu","_0168"]],["GoTo",["_014A"]],["ApplyMovement",["obj_D40R0104_bozu","_0154"]],["WaitMovement",[]],["Wait",["30","VAR_SPECIAL_RESULT"]],["End",[]],["FaceSouth",[]],["LockDir",[]],["WalkNormalNorth",[]],["UnlockDir",[]],["EndMovement",[]],["FaceEast",[]],["LockDir",[]],["WalkNormalWest",[]],["UnlockDir",[]],["EndMovement",[]]]},"messages":{"msg_0124_D40R0104_00000":"A long time ago, the Whirl Islands used\\nto be one large island.\\rThere were two countries fighting over\\nthe island back then.\\rLUGIA, the guardian of the island, got\\nupset and cast lightning bolts to tear\\fthe island into four pieces, then\\fdisappeared into the deep end\\fof the waterfall basin...\\rI will let you through if you bring the\\nSilver Wing, which is said to have fallen\\ffrom LUGIA.\\rBut the true challenge is whether\\nLUGIA will appear in front of you.\\rWhat LUGIA has longed for is the\\ninvisible trust between people and\\fPokémon...\\rOr the person who can restore such\\na relationship...","msg_0124_D40R0104_00001":"LUGIA, the Pokémon of the island, hid\\nitself deep in the end of the waterfall\\fbasin, and no one has seen it since...\\rIf anyone who could restore deep trust\\nbetween people and Pokémon were to\\fcome here with something linked to\\fLUGIA, it may show itself for such\\fa person...","msg_0124_D40R0104_00002":"That thing you have...!\\r","msg_0124_D40R0104_00003":"You have found it...\\nPlease go ahead.\\r","msg_0124_D40R0104_00004":"You have found it...\\nPlease go ahead.","msg_0124_D40R0104_00005":"Silver Wing will merely permit you to go\\ndown the waterfall.\\rIf you are not the kind of person who\\nwould restore the trust between people\\fand Pokémon, LUGIA will never show\\fitself to you...","msg_0124_D40R0104_00006":"Hmmm.\\rSo it was you and the Bell!","msg_0124_D40R0104_00007":"You are quite a remarkable Trainer\\nfor your age..."},"initTriggers":[],"initScripts":{"OnResume":"_EV_scr_seq_D40R0104_001 + 1","OnTransition":"_EV_scr_seq_D40R0104_003 + 1"},"constants":{"_EV_scr_seq_D40R0104_000":0,"_EV_scr_seq_D40R0104_001":1,"_EV_scr_seq_D40R0104_002":2,"_EV_scr_seq_D40R0104_003":3,"obj_D40R0104_bozu":0,"obj_D40R0104_monstarball":1,"obj_D40R0104_monstarball_2":2,"obj_D40R0104_monstarball_3":3}}
