SimpleNPCMsg",["msg_0744_W40_00000"]],["End",[]],["SimpleNPCMsg",["msg_0744_W40_00006"]],["End",[]],["SimpleNPCMsg",["msg_0744_W40_00003"]],["End",[]],["SimpleNPCMsg",["msg_0744_W40_00009"]],["End",[]]]},"messages":{"msg_0744_W40_00000":"You have to warm up before going into\\nthe water.\\rThat’s basic.\\n","msg_0744_W40_00001":"","msg_0744_W40_00002":"","msg_0744_W40_00003":"Hey, you’re young and fit!\\nDon’t ride your Pokémon! Swim!\\n","msg_0744_W40_00004":"","msg_0744_W40_00005":"","msg_0744_W40_00006":"Are you going to Cianwood?\\rHow about a quick battle first?\\n","msg_0744_W40_00007":"","msg_0744_W40_00008":"","msg_0744_W40_00009":"No inflatable tube for me.\\nI’m hanging on to a sea Pokémon!\\n","msg_0744_W40_00010":"","msg_0744_W40_00011":"","msg_0744_W40_00012":"You can’t see it from here, but there\\nis a big city called Cianwood\\facross the sea.","msg_0744_W40_00013":"I took the ship to go to Olivine for\\nsome sightseeing. I really liked\\fthe atmosphere.\\rBeing a port, it was nothing like\\nthe big cities.","msg_0744_W40_00014":"Do you know what lies just past\\nthis gate?\\rIt’s the Battle Frontier!\\rEvery time I have a journey, I’ve\\nraised mostly “useful” Pokémon.\\rBut now that I am here, I think I\\nshould have brought my\\f“battle” Pokémon!","msg_0744_W40_00015":"Hey!\\nGreat waves here!\\rNo one can resist such\\ngood waves!\\r","msg_0744_W40_00016":"I see... You don’t have Surf yet...\\nThis is just between you and me...\\rI got Surf from a man at Ecruteak,\\nand I think he’s still there.\\rWhy don’t you try going there?\\r","msg_0744_W40_00017":"This is just between you and me.\\nI got Surf from a man at Ecruteak.\\fI think he’s still there.\\rWhy don’t you try going there?","msg_0744_W40_00018":"Hey!\\nGreat waves here!\\rNo one can resist such\\ngood waves!","msg_0744_W40_00019":"Rt. 40\\nSouth to Cianwood City","msg_0744_W40_00020":"Battle Frontier Ahead"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_W40_000 + 1"},"constants":{"_EV_scr_seq_W40_000":0,"_EV_scr_seq_W40_001":1,"_EV_scr_seq_W40_002":2,"_EV_scr_seq_W40_003":3,"_EV_scr_seq_W40_004":4,"_EV_scr_seq_W40_005":5,"_EV_scr_seq_W40_006":6,"_EV_scr_seq_W40_007":7,"_EV_scr_seq_W40_008":8,"_EV_scr_seq_W40_009":9,"obj_W40_gsswimmerm":0,"obj_W40_gsswimmerw":1,"obj_W40_gsswimmerm_2":2,"obj_W40_gsswimmerw_2":3,"obj_W40_gswoman1":4,"obj_W40_gsmiddleman1":5,"obj_W40_monstarball":6}}
