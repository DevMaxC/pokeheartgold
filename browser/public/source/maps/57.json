reat!\\rLet’s take a picture together! {YESNO 0}","msg_0519_T09_00006":"Blue: All right!\\r","msg_0519_T09_00007":"Blue: Thanks for the nice picture!","msg_0519_T09_00008":"Blue: Oh, well...","msg_0519_T09_00009":"Your Photo Album is full.\\rAccess your PC and delete\\nsome pictures.","msg_0519_T09_00010":"Blaine: I’ll never give up until the \\nday I’ve rebuilt the Cinnabar Gym!\\rWhy not exchange numbers! {YESNO 0}","msg_0519_T09_00011":"{STRVAR_1 3, 0, 0} registered Blaine\\nin the Pokégear!","msg_0519_T09_00012":"Blaine: Hmmm...\\nWe should be able to battle\\fon Tuesday evenings!","msg_0519_T09_00013":"Blaine: Oh...how disappointing!","msg_0519_T09_00014":"Blaine: Do we want to exchange\\nnumbers? {YESNO 0}","msg_0519_T09_00015":"Blaine: Oh, it is you!\\nSay, do you want to take a picture\\fwith me right here? {YESNO 0}","msg_0519_T09_00016":"Blaine: There, stand next to me!\\r","msg_0519_T09_00017":"Blaine: Oh, this is a good picture!","msg_0519_T09_00018":"Blaine: Noooo!","msg_0519_T09_00019":"Your Photo Album is full.\\rAccess your PC to delete\\nsome pictures.","msg_0519_T09_00020":"There is a notice here...\\rThe Cinnabar Gym has relocated\\nto Seafoam Islands.\\f           Blaine","msg_0519_T09_00021":"Cinnabar Island\\nThe Ravaged Town of the Past"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T09_003 + 1"},"constants":{"_EV_scr_seq_T09_000":0,"_EV_scr_seq_T09_001":1,"_EV_scr_seq_T09_002":2,"_EV_scr_seq_T09_003":3,"_EV_scr_seq_T09_004":4,"obj_T09_gsleader16":0,"obj_T09_gsleader15":1,"obj_T09_monstarball":2}}
