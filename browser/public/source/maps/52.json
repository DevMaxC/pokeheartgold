g_0467_T04_00012":"This is...\\nThe notorious Cerulean Cave!\\rHorribly powerful Pokémon live here.\\nOnly those who have defeated all eight\\fKanto Gym Leaders are allowed to\\fchallenge it.","msg_0467_T04_00013":"Cerulean City\\nThe Floral Lagoon City","msg_0467_T04_00014":"Cerulean City Pokémon Gym\\nLeader: Misty\\fThe Tomboyish Mermaid","msg_0467_T04_00015":"Trendsetter of the Bicycle Boom\\rCerulean Bike Main Shop","msg_0467_T04_00016":"There’s a notice here...\\rStamp out thievery and make the city\\na friendlier, more cheerful place!\\fCerulean Police","msg_0467_T04_00017":"Rt. 24 Ahead\\nEast to Cerulean Cape","msg_0467_T04_00018":"It’s locked..."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T04_012 + 1"},"constants":{"_EV_scr_seq_T04_000":0,"_EV_scr_seq_T04_001":1,"_EV_scr_seq_T04_002":2,"_EV_scr_seq_T04_003":3,"_EV_scr_seq_T04_004":4,"_EV_scr_seq_T04_005":5,"_EV_scr_seq_T04_006":6,"_EV_scr_seq_T04_007":7,"_EV_scr_seq_T04_008":8,"_EV_scr_seq_T04_009":9,"_EV_scr_seq_T04_010":10,"_EV_scr_seq_T04_011":11,"_EV_scr_seq_T04_012":12,"_EV_scr_seq_T04_013":13,"obj_T04_gsman1":0,"obj_T04_gswoman1":1,"obj_T04_tsure_poke_static_slowbro":2,"obj_T04_gsbigman":3,"obj_T04_gsman2":4,"obj_T04_gsboy1":5,"obj_T04_gsmiddleman1":6,"obj_T04_gsman1_2":7}}
