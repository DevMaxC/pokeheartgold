"UpdateMoneyBox",[]],["BufferItemName",["0","VAR_SPECIAL_x8001"]],["PlaySE",["SEQ_SE_DP_JIHANKI"]],["BufferItemName",["0","VAR_SPECIAL_x8001"]],["NPCMsg",["msg_0597_T25R1006_00006"]],["GiveItemNoCheck",["VAR_SPECIAL_x8001","1"]],["Random",["VAR_SPECIAL_RESULT","64"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_08A0"]],["PlaySE",["SEQ_SE_DP_JIHANKI"]],["BufferItemName",["0","VAR_SPECIAL_x8001"]],["NPCMsg",["msg_0597_T25R1006_00007"]],["HasSpaceForItem",["VAR_SPECIAL_x8001","1","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfEq",["_08B2"]],["CallStd",["std_give_item_verbose"]],["NPCMsg",["msg_0597_T25R1006_00005"]],["GoTo",["_0717"]],["NPCMsg",["msg_0597_T25R1006_00008"]],["GoTo",["_08BE"]],["CallStd",["std_bag_is_full"]],["CloseMsg",[]],["HideMoneyBox",[]],["ReleaseAll",[]],["End",[]],["WaitButton",[]],["CloseMsg",[]],["HideMoneyBox",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0597_T25R1006_00000":"Do you listen to the radio?\\rWhich shows do you prefer?\\rI like Buena’s Password!\\rWhen I catch it, I take notes so\\nI don’t forget the password.\\rThat’s why my Pokégear is full\\nof scribbles!","msg_0597_T25R1006_00001":"Even Team Rocket would understand\\nhow refreshing it is to listen to the\\fRadio on the rooftop, right?","msg_0597_T25R1006_00002":"If you’re tired, try the Vending\\nMachine’s drinks.\\fYour Pokémon will love them, too.","msg_0597_T25R1006_00003":"Team Rocket...\\rYou should have a drink from the\\nvending machine and take a break.\\rIt’s about time you started thinking\\nof how you want to live your life.","msg_0597_T25R1006_00004":"Take a Break from Shopping!\\n6F Rooftop Atrium","msg_0597_T25R1006_00005":"It’s a vending machine.\\nWhich drink would you like? {YESNO 0}","msg_0597_T25R1006_00006":"Clang!\\rA can of {STRVAR_1 8, 0, 0} dropped down.\\r","msg_0597_T25R1006_00007":"Clang!\\rBonus! Another can of {STRVAR_1 8, 0, 0}\\ndropped down.\\r","msg_0597_T25R1006_00008":"Not enough money...","msg_0597_T25R1006_00009":"Decided not to buy a drink.","msg_0597_T25R1006_00010":"The must-try of the Goldenrod\\nDepartment Store!\\fWelcome to the Daily Drawing Corner!\\rYou can try it for $300, and we have\\nwonderful prizes!\\rWould you like to try it? {YESNO 0}","msg_0597_T25R1006_00011":"All right. Please draw one!\\r...\\n...\\r","msg_0597_T25R1006_00012":"Wow!\\nYou’ve got yourself the no. {STRVAR_1 50, 0, 0} prize!\\rPlease take it.\\r","msg_0597_T25R1006_00013":"","msg_0597_T25R1006_00014":"Oh my...","msg_0597_T25R1006_00015":"Oh my...\\nYour Bag is full.\\rThen we’ll refund you the money.\\r","msg_0597_T25R1006_00016":"Oh my...\\nYou’re short of money.\\rPlease come again.","msg_0597_T25R1006_00017":"Please come again.","msg_0597_T25R1006_00018":"Sunday’s prizes will be:\\rNo. 1, TM02!\\nNo. 2, Luxury Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00019":"Monday’s prizes will be:\\rNo. 1, TM65!\\nNo. 2, Nest Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00020":"Tuesday’s prizes will be:\\rNo. 1, TM91!\\nNo. 2, Repeat Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00021":"Wednesday’s prizes will be:\\rNo. 1, TM57!\\nNo. 2, Net Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00022":"Thursday’s prizes will be:\\rNo. 1, TM60!\\nNo. 2, Quick Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00023":"Friday’s prizes will be:\\rNo. 1, TM42!\\nNo. 2, Dusk Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00024":"Saturday’s prizes will be:\\rNo. 1, TM62!\\nNo. 2, Timer Ball!\\fOr No. 3, a Berry!","msg_0597_T25R1006_00025":"Whitney: What a coincidence!\\nThis must be meant to be.\\rDo you want to exchange\\nphone numbers? Please? {YESNO 0}","msg_0597_T25R1006_00026":"{STRVAR_1 3, 0, 0} registered Whitney\\nin the Pokégear!","msg_0597_T25R1006_00027":"Whitney: I’m available around noon\\non Saturdays.\\rGive me a call when you’ve got time.","msg_0597_T25R1006_00028":"Whitney: Don’t be so mean.","msg_0597_T25R1006_00029":"Whitney: Do you want to know\\nmy phone number now? {YESNO 0}","msg_0597_T25R1006_00030":"Whitney: Why don’t we take a\\npicture together? {YESNO 0}","msg_0597_T25R1006_00031":"Whitney: OK!\\nStand right next to me, right here!\\r","msg_0597_T25R1006_00032":"Whitney: Don’t we look good together?","msg_0597_T25R1006_00033":"Whitney: That’s a shame!","msg_0597_T25R1006_00034":"Your Photo Album is full.\\rAccess your PC to delete\\nsome pictures."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T25R1006_006 + 1"},"constants":{"_EV_scr_seq_T25R1006_000":0,"_EV_scr_seq_T25R1006_001":1,"_EV_scr_seq_T25R1006_002":2,"_EV_scr_seq_T25R1006_003":3,"_EV_scr_seq_T25R1006_004":4,"_EV_scr_seq_T25R1006_005":5,"_EV_scr_seq_T25R1006_006":6,"_EV_scr_seq_T25R1006_007":7,"obj_T25R1006_gsman1":0,"obj_T25R1006_gsgirl2":1,"obj_T25R1006_gswoman6":2,"obj_T25R1006_gsleader3":3,"obj_T25R1006_gswoman6_2":4}}
