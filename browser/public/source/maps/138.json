]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_MINERAL","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfNe",["_0536"]],["NPCMsg",["msg_0606_T26GYM0101_00022"]],["GoTo",["_0539"]],["NPCMsg",["msg_0606_T26GYM0101_00021"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["Compare",["VAR_UNK_410E","2"]],["GoToIfNe",["_0552"]],["SetVar",["VAR_UNK_410E","3"]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_MINERAL","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0590"]],["Compare",["VAR_UNK_410E","0"]],["GoToIfNe",["_0585"]],["NPCMsg",["msg_0606_T26GYM0101_00016"]],["GoTo",["_0588"]],["NPCMsg",["msg_0606_T26GYM0101_00017"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0606_T26GYM0101_00018"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_MINERAL","VAR_SPECIAL_RESULT"]],["BufferPlayersName",["0"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_05C2"]],["NPCMsg",["msg_0606_T26GYM0101_00023"]],["GoTo",["_05C5"]],["NPCMsg",["msg_0606_T26GYM0101_00024"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0606_T26GYM0101_00000":"Jasmine: Thank you for your help\\nat the Lighthouse...\\rBut this is different. Please allow me to\\nintroduce myself.\\rI am Jasmine, a Gym Leader.\\nI use the...clang!\\fSteel type!\\r...Do you know about the Steel type?\\rThey are very hard, cold, sharp,\\nand really strong!\\fUm... I’m not lying.\\r","msg_0606_T26GYM0101_00001":"Jasmine: ...You are a better Trainer\\nthan me, in both skill and kindness.\\rIn accordance with League rules,\\nI confer upon you this Badge.\\r","msg_0606_T26GYM0101_00002":"{STRVAR_1 3, 0, 0} received\\nthe Mineral Badge from Jasmine!","msg_0606_T26GYM0101_00003":"Jasmine: With that Badge,\\nall Pokémon, including traded\\fPokémon up to Lv. 70, will obey\\fyou without question.\\fUm... Please take this, too...\\r","msg_0606_T26GYM0101_00004":"","msg_0606_T26GYM0101_00005":"Jasmine: It is called Iron Tail...\\rYour Pokémon will hit the target\\nwith its hard tail, occasionally\\flowering the target’s Defense...","msg_0606_T26GYM0101_00006":"Jasmine: Um...\\rI don’t know how to say this, but\\ngood luck...","msg_0606_T26GYM0101_00007":"Jasmine: Long time, no see.\\rUm... I’m fine, thank you.\\rI don’t know how to say this,\\nbut...nothing...","msg_0606_T26GYM0101_00008":"Jasmine: Um... Er...\\rWill you trade your Pokémon\\nfor mine? {YESNO 0}","msg_0606_T26GYM0101_00009":"Jasmine: Really? Thank you very much!\\rI’ll be happy with any Pokémon!\\r","msg_0606_T26GYM0101_00010":"Jasmine: Oh, uh-huh, I see.\\nThat’s disappointing, but I understand.","msg_0606_T26GYM0101_00011":"Jasmine: Thank you so much.\\nI’ll take good care of it.","msg_0606_T26GYM0101_00012":"Jasmine: Don’t you sometimes feel like\\nscrubbing Steel-type Pokémon?\\fDon’t you?","msg_0606_T26GYM0101_00013":"Will you trade {STRVAR_1 1, 1, 0}? {YESNO 0}","msg_0606_T26GYM0101_00014":"Jasmine: I like Eggs, too, but\\nI’d like a Pokémon, {STRVAR_1 3, 0, 0}.\\fOne that might have a little training...","msg_0606_T26GYM0101_00015":"Jasmine: I’d appreciate it so much...\\nExcept that I cannot accept such\\fa precious Pokémon.","msg_0606_T26GYM0101_00016":"Jasmine, the Gym Leader?\\nShe’s at the Lighthouse.\\rShe’s been tending to a sick Pokémon.\\rA strong Trainer is compassionate\\nat the same time...","msg_0606_T26GYM0101_00017":"Jasmine uses Steel-type Pokémon.\\rShe’s trying to hide her tenderness\\nbehind her steely coldness.","msg_0606_T26GYM0101_00018":"That was awesome.\\fThe Steel type, huh?\\fThat was one heated battle you had!","msg_0606_T26GYM0101_00019":"I knew you’d come here.\\rThank you for helping the Gym Leader,\\nbut battle is a separate matter.\\rGo for it!","msg_0606_T26GYM0101_00020":"Impressive!\\rYou should continue your journey to\\ndifferent places.\\rSince you can use Surf, why don’t you\\ntry it on the Lake of Rage?","msg_0606_T26GYM0101_00021":"Giggle...\\rI know how capable you are\\nfrom the Lighthouse.\\rIt’s time you showed that side of\\nyourself to Jasmine! Good luck!","msg_0606_T26GYM0101_00022":"You are amazing...\\rYou should aim even higher, since\\nyou have such potential.\\rHave you been to Mahogany Town?","msg_0606_T26GYM0101_00023":"Olivine City Pokémon Gym","msg_0606_T26GYM0101_00024":"Olivine City Pokémon Gym\\rLeader: Jasmine\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T26GYM0101_007 + 1"},"constants":{"_EV_scr_seq_T26GYM0101_000":0,"_EV_scr_seq_T26GYM0101_001":1,"_EV_scr_seq_T26GYM0101_002":2,"_EV_scr_seq_T26GYM0101_003":3,"_EV_scr_seq_T26GYM0101_004":4,"_EV_scr_seq_T26GYM0101_005":5,"_EV_scr_seq_T26GYM0101_006":6,"_EV_scr_seq_T26GYM0101_007":7,"obj_T26GYM0101_gsleader6":0,"obj_T26GYM0101_gsgirl1":1,"obj_T26GYM0101_gsgentleman":2,"obj_T26GYM0101_sunglasses":3}}
