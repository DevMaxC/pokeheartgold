lkOnSpotNormalWest",[]],["Delay8",[]],["WalkOnSpotNormalEast",[]],["Delay8",[]],["EndMovement",[]],["WalkNormalSouth",[]],["EndMovement",[]],["WalkOnSpotFastEast",["4"]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["Compare",["VAR_UNK_40FE","4"]],["GoToIfGe",["_0404"]],["NPCMsg",["msg_0131_D45R0102_00020"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0131_D45R0102_00021"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0131_D45R0102_00000":"...\\rI don’t know why you have come here.\\rAnyway, I have to warn you that\\nthis is not a place for kids like you.\\r","msg_0131_D45R0102_00001":"You have a certain look...\\rIt reminds me of the kid who stood in\\nfront of me three years ago...\\fYou have the same eyes...\\r...\\rI’m on my way to Goldenrod City to\\nanswer the call and join my team.\\fAre you going to get in my way?\\r","msg_0131_D45R0102_00002":"...\\nThis is the Radio Tower.\\fThis is the Radio Tower.\\fWe are pleased to declare\\fTeam Rocket’s revival.\\f...Giovanni?\\f...Can you hear us?\\fWe have finally made it!\\f...\\r","msg_0131_D45R0102_00003":"My old associates need me...\\rWe will not repeat the failure of three\\nyears ago!\\r{COLOR 1}Team Rocket{COLOR 0} will be born again, and I\\nwill rule the world!\\r","msg_0131_D45R0102_00004":"Giovanni: How is this possible...?\\rThe past three years have been\\na waste...?\\rHow can a kid like you manage to\\ndestroy my dream once again?\\rThe precious dream of Team Rocket has\\nbecome little more than an illusion...\\r","msg_0131_D45R0102_00005":"...\\n...Hey!\\fWhere has Giovanni gone?\\fI wonder if he is listening to\\four broadcast...\\f...\\r","msg_0131_D45R0102_00006":"Giovanni: Mark my words.\\rNot being able to measure your own\\nstrength shows that you are still\\fbut a child.\\r","msg_0131_D45R0102_00007":"Ethan: Huh?\\rThat’s the guy we just saw arguing with\\nthat boy!\\r","msg_0131_D45R0102_00008":"Lyra: Huh?\\rThat’s the guy we just saw arguing with\\nthat boy!\\r","msg_0131_D45R0102_00009":"Ethan: Three years ago...?\\nGoldenrod City...?\\r","msg_0131_D45R0102_00010":"Lyra: Three years ago...?\\nGoldenrod City...?\\r","msg_0131_D45R0102_00011":"Could this be the one that the radio\\nwas trying to reach?\\fGiovanni, their boss?\\r","msg_0131_D45R0102_00012":"Could this be the one that the radio\\nwas trying to reach?\\fGiovanni, their boss?\\r","msg_0131_D45R0102_00013":"Do you hear it, {STRVAR_1 3, 0, 0}?\\nThe radio is saying something strange!\\rTeam Rocket has occupied the Radio\\nTower at Goldenrod City!\\rIt can’t be! {STRVAR_1 3, 0, 0}, you solved\\nthis case already!\\r","msg_0131_D45R0102_00014":"Do you hear it, {STRVAR_1 3, 0, 0}?\\nThe radio is saying something strange!\\rTeam Rocket has occupied the Radio\\nTower at Goldenrod City!\\rIt can’t be! {STRVAR_1 3, 0, 0}, you solved\\nthis case already!\\r","msg_0131_D45R0102_00015":"Ethan: They keep calling for their boss.\\nI feel sorry they don’t know he’s\\fnot coming.\\rAfter this, {STRVAR_1 3, 0, 0}, you will\\ndefeat them!\\r...Wait a second!\\r{STRVAR_1 3, 0, 0}, you’re still here.\\nThen, who will defeat Team Rocket...?\\r","msg_0131_D45R0102_00016":"Lyra: They keep calling for their boss.\\nI feel sorry they don’t know he’s\\fnot coming.\\rAfter this, {STRVAR_1 3, 0, 0}, you will\\ndefeat them!\\r...Wait a second!\\r{STRVAR_1 3, 0, 0}, you’re still here.\\nThen, who will defeat Team Rocket...?\\r","msg_0131_D45R0102_00017":"Not again...!\\nI’ve had enough!\\fPlease let me go back to my time!\\r","msg_0131_D45R0102_00018":"Not again...!\\nI’ve had enough!\\fPlease let me go back to my time!\\r","msg_0131_D45R0102_00019":"CELEBI is traveling through time!\\nIt is going back to the time before\\fthis strange adventure began...\\r","msg_0131_D45R0102_00020":"There is a radio that no longer works...","msg_0131_D45R0102_00021":"You cannot turn on the radio.\\nGiovanni must have left it here...","msg_0131_D45R0102_00022":"CELEBI...!\\rWe need it to get better, or we will\\nnever be able to go back to our time!\\r","msg_0131_D45R0102_00023":"CELEBI...!\\rWe need it to get better, or we will\\nnever be able to go back to our time!\\r","msg_0131_D45R0102_00024":"Ethan used Max Revive on CELEBI!\\r","msg_0131_D45R0102_00025":"Lyra used Max Revive on CELEBI!\\r","msg_0131_D45R0102_00026":"{COLOR 1}Time Travel{COLOR 0}......!\\rThis is it! Please take us to our time!\\r","msg_0131_D45R0102_00027":"{COLOR 1}Time Travel{COLOR 0}......!\\rThis is it! Please take us to our time!\\r"},"initTriggers":[{"var":"VAR_UNK_40FE","value":2,"script":"_EV_scr_seq_D45R0102_001 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_D45R0102_000 + 1","OnLoad":"_EV_scr_seq_D45R0102_002 + 1"},"constants":{"_EV_scr_seq_D45R0102_000":0,"_EV_scr_seq_D45R0102_001":1,"_EV_scr_seq_D45R0102_002":2,"_EV_scr_seq_D45R0102_003":3,"obj_D45R0102_breakrock":0,"obj_D45R0102_breakrock_2":1,"obj_D45R0102_breakrock_3":2,"obj_D45R0102_breakrock_4":3,"obj_D45R0102_sakaki":4,"obj_D45R0102_var_1":5}}
