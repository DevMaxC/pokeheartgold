["WalkNormalEast",["7"]],["WalkNormalNorth",["2"]],["EndMovement",[]],["WalkNormalNorth",[]],["EndMovement",[]],["TrainerTipsEx",["2","msg_0145_D51R0101_00007"]],["End",[]]]},"messages":{"msg_0145_D51R0101_00000":"Well, hello!\\rIt’s so freezing, isn’t it?\\rFor a youngster like you to be\\ninterested in the Sinjoh Ruins is\\fnot something we see every day.\\rTake a look at them.\\rFrom the design of the pillars at the\\nSinjoh Ruins, you can see that the\\fcultures of Sinnoh and Johto\\fhave blended.\\r","msg_0145_D51R0101_00001":"What was I thinking?\\rWe don’t need to be standing here.\\nWhy don’t you come to the cabin\\faround the corner for more discussion?\\r","msg_0145_D51R0101_00002":"By the way, we happen to have a person\\nat the cabin.\\rAny Trainer should know who she is.\\nThe famous Trainer from Sinnoh!\\rShe is traveling around to study\\nmyths and ancient ruins.\\fIsn’t that something?\\r","msg_0145_D51R0101_00003":"","msg_0145_D51R0101_00004":"Cynthia: Bring your ARCEUS only.\\rOther Pokémon may get blown away by\\nthe strong power lingering at\\fthe ruins.\\r","msg_0145_D51R0101_00005":"Cynthia: It seems your ARCEUS is\\nresonating in harmony with the Ruins.\\rIt might just be me but I can\\nfeel that...\\fwe are surrounded by strong power.\\rThe answer lies inside the ruins.\\rThe place that has been waiting for\\nits rightful owner, the {COLOR 1}Mystri Stage{COLOR 0}...\\r","msg_0145_D51R0101_00006":"","msg_0145_D51R0101_00007":"The Sinjoh Ruins"},"initTriggers":[{"var":"VAR_SCENE_SINJOH_MYSTRI_ROOM","value":4,"script":"_EV_scr_seq_D51R0101_000 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_D51R0101_002 + 1"},"constants":{"_EV_scr_seq_D51R0101_000":0,"_EV_scr_seq_D51R0101_001":1,"_EV_scr_seq_D51R0101_002":2,"_EV_scr_seq_D51R0101_003":3,"obj_D51R0101_mount_2":0}}
