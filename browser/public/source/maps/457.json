ovement",[]],["WalkNormalSouth",[]],["FaceNorth",[]],["EndMovement",[]],["WalkNormalNorth",[]],["FaceSouth",[]],["EndMovement",[]],["WalkNormalWest",[]],["FaceEast",[]],["EndMovement",[]],["WalkNormalEast",[]],["FaceWest",[]],["EndMovement",[]],["WalkNormalWest",[]],["FaceEast",[]],["EndMovement",[]],["WalkNormalEast",[]],["FaceWest",[]],["EndMovement",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_VOLCANO","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_04B6"]],["NPCMsg",["msg_0053_D11R0106_00024"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0053_D11R0106_00025"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0053_D11R0106_00000":"Blaine: Hey, you!\\rMy Gym on Cinnabar Island was burned\\ndown by the eruption!\\rBut I will not give up!\\nTake a look at this cave.\\rWe have turned it into a Gym, and I am\\nstill acting as a Gym Leader!\\rI will give you the Gym Badge\\nif you manage to defeat me!\\rAre you ready? Here we go!\\r","msg_0053_D11R0106_00001":"Blaine: Awesome. I have burned out...\\fTake this Volcano Badge!\\r","msg_0053_D11R0106_00002":"{STRVAR_1 3, 0, 0} received\\nthe Volcano Badge from Blaine!","msg_0053_D11R0106_00003":"Blaine: Here, I will give you this, too.\\nIt’s called Overheat!\\rIt has a slight drawback, but it’s\\npowerful and well worth it!\\r","msg_0053_D11R0106_00004":"Blaine: I did lose this time, but I’m\\ngoing to win next time.\\rWhen I rebuild my Cinnabar Gym,\\nwe have to hold a rematch.","msg_0053_D11R0106_00005":"Blaine: My Fire-type Pokémon will be\\neven stronger! Just you watch!","msg_0053_D11R0106_00006":"Wow, to see a Gym in a cave like this?\\nI’d love to explore it.\\r","msg_0053_D11R0106_00007":"Bitterness leads to improvement\\ntomorrow.","msg_0053_D11R0106_00008":"Bitterness leads to improvement\\ntomorrow.\\r","msg_0053_D11R0106_00009":"I am in the middle of collecting\\nbattle records.\\rCan you help me?\\r","msg_0053_D11R0106_00010":"I didn’t expect you to be so good!\\nWho in the world are you?","msg_0053_D11R0106_00011":"I didn’t expect you to be so good!\\nWho in the world are you?\\r","msg_0053_D11R0106_00012":"Ooh!\\nYou look easily defeated!\\r","msg_0053_D11R0106_00013":"Pardon me!\\nI failed to sense how strong you are.","msg_0053_D11R0106_00014":"Pardon me!\\nI failed to sense how strong you are.\\r","msg_0053_D11R0106_00015":"A white lab coat is a researcher’s life.\\nWe may be living in a cave like this, but\\fwe never forget to do the laundry.\\r","msg_0053_D11R0106_00016":"This white lab coat makes me feel like I\\nhave become smarter for some reason.","msg_0053_D11R0106_00017":"This white lab coat makes me feel like I\\nhave become smarter for some reason.\\r","msg_0053_D11R0106_00018":"Blaine may have lost his Gym, but he\\nnever gives up. His perseverance\\fis what motivates me!\\r","msg_0053_D11R0106_00019":"Together with Blaine, we will rebuild\\nour Gym!","msg_0053_D11R0106_00020":"Together with Blaine, we will rebuild\\nour Gym!\\r","msg_0053_D11R0106_00021":"We lost the Gym on Cinnabar Island and\\nfelt lost before we came here.\\r","msg_0053_D11R0106_00022":"We take a step back when we are\\ndefeated...\\rDon’t you think we are downright\\nhonest?\\rNever put us in the same category as\\nScientists who help bad guys.","msg_0053_D11R0106_00023":"We take a step back when we are\\ndefeated...\\rDon’t you think we are downright\\nhonest?\\rNever put us in the same category as\\nScientists who help bad guys.\\r","msg_0053_D11R0106_00024":"Yo! Legend in the making!\\rThis Gym has many Trainers and rocks\\nin the way from the rebuilding.\\fIt sure won’t be easy to get to Blaine!\\rBut keep your cool and defeat the\\nTrainers one by one, and you will surely\\ffind the path!","msg_0053_D11R0106_00025":"The Gym Leader rebuilding his Gym and\\nthe Trainer from Johto who has come to\\fchallenge that Gym Leader...\\rI have witnessed a hot battle!"},"initTriggers":[],"initScripts":{"OnResume":"_EV_scr_seq_D11R0106_008 + 1","OnTransition":"_EV_scr_seq_D11R0106_009 + 1"},"constants":{"_EV_scr_seq_D11R0106_000":0,"_EV_scr_seq_D11R0106_001":1,"_EV_scr_seq_D11R0106_002":2,"_EV_scr_seq_D11R0106_003":3,"_EV_scr_seq_D11R0106_004":4,"_EV_scr_seq_D11R0106_005":5,"_EV_scr_seq_D11R0106_006":6,"_EV_scr_seq_D11R0106_007":7,"_EV_scr_seq_D11R0106_008":8,"_EV_scr_seq_D11R0106_009":9,"obj_D11R0106_gsleader15":0,"obj_D11R0106_sunglasses":1,"obj_D11R0106_assistantm":2,"obj_D11R0106_assistantm_2":3,"obj_D11R0106_assistantm_3":4,"obj_D11R0106_gsassistantm":5,"obj_D11R0106_gsassistantm_2":6,"obj_D11R0106_gsassistantm_3":7}}
