s.","msg_0462_T03GYM0101_00007":"Yo! Legend in the making! That Gym\\ndidn’t give you much trouble.\\rThe way you took charge was\\nreally inspiring.\\fI mean that seriously.","msg_0462_T03GYM0101_00008":"Pewter City Pokémon Gym","msg_0462_T03GYM0101_00009":"Pewter City Pokémon Gym\\rLeader: Brock\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T03GYM0101_003 + 1"},"constants":{"_EV_scr_seq_T03GYM0101_000":0,"_EV_scr_seq_T03GYM0101_001":1,"_EV_scr_seq_T03GYM0101_002":2,"_EV_scr_seq_T03GYM0101_003":3,"obj_T03GYM0101_sunglasses":0,"obj_T03GYM0101_gsleader14":1,"obj_T03GYM0101_campboy_2":2,"obj_T03GYM0101_mount_2":3}}
