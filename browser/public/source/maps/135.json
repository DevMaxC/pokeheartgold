],["End",[]],["CallStd",["std_bag_is_full"]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["GoToIfUnset",["FLAG_GOT_TM51_FROM_FALKNER","_0126"]],["NPCMsg",["msg_0558_T22GYM0101_00005"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["WhiteOut",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_ZEPHYR","VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_01AA"]],["NPCMsg",["msg_0558_T22GYM0101_00007"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0558_T22GYM0101_00008"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SimpleNPCMsg",["msg_0558_T22GYM0101_00006"]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["CheckBadge",["BADGE_ZEPHYR","VAR_SPECIAL_RESULT"]],["BufferPlayersName",["0"]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfNe",["_01EF"]],["NPCMsg",["msg_0558_T22GYM0101_00009"]],["GoTo",["_01F2"]],["NPCMsg",["msg_0558_T22GYM0101_00010"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["SetVar",["VAR_TEMP_x4000","0"]],["VioletGymElevator",[]],["End",[]]]},"messages":{"msg_0558_T22GYM0101_00000":"Falkner: I’m Falkner, the Violet City\\nPokémon Gym Leader!\\rPeople say you can clip Flying-type\\nPokémon’s wings with a jolt\\fof electricity...\\rI won’t allow such insults to bird\\nPokémon!\\rI’ll show you the real power of the\\nmagnificent bird Pokémon!\\r","msg_0558_T22GYM0101_00001":"Falkner: ...For pity’s sake!\\nMy dad’s cherished bird Pokémon...\\rBut a defeat is a defeat.\\nAll right.\\rTake this official Pokémon\\nLeague Badge.\\fThis one is the Zephyr Badge.\\r","msg_0558_T22GYM0101_00002":"{STRVAR_1 3, 0, 0} received\\nthe Zephyr Badge from Falkner!","msg_0558_T22GYM0101_00003":"Falkner: With that Badge, Pokémon,\\nincluding traded Pokémon up to Lv. 20,\\fwill obey you without question.\\rIt also enables you to use the hidden\\nmove Rock Smash anytime outside\\fof battle.\\r","msg_0558_T22GYM0101_00004":"Falkner: By using a TM, a Pokémon will\\ninstantly learn a new move.\\rThink before you act--a TM can be\\nused only once.\\rTM51 contains Roost.\\nIt restores half the max HP.\\rThere are Pokémon Gyms in cities and\\ntowns ahead. Make good use of them!\\rAs for your next move...\\fI would suggest Azalea Town.","msg_0558_T22GYM0101_00005":"Falkner: There are Pokémon Gyms in\\ncities and towns ahead.\\rYou should test your skills at\\nthese Gyms.\\rAs for your next move...\\fI would suggest Azalea Town.\\rI’m going to train harder to become\\nthe greatest Bird Keeper of all!","msg_0558_T22GYM0101_00006":"Yo! Champ in the making!\\nYou must be here to challenge\\fFalkner, the Gym Leader, right?\\rYou are quite welcome.\\n...Almost!\\rThis city has a tower called the\\nSprout Tower where Trainers\\fcome to train themselves.\\rChallenging Falkner may be too\\ndifficult if you haven’t gone through\\ftheir training.\\fHa ha ha!","msg_0558_T22GYM0101_00007":"Yo, Champ in the making!\\nI’m no Trainer, but I can give\\fsome advice!\\fBelieve me!\\fIf you believe, then a Championship\\fdream can come true.\\rYou believe?\\nThen listen.\\rThe Grass type is weak against the\\nFlying type. Keep this in mind.","msg_0558_T22GYM0101_00008":"Nice battle! Keep it up, and you’ll\\nbe the Champ in no time at all!","msg_0558_T22GYM0101_00009":"Violet City Pokémon Gym","msg_0558_T22GYM0101_00010":"Violet City Pokémon Gym\\rGym Leader: Falkner\\nCertified Trainer!\\f{STRVAR_1 3, 0, 0}"},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T22GYM0101_000 + 1"},"constants":{"_EV_scr_seq_T22GYM0101_000":0,"_EV_scr_seq_T22GYM0101_001":1,"_EV_scr_seq_T22GYM0101_002":2,"_EV_scr_seq_T22GYM0101_003":3,"_EV_scr_seq_T22GYM0101_004":4,"_EV_scr_seq_T22GYM0101_005":5,"obj_T22GYM0101_gsleader1":0,"obj_T22GYM0101_gsman2":1,"obj_T22GYM0101_gsman2_2":2,"obj_T22GYM0101_sunglasses":3,"obj_T22GYM0101_sunglasses_2":4}}
