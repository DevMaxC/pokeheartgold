],["NPCMsg",["msg_0622_T28GYM0101_00006"]],["TouchscreenMenuHide",[]],["GetMenuChoice",["VAR_SPECIAL_RESULT"]],["TouchscreenMenuShow",[]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_01F9"]],["PhotoAlbumIsFull",["VAR_SPECIAL_RESULT"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0204"]],["NPCMsg",["msg_0622_T28GYM0101_00007"]],["CloseMsg",[]],["SetFlag",["FLAG_UNK_189"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["CameronPhoto",["40"]],["FacePlayer",[]],["LockAll",[]],["FadeScreen",["6","1","1","RGB_BLACK"]],["WaitFade",[]],["ClearFlag",["FLAG_UNK_189"]],["NPCMsg",["msg_0622_T28GYM0101_00008"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0622_T28GYM0101_00009"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0622_T28GYM0101_00010"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0622_T28GYM0101_00000":"Pryce: Pokémon have many experiences\\nin their lives, just like we do.\\rI, too, have seen and suffered much in\\nmy life.\\rSince I am your elder, let me show you\\nwhat I mean.\\rI have been training Pokémon since\\nbefore you were born.\\rI do not lose easily.\\nI, Pryce--the Winter Trainer--\\fshall demonstrate my power!\\r","msg_0622_T28GYM0101_00001":"Pryce: I am impressed by your prowess.\\rWith your strong will, I know you\\nwill overcome all life’s obstacles.\\fYou are worthy of this Badge!\\r","msg_0622_T28GYM0101_00002":"{STRVAR_1 3, 0, 0} received\\nthe Glacier Badge from Pryce!","msg_0622_T28GYM0101_00003":"Pryce: That Badge will raise the Special\\nstats of Pokémon.\\rIt also lets your Pokémon use\\nWhirlpool to get across\\freal whirlpools.\\rAnd this... This is a gift from me!\\r","msg_0622_T28GYM0101_00004":"Pryce: That TM contains Hail.\\rIt summons a hailstorm that lasts for\\nfive turns. The hailstorm damages\\fall types except Ice.","msg_0622_T28GYM0101_00005":"Pryce: When the ice and snow melt,\\nspring arrives.\\rYou and your Pokémon will be together\\nfor many years to come.\\fCherish your time together!","msg_0622_T28GYM0101_00006":"Pryce: It is you...\\rSince you are here, why don’t we\\ntake a picture together? {YESNO 0}","msg_0622_T28GYM0101_00007":"Pryce: I have advice to give you before\\nwe take the picture.\\rBreathe in and relax first.\\nThen slowly begin to smile.\\fAre you ready?\\r","msg_0622_T28GYM0101_00008":"Pryce: Let’s see...\\nDid we get a good one?","msg_0622_T28GYM0101_00009":"Pryce: That’s OK, too.\\nSuit yourself.","msg_0622_T28GYM0101_00010":"Your Photo Album is full.\\rAccess your PC to delete\\nsome pictures."},"initTriggers":[],"initScripts":{"OnTransition":"_EV_scr_seq_T28GYM0101_001 + 1"},"constants":{"_EV_scr_seq_T28GYM0101_000":0,"_EV_scr_seq_T28GYM0101_001":1,"obj_T28GYM0101_gsleader7":0,"obj_T28GYM0101_ice":1,"obj_T28GYM0101_ice_2":2,"obj_T28GYM0101_boarder":3,"obj_T28GYM0101_boarder_2":4,"obj_T28GYM0101_ice_3":5,"obj_T28GYM0101_skierw":6}}
