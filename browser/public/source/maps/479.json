["Return",[]],["SetVar",["VAR_SPECIAL_x8006","149"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","150"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","151"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","152"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","153"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","154"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","155"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","156"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","159"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","160"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","161"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","162"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","163"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","164"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","165"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","166"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","167"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","168"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","157"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","158"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","169"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","170"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","171"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","172"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","173"]],["Return",[]],["SetVar",["VAR_SPECIAL_x8006","174"]],["Return",[]]]},"messages":{"msg_0516_T08R0201_00000":"Welcome to the Pal Park!\\rThis is where top-notch Trainers who\\naren’t satisfied with the Safari Zone\\fcome to show their Pokémon-catching\\ftechniques to their peers.\\r...Oh?\\rAre you maybe...\\nAh, you are {STRVAR_1 3, 0, 0}!\\rMy dad told me about you!\\nWord is, you’re a hotshot Trainer!\\rWe’d be honored if you would\\nparticipate in our Catching Shows. {YESNO 0}","msg_0516_T08R0201_00001":"Welcome to the Pal Park!\\rThis is where top-notch Trainers who\\naren’t satisfied with the Safari Zone\\fcome to show their Pokémon-catching\\ftechniques to their peers.\\r...Oh?\\rAre you maybe...\\nAh, you are {STRVAR_1 3, 0, 0}!\\rMy dad told me about you!\\nWord is, you’re a hotshot Trainer!\\rWe’d be honored if you would\\nparticipate in our Catching Shows. {YESNO 0}","msg_0516_T08R0201_00002":"Yes! You agreed to participate!\\nLet’s not waste any time!\\rLet me explain how Pal Park works.\\nWhat should I explain? {YESNO 0}","msg_0516_T08R0201_00003":"Pal Park is a place where you are\\ntimed on the catching of six Pokémon.\\rYou are provided with six special\\nPoké Balls for the challenge.\\rParticipating Trainers are required to\\nsupply the six Pokémon that are to\\fbe caught.\\rIf you do not supply the stock of six\\nPokémon, you may not participate in\\fthe Catching Show.\\r...Would you like to know\\nanything else? {YESNO 0}","msg_0516_T08R0201_00004":"At the start of the Catching Show,\\nyou will be given six Park Balls.\\rUse the Park Balls to catch the\\nsix Pokémon you provide.\\r...Would you like to know\\nanything else? {YESNO 0}","msg_0516_T08R0201_00005":"Insert a Game Boy Advance Pokémon\\nRuby, Sapphire, Emerald, FireRed,\\for LeafGreen in the Game Pak slot.\\rSix of the currently caught Pokémon\\ncan migrate from the Game Pak to the\\fDS Game Card when your DS is turned on\\fand you select “MIGRATE FROM...”\\rPlease note that you cannot insert a\\nGBA Game Pak into a Nintendo DSi\\fto migrate.\\r...Would you like to know\\nanything else? {YESNO 0}","msg_0516_T08R0201_00006":"Would you like to take part in\\na Catching Show now? {YESNO 0}","msg_0516_T08R0201_00007":"Aww, that’s too bad.\\rWell, just give me a shout again\\nif you’d like to participate.","msg_0516_T08R0201_00008":"Hi there, {STRVAR_1 3, 0, 0}!\\rDid you come to participate in\\na Catching Show? {YESNO 0}","msg_0516_T08R0201_00009":"Hi there, {STRVAR_1 3, 0, 0}!\\rDid you come to participate in\\na Catching Show? {YESNO 0}","msg_0516_T08R0201_00010":"OK, here are your Park Balls!\\r{STRVAR_1 3, 0, 0} received\\nsix Park Balls.\\rThe current record holder is\\n{STRVAR_1 3, 1, 0} with {STRVAR_1 53, 2, 0} points.\\rOK, off you go, {STRVAR_1 3, 0, 0}.\\rDazzle us with a masterful display\\nof Pokémon catching!\\r","msg_0516_T08R0201_00011":"OK, here are your Park Balls!\\r{STRVAR_1 3, 0, 0} received\\nsix Park Balls.\\rThe current record holder is\\n{STRVAR_1 3, 1, 0} with {STRVAR_1 53, 2, 0} points.\\rOK, off you go, {STRVAR_1 3, 0, 0}.\\rDazzle us with a masterful display\\nof Pokémon catching!\\r","msg_0516_T08R0201_00012":"Oh, hold on. You don’t have enough\\nPokémon for a Catching Show.\\rYou’ll need to stock us with six\\nPokémon to participate.\\rYou should make some Pokémon migrate\\nfrom Hoenn or another region!","msg_0516_T08R0201_00013":"Yes! You agreed to participate!\\nLet’s not waste any time!\\rLet me explain how Pal Park works.\\nWhat should I explain? {YESNO 0}","msg_0516_T08R0201_00014":"I’m sorry you had to retire.\\nI’ll take what Park Balls you\\fhave left.\\rNext time, please do stay to catch\\nall six Pokémon.","msg_0516_T08R0201_00015":"Oh, your PC Boxes are filled. You\\nhave no room for six more Pokémon.\\rYou won’t be able to accept them,\\neven if you do catch them.\\rMake enough room in a PC Box and\\ncome back for your Catching Show.","msg_0516_T08R0201_00016":"Congratulations!\\nThat’s all six Pokémon caught!\\rThe audience sure enjoyed watching\\nyour Catching Show.\\rAll right, let’s see your all-important\\nscore from this show!\\r...\\n...\\rCatching Points: {STRVAR_1 53, 0, 0}!\\rTime Points: {STRVAR_1 53, 1, 0}!\\rType Points: {STRVAR_1 53, 2, 0}!\\rThe total is...\\r...\\n...\\r{STRVAR_1 53, 3, 0} points!\\r","msg_0516_T08R0201_00017":"Wow! That’s an outstanding record!\\nKudos to you!\\r","msg_0516_T08R0201_00018":"Good! That’s a decent record.\\nProps to you!\\r","msg_0516_T08R0201_00019":"Would you like to put all caught\\nPokémon in PC Boxes? {YESNO 0}","msg_0516_T08R0201_00020":"Done!\\nYour Pokémon have been boxed away.\\rYou’ll now have to save the game.\\r","msg_0516_T08R0201_00021":"Oh, then it might be fun for you to\\ngo for an even better score by\\ftrying to catch these six again.\\rIf you want to do another Catching\\nShow, just come see us!","msg_0516_T08R0201_00022":"If you want to do another Catching\\nShow, come see us again, please!\\r","msg_0516_T08R0201_00023":"It’s time for your prize!\\nHere you are!\\r","msg_0516_T08R0201_00024":"Do another Catching Show\\nwith the same Pokémon? {YESNO 0}","msg_0516_T08R0201_00025":"The current record holder is\\n{STRVAR_1 3, 1, 0} with {STRVAR_1 53, 2, 0} points.\\fCan you top that?","msg_0516_T08R0201_00026":"Oh! You’ve topped 2,000 points!\\nYou’ve earned this, then!\\r","msg_0516_T08R0201_00027":"Keep working on getting a higher\\nscore!","msg_0516_T08R0201_00028":"Oh! You’ve topped 2,500 points!\\nYou’ve earned this, then!\\r","msg_0516_T08R0201_00029":"Oh! You’ve topped 3,000 points!\\nYou’ve earned this, then!\\r","msg_0516_T08R0201_00030":"Oh! You’ve earned 3,500 points!\\nYou’ve earned this, then!\\r","msg_0516_T08R0201_00031":"You’ve set an incredible record!\\nThere’s nothing left to say!","msg_0516_T08R0201_00032":"Your Bag is full.\\nYou should come back later.","msg_0516_T08R0201_00033":"I’ve heard Trainers complain that\\nrare Pokémon take longer to appear.\\rIs it easier to start with common\\nPokémon?","msg_0516_T08R0201_00034":"Oh, me?\\nNo, I never catch Pokémon myself.\\fBut I enjoy Catching Shows a lot.\\rI love to see Johto and Hoenn Pokémon,\\nespecially.\\rThe regions I’ve never been to\\nare so mysterious.","msg_0516_T08R0201_00035":"I feel so happy that I’d like to share\\nmy happiness with you today.\\rI must crown you with this...\\nCrown.\\rOh, before you get the wrong idea,\\nit’s an Accessory for Pokémon.\\r","msg_0516_T08R0201_00036":"I feel so happy that I’d like to share\\nmy happiness with you today.\\rI feel compelled to give you this\\nTiara.\\rOh, before you get the wrong idea,\\nit’s an Accessory for Pokémon.\\r","msg_0516_T08R0201_00037":"I feel so happy that I’d like to share\\nmy happiness with you today.\\rI wish you would take this\\n“Seafloor” Backdrop.\\rPlease try using it when dressing up\\nyour Pokémon with Accessories.\\r","msg_0516_T08R0201_00038":"I feel so happy that I’d like to share\\nmy happiness with you today.\\rI wish you would take this\\n“Underground” Backdrop.\\rPlease try using it when dressing up\\nyour Pokémon with Accessories.\\r","msg_0516_T08R0201_00039":"I feel so happy that I’d like to share\\nmy happiness with you today.\\rI wish you would take this\\n“Sky” Backdrop.\\rPlease try using it when dressing up\\nyour Pokémon with Accessories.\\r","msg_0516_T08R0201_00040":"Not only is there the Pokéathlon and\\nthe Safari Zone, but also the\\fBattle Frontier and the Pal Park...\\rPeople other than me are working\\nso hard... How dreamy...\\fThis region sets my heart aflutter.","msg_0516_T08R0201_00041":"I came to see {STRVAR_1 3, 0, 0}’s\\nCatching Show...\\rWow, {STRVAR_1 3, 0, 0}! Are you for real?","msg_0516_T08R0201_00042":"Hi, {STRVAR_1 3, 0, 0}!\\nYour Catching Show was awesome!\\fI’ll become a Trainer like you!","msg_0516_T08R0201_00043":"{STRVAR_1 3, 0, 0},\\nthere’s always a next time!","msg_0516_T08R0201_00044":"My son is a big fan of yours,\\n{STRVAR_1 3, 0, 0}.\\fAre you...that famous?","msg_0516_T08R0201_00045":"If you want to see rare Pokémon,\\nCatching Shows at the Pal Park are\\fthe best!"},"initTriggers":[{"var":"VAR_UNK_4124","value":1,"script":"_EV_scr_seq_T08R0201_001 + 1"},{"var":"VAR_UNK_4124","value":2,"script":"_EV_scr_seq_T08R0201_002 + 1"}],"initScripts":{"OnTransition":"_EV_scr_seq_T08R0201_000 + 1"},"constants":{"_EV_scr_seq_T08R0201_000":0,"_EV_scr_seq_T08R0201_001":1,"_EV_scr_seq_T08R0201_002":2,"_EV_scr_seq_T08R0201_003":3,"_EV_scr_seq_T08R0201_004":4,"_EV_scr_seq_T08R0201_005":5,"_EV_scr_seq_T08R0201_006":6,"_EV_scr_seq_T08R0201_007":7,"_EV_scr_seq_T08R0201_008":8,"_EV_scr_seq_T08R0201_009":9,"obj_T08R0201_gorggeousw":0,"obj_T08R0201_gsboy1":1,"obj_T08R0201_middlewoman1_2":2,"obj_T08R0201_gsboy2":3,"obj_T08R0201_gswoman2":4,"obj_T08R0201_gsman1":5,"obj_T08R0201_workman":6}}
