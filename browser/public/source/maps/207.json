IAL_RESULT"]],["TouchscreenMenuShow",[]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfEq",["_062D"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_063A"]],["End",[]],["NPCMsg",["msg_0600_T25R1201_00023"]],["GoTo",["_067F"]],["End",[]],["SetFavoriteMon",[]],["NPCMsg",["msg_0600_T25R1201_00020"]],["GoTo",["_067F"]],["End",[]],["BufferMonSpeciesName",["0","0"]],["NPCMsg",["msg_0600_T25R1201_00021"]],["GoTo",["_067F"]],["End",[]],["NPCMsg",["msg_0600_T25R1201_00018"]],["NPCMsg",["msg_0600_T25R1201_00019"]],["TouchscreenMenuHide",[]],["GetMenuChoice",["VAR_SPECIAL_RESULT"]],["TouchscreenMenuShow",[]],["Compare",["VAR_SPECIAL_RESULT","0"]],["GoToIfEq",["_062D"]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_0674"]],["End",[]],["NPCMsg",["msg_0600_T25R1201_00022"]],["GoTo",["_067F"]],["End",[]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["FacePlayer",[]],["NPCMsg",["msg_0600_T25R1201_00024"]],["TouchscreenMenuHide",[]],["GetMenuChoice",["VAR_SPECIAL_RESULT"]],["TouchscreenMenuShow",[]],["Compare",["VAR_SPECIAL_RESULT","1"]],["GoToIfEq",["_06D1"]],["FadeScreen",["6","1","0","RGB_BLACK"]],["WaitFade",[]],["CloseMsg",[]],["EditBattleGreeting",["VAR_SPECIAL_x8004"]],["Compare",["VAR_SPECIAL_x8004","0"]],["GoToIfEq",["_06D1"]],["NPCMsg",["msg_0600_T25R1201_00025"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["NPCMsg",["msg_0600_T25R1201_00026"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]],["PlaySE",["SEQ_SE_DP_SELECT"]],["LockAll",[]],["NPCMsg",["msg_0600_T25R1201_00036"]],["WaitButton",[]],["CloseMsg",[]],["ReleaseAll",[]],["End",[]]]},"messages":{"msg_0600_T25R1201_00000":"Welcome! This is the Global Trade\\nStation, or GTS for short.\\rWe enable the trading of Pokémon with\\npeople worldwide over Nintendo WFC.\\rWould you like to do a global\\nPokémon trade? {YESNO 0}","msg_0600_T25R1201_00001":"Hello!\\nWelcome to the GTS!\\rWould you like to do a global Pokémon\\ntrade over Nintendo Wi-Fi\\fConnection? {YESNO 0}","msg_0600_T25R1201_00002":"You may trade Pokémon one of two\\nways at the GTS.\\rYou may offer a Pokémon for trade,\\nor search among offered Pokémon.\\rShould I describe things in greater\\ndetail? {YESNO 0}","msg_0600_T25R1201_00003":"You will be asked to put up the\\nPokémon you are offering to trade.\\rAt that time, you will be asked what\\nPokémon you would like in return.\\rIf another player offers your desired\\nPokémon in return for your offered\\fPokémon, the trade will go through.\\rShould I explain anything else? {YESNO 0}","msg_0600_T25R1201_00004":"You may search among the Pokémon\\nthat are offered by other Trainers.\\rThey will all identify what Pokémon\\ntheir Trainers want back in return.\\rIf you find one that you want, you\\nmust provide us with the kind of\\fPokémon wanted in return.\\rShould I explain anything else? {YESNO 0}","msg_0600_T25R1201_00005":"Would you like to make a global\\nPokémon trade? {YESNO 0}","msg_0600_T25R1201_00006":"Please do visit again.","msg_0600_T25R1201_00007":"I hope you enjoy your visit\\nto the GTS!\\r","msg_0600_T25R1201_00008":"...Uh-oh!\\rI’m sorry, but your team and all\\nyour PC Boxes are full.\\rIf you wish to use the GTS, you must\\nhave room on your team or in a PC Box.","msg_0600_T25R1201_00009":"...Uh-oh!\\nYou only have one Pokémon with you.\\rIf you wish to use the GTS, you must\\nhave at least two Pokémon with you.\\rPlease come back with more Pokémon\\non your team.","msg_0600_T25R1201_00010":"Such a small world it is, eh?\\rEh? Wait, this is a miniature?\\nThe real Earth is millions of times bigger\\fthan this?\\rWhoaaaaaaa!","msg_0600_T25R1201_00011":"They say if you communicate with\\nsomeone, their location is\\frecorded on this giant globe.","msg_0600_T25R1201_00012":"All I need to do is leave a Pokémon\\nhere to trade.\\rWho knows, it might be traded while\\nI’m asleep tonight.","msg_0600_T25R1201_00013":"Using the equipment here, you can easily\\ntrade Pokémon with other Pokémon fans\\fon the other side of the world!\\rThat’s incredible!","msg_0600_T25R1201_00014":"You can register where you live on\\nthis giant globe.\\rOnce you do, you can show your location\\nto anyone you communicate with.","msg_0600_T25R1201_00015":"Nintendo WFC is so easy to use,\\neven I can trade Pokémon now!","msg_0600_T25R1201_00016":"This week, I’ll do it!\\rI really want to make the Top 4 of the\\nrankings.","msg_0600_T25R1201_00017":"The Global Terminal has three floors.\\rYou use warp panels for getting from\\none floor to another.\\rA blue panel takes you to the GTS on\\nthe ground floor.\\rTake a green panel to the studios for\\nBox Data and Dress-Up Data on 2F.\\rTake a pink warp panel to the third\\nfloor for the Battle Video Gallery.","msg_0600_T25R1201_00018":"Your favorite is {STRVAR_1 0, 0, 0},\\nisn’t it? {YESNO 0}","msg_0600_T25R1201_00019":"Your favorite is that Egg,\\nisn’t it? {YESNO 0}","msg_0600_T25R1201_00020":"Yes, I was right!\\nI thought so!","msg_0600_T25R1201_00021":"...Oh? Your favorite really is\\n{STRVAR_1 0, 0, 0}, isn’t it?","msg_0600_T25R1201_00022":"...Oh? Your favorite really is that Egg,\\nisn’t it?","msg_0600_T25R1201_00023":"I want to know everyone’s favorite\\nkinds of Pokémon.","msg_0600_T25R1201_00024":"Yo, yo, yo!\\rWanna let the world know about you?\\nThen you gotta tell me, yo! {YESNO 0}","msg_0600_T25R1201_00025":"Yo, I know all I need to know about\\nyou now.\\rIf you want to change your message,\\nI’m the guy to see, yo!","msg_0600_T25R1201_00026":"Yo! You don’t have anything you want\\nto say?\\rIf you want to change your message,\\nI’m the guy to see, yo!","msg_0600_T25R1201_00027":"There are several portal machines here\\nat the Global Terminal.\\rYou must set your Vs. Recorder in\\nthe machines for communication.\\rPlease do give the machines a try, as\\nthey guide you through the operation.","msg_0600_T25R1201_00028":"Welcome to the Global Terminal!\\rHere, you may join the huge community\\nof Trainers worldwide.\\rYou may view the records of Trainers\\nlike yourself from around the world.\\rYou may also trade Pokémon with the\\nworld’s Trainers.","msg_0600_T25R1201_00029":"Connect to Nintendo Wi-Fi\\nConnection for Trainer Rankings? {YESNO 0}","msg_0600_T25R1201_00030":"Trainer Rankings is a team-based\\nranking system for Trainers around\\fthe world.\\rThe Trainers will be divided into several\\ngroups and ranked in many categories.\\rIf you join, your Trainer achievements\\nare automatically sent to your team.\\rIn other words, what you do as a\\nTrainer can help your team’s standings.\\rBeware!\\rIf you enter a ranking category more\\nthan once, only the points earned from\\fyour previous report will be tallied.\\r","msg_0600_T25R1201_00031":"Connect to Nintendo Wi-Fi Connection\\nand examine the Battle Video\\fRankings? {YESNO 0}","msg_0600_T25R1201_00032":"Battle Video Rankings is a gallery of\\npopular Battle Videos.\\rStudy many classic battles and sharpen\\nyour own Trainer skills.\\r","msg_0600_T25R1201_00033":"USE","msg_0600_T25R1201_00034":"INFO","msg_0600_T25R1201_00035":"CANCEL","msg_0600_T25R1201_00036":"The green panel leads to the studios\\nfor Box Data and Dress-Up Data on 2F.\\rThe pink panel leads to the Battle\\nVideo Gallery on 3F."},"initTriggers":[{"var":"VAR_UNK_4133","value":6,"script":"_EV_scr_seq_T25R1201_002 + 1"}],"initScripts":{"OnResume":"_EV_scr_seq_T25R1201_001 + 1"},"constants":{"_EV_scr_seq_T25R1201_000":0,"_EV_scr_seq_T25R1201_001":1,"_EV_scr_seq_T25R1201_002":2,"_EV_scr_seq_T25R1201_003":3,"_EV_scr_seq_T25R1201_004":4,"_EV_scr_seq_T25R1201_005":5,"_EV_scr_seq_T25R1201_006":6,"_EV_scr_seq_T25R1201_007":7,"_EV_scr_seq_T25R1201_008":8,"_EV_scr_seq_T25R1201_009":9,"_EV_scr_seq_T25R1201_010":10,"_EV_scr_seq_T25R1201_011":11,"_EV_scr_seq_T25R1201_012":12,"_EV_scr_seq_T25R1201_013":13,"_EV_scr_seq_T25R1201_014":14,"_EV_scr_seq_T25R1201_015":15,"_EV_scr_seq_T25R1201_016":16,"_EV_scr_seq_T25R1201_0